TYPE "typeDiagnostics"
VERSION : 0.1
   STRUCT
      status { ExternalVisible := 'False'; ExternalWritable := 'False'} : Word;
      subfunctionStatus { ExternalVisible := 'False'; ExternalWritable := 'False'} : DWord;
      stateNumber { ExternalVisible := 'False'; ExternalWritable := 'False'} : DInt;
   END_STRUCT;

END_TYPE

