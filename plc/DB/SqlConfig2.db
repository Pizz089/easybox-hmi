DATA_BLOCK "SqlConfig2"
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : 'SIEMENS SUP Applications'
VERSION : 1.1
NON_RETAIN
   VAR 
      connectionSettings { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : "LSql_typeConnectionSettings";
      enableLSql { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      diagnostics { ExternalWritable := 'False'; S7_SetPoint := 'False'} : "LSql_typeDiagnostics";
      executeSqlCommand { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
   END_VAR


BEGIN
   connectionSettings.interfaceSettings.InterfaceId := 64;
   connectionSettings.interfaceSettings.ID := 16#0010;
   connectionSettings.interfaceSettings.ConnectionType := 16#0B;
   connectionSettings.interfaceSettings.ActiveEstablished := TRUE;
   connectionSettings.interfaceSettings.RemoteAddress.ADDR[1] := 16#AC;
   connectionSettings.interfaceSettings.RemoteAddress.ADDR[2] := 16#14;
   connectionSettings.interfaceSettings.RemoteAddress.ADDR[3] := 16#46;
   connectionSettings.interfaceSettings.RemoteAddress.ADDR[4] := 16#50;
   connectionSettings.interfaceSettings.RemotePort := 1433;
   connectionSettings.interfaceSettings.LocalPort := 0;
   connectionSettings.loginInformation.hostName := '';
   connectionSettings.loginInformation.userName := 'plc';
   connectionSettings.loginInformation.password := 'plc';
   connectionSettings.loginInformation.appName := '';
   connectionSettings.loginInformation.serverName := '172.20.70.80\SQLEXPRESS';
   connectionSettings.loginInformation.libraryName := '';
   connectionSettings.loginInformation.language := '';
   connectionSettings.loginInformation.databaseName := 'ADMG';
   connectionSettings.loginInformation.sspi := '';
   connectionSettings.loginInformation.attachDbfile := '';
   connectionSettings.loginInformation.changePassword := '';
   enableLSql := TRUE;
   diagnostics.status := 16#0000;
   diagnostics.subfunctionStatus := 16#0000;
   executeSqlCommand := FALSE;

END_DATA_BLOCK

