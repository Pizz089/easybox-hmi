FUNCTION_BLOCK "FB_Robot"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      cmdStatus { S7_SetPoint := 'False'} : "UDT_CMD";
   END_VAR
   VAR RETAIN
      Dispatcher : Array[0..31] of Int;
   END_VAR
   VAR 
      Auto : Bool;
      RemoteMode : Bool := TRUE;
      Status : Int;
      oldStatus { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int;
      workCondition : Int;   // Status REMOTE, LOCAL, MANUAL
   END_VAR
   VAR RETAIN
      communication_OK : Bool;   // Communication with robot's brain OK
   END_VAR
   VAR 
      MissionCode : Int;
      BoxRequested : Int := 1;   // Which warehouse used for mission
      GripperRequested : Int;
      MCRequested : Int;
      PalletRequested : Int;
      Tray_ID : Int;
      Error : Int;   // Every error raised during the cycle
      timeoutLifeBit {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
   END_VAR
   VAR RETAIN
      Gripper_ID : Array[1..2] of Int;   // Codes of gripper mounted
      GripperOccuped : Array[1..2] of Bool;   // Gripper occuped status
   END_VAR
   VAR 
      queryTemp : String;
      paramsTemp { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Array[0..5] of Int;
      queryStartExecution { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      PollingDB {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : Array[1..5] of TON_TIME;
      lastMission { S7_SetPoint := 'True'} : Int;
      WAIT_END_MISSION : Bool;
      HOLD : Bool;
      PalletPosition : Int;
      checkInconsistenceFailed : Bool;
      speedRequest : Int;
      tonCoerenza {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      auxOK_old { S7_SetPoint := 'True'} : Bool;
      swapDataReady : Bool;
      tonSwapA {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      tonSwapB {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      currentGripperHasHook { S7_SetPoint := 'True'} : Bool;
      PartSubPos : Int;
      declGripper : Int;
      declCont1 : Int;
      declId1 : Int;
      declCont2 : Int;
      declId2 : Int;
      declMap : Int;
      mounted_old : Int := -1;
      closed1_old : Int := -1;
      tonSafetyPub {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      zPlaceTemp { S7_SetPoint := 'True'} : DInt;
      PartSubPosMC : Int;
      TrayIdMC : Int;
      xPushTemp : DInt;
      xStopTemp : DInt;
      xPushOffsetMC : DInt;
      xPlaceTemp : DInt;
      declSubPos : Int;
      declStato : Int;
      declTipo : Int;
      retryPick : Bool;
      tonExtract {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      OrderIdMC { S7_SetPoint := 'True'} : Int;
      holdButton : Bool;
   END_VAR

   VAR_TEMP 
      pieceReq : Int;
      Dispatcher_old : Array[0..31] of Int;
      i : Int;
      RESET_ALL_DISPATCH : Bool;
      temp : Int;
      robotInPendant : Bool;
      cassettoFuori : Bool;
   END_VAR


BEGIN
	(* Implementato dentro alla classe del Robot
	REGION LIFE BIT
	    "DB_RobotMission".SystemSignals_IN.LIFEBIT_IN := NOT "DB_RobotMissionStatus".systemsignals.LIFE_BIT;
	    
	    #timeoutLifeBit(IN := "DB_RobotMission".SystemSignals_IN.LIFEBIT_IN <> "DB_RobotMissionStatus".systemsignals.LIFE_BIT,
	                    PT := T#3S);
	    
	    IF (#timeoutLifeBit.Q) THEN
	        //salva su DB errore di comunicazione con robot
	        #communication_OK := FALSE;
	    END_IF;
	END_REGION
	*)
	// Il flag va abbassato SOLO quando la query e' entrata davvero nel ponte.
	// Senza il controllo di lunghezza, due stringhe vuote si confermano a vicenda
	// e il flag cade su una query mai partita: la catena resta appesa per sempre
	// (visto 4/9 sulla missione 16, errore 13599 in loop).
	IF LEN(#queryTemp) > 0
	    AND #queryTemp = "SqlCommands".sqlCommands[0]
	    AND #queryStartExecution
	THEN
	    #queryStartExecution := FALSE;
	END_IF;
	
	REGION Status
	    
	    #Status := DINT_TO_INT("AUTO");
	    IF NOT #HOLD AND ("DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	        "DB_RobotMissionStatus".StatusCode = "cmd_executing") THEN
	        #Status := DINT_TO_INT("WORKING");
	    ELSIF NOT #HOLD AND ("DB_RobotMissionStatus".StatusCode = "cmd_aborted" OR
	        "DB_RobotMissionStatus".StatusCode = "cmd_rejected") THEN
	        #Status := DINT_TO_INT("ABORTED");
	    ELSIF NOT #HOLD AND (#Dispatcher["_master"] = 9999 OR
	        #Error <> 0 OR
	        "DB_RobotMissionStatus".StatusRegister.Alarm) THEN
	        #Status := DINT_TO_INT("ALARM");
	    ELSIF NOT #communication_OK THEN
	        #Status := DINT_TO_INT("NOT_DEFINED");
	    ELSIF NOT #HOLD AND NOT "DB_RobotMissionStatus".StatusRegister.Executing AND #Auto THEN
	        #Status := DINT_TO_INT("OFF");
	    ELSIF #HOLD THEN
	        #Status := DINT_TO_INT("HOLD");
	    ELSIF NOT #Auto THEN
	        #Status := DINT_TO_INT("MANUAL");
	    ELSE
	        #Status := DINT_TO_INT("REMOTE");
	    END_IF;
	    
	    IF (#Status <> #oldStatus AND #Status >= 0) THEN
	        IF "DB_RobotMissionStatus".StatusRegister.Alarm THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"("Alarmcode")));
	        ELSE
	            "FC_MQTT"(insert := true,
	                      "send" := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Error)));
	        END_IF;
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/STATUS/ROBOT',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Status)));
	        #oldStatus := #Status;
	    END_IF;
	    
	    //controllo ad ogni ciclo
	    #Status := DINT_TO_INT("REMOTE");
	    
	    IF (#Status <> #workCondition AND #Status >= 0) THEN
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/STATUS/ROBOT',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Status)));
	        #workCondition := #Status;
	    END_IF;
	END_REGION ;
	
	FOR #i := 0 TO 31 DO
	    #Dispatcher_old[#i] := #Dispatcher[#i];
	END_FOR;
	
	REGION Manager CMD from HMI
	    // Modo cella: DB_Robot.RemoteMode (TRUE = automatico, FALSE = manuale/locale).
	    // Scritto SOLO qui dai comandi 81/82 — il robot non partecipa al giro modalita'.
	    // Robot sotto pendant (manuale suo): nessun comando di movimento accettato.
	    #robotInPendant := "sys_manual_T1" OR "sys_manual_Full";
	    #RemoteMode := NOT #HOLD;   // modo cella derivato: HOLD = manuale
	    
	    // ---- Comandi accettati in ogni condizione ----
	    IF "DB_MQTT".lastTopicReceived = 'ROBOT' THEN
	        CASE "DB_MQTT".lastCmdReceived OF
	            "CMD_HOLD":
	                // IL PULSANTE E' MASTER (19/9): un hold messo col pulsante fisico
	                // lo toglie solo il pulsante. Dal pannello si puo' mettere
	                // l'hold e togliere il proprio, non quello di chi sta in campo
	                // davanti alla cella. La gerarchia la tiene FB5, che scrive
	                // holdButton: qui si legge e basta.
	                IF NOT #holdButton THEN
	                    #HOLD := NOT #HOLD;
	                END_IF;
	            "CMD_changeRobotSpeed":
	                #speedRequest := "DB_MQTT".lastParams[0];
	            "CMD_Refresh":  // 90: ripubblica tutti gli one-shot
	                #oldStatus := -1;
	                #lastMission := -1;
	                #auxOK_old := NOT "Main_Safety_RTG1_DB".Aux_OK;
	                #mounted_old := -1;
	                #closed1_old := -1;
	                "DB_MC1".brandID_req_old := -1;
	                "DB_MC1".brandID_act_old := -1;
	                "DB_MC1".declPallet_old := -1;
	                "DB_MC1".declPiece_old := -1;
	                "DB_MC1".declVice_old := -1;
	                FOR #i := 0 TO 31 DO
	                    #Dispatcher_old[#i] := -1;
	                END_FOR;
	                "DB_MQTT".lastCmdReceived := 0;
	        END_CASE;
	    END_IF;
	    
	    // ---- Restart main program: solo con orchestrazione in HOLD ----
	    IF "DB_MQTT".lastTopicReceived = 'ROBOT' AND #HOLD THEN
	        CASE "DB_MQTT".lastCmdReceived OF
	            "CMD_RestartMainProg":
	                "DB_RobotMission".Command := "CMD_RestartMainProg";
	                "DB_MQTT".lastCmdReceived := 0;
	                #WAIT_END_MISSION := FALSE;
	                // il restart del programma robot abbandona la missione in corso (5/10):
	                // si azzerano le catene come per i movimenti manuali, altrimenti
	                // restano ad aspettare un "eseguito" che non arrivera' mai.
	                #RESET_ALL_DISPATCH := TRUE;
	                #MissionCode := 0;
	        END_CASE;
	    END_IF;
	    
	    // ---- Canale libero: modo cella + reset, validi in ENTRAMBI i modi ----
	    IF "DB_MQTT".lastTopicReceived = 'ROBOT'
	        AND "DB_RobotMissionStatus".StatusCode <> "cmd_acquired"
	        AND "DB_RobotMissionStatus".StatusCode <> "cmd_executing"
	    THEN
	        CASE "DB_MQTT".lastCmdReceived OF
	            "CMD_RobotReset":
	                #Error := 0;
	                "DB_RobotMission".Command := "CMD_RobotReset"; //arriva direttamente nella missione robot
	                #MissionCode := 0;
	                #RESET_ALL_DISPATCH := TRUE;
	                #WAIT_END_MISSION := TRUE;
	                
	                // IL RESET DEVE FERMARE ANCHE L'ORCHESTRAZIONE MACCHINA (16/9).
	                // Prima azzerava solo le catene di FB7: FB204 restava dov'era e
	                // riprendeva da uno stato che non esisteva piu'. Visto in campo:
	                // reset a meta' deposito del finito -> il 95 substate 1 vede
	                // MissionCode = 0 (appena azzerato QUI) e conclude che lo scarico
	                // e' finito, prosegue sui registri di bordo troncati, e arriva a
	                // rilanciare la RICETTA su un pezzo GIA' LAVORATO ancora in morsa.
	                // (35) CON LA HAAS IN LAVORAZIONE (FB204 al 95 e porta della HAAS chiusa)
	                // IL RESET NON ABBANDONA IL CICLO MACCHINA: substate 6, si aspetta il
	                // fine ciclo, come fanno gia' home, posizionamenti e restart
	                // (resetDispatcher). Portato a 0 dal 95, FB204 rileggeva l'ordine col
	                // pezzo ancora in lavorazione (simulazione 7/10 bis, B35; problema 7
	                // della prima). Il caso del 16/9 qui sopra resta coperto: al substate 6
	                // FB204 non rilancia la ricetta, aspetta il fine ciclo.
	                // Con la porta della HAAS APERTA la macchina non sta lavorando: il RESET
	                // porta FB204 a 0 come prima. E' anche l'uscita se la HAAS si ferma a
	                // ciclo interrotto senza dare il fine ciclo: si apre la porta e si
	                // ripete il RESET (senza questa uscita FB204 restava al 95 per sempre).
	                IF "DB_MC1".Dispatcher["_master"] = 95 AND "DB_MC1".io_in.doorClosed THEN
	                    "DB_MC1".subState := 6;
	                ELSE
	                    "DB_MC1".Dispatcher["_master"] := 0;
	                END_IF;
	                "DB_MC2".Dispatcher["_master"] := 0;
	                
	                "DB_MQTT".lastCmdReceived := 0;
	        END_CASE;
	        
	        // ---- Dichiarazioni (5/10): cella in locale, ANCHE con robot sotto pendant ----
	        // Non muovono il robot. 39 e 44 toccano solo il database. Il 35 aggiorna
	        // registri e database e, a robot in automatico, manda al robot le misure
	        // della pinza (get_TCP_Data, comando 10): sotto pendant quel comando non
	        // si puo' dare, quindi il 35 e' ammesso solo se la pinza resta quella gia'
	        // registrata (il robot ne ha gia' le misure; il TCP si salta al 45 di
	        // Declare_State). Un cambio pinza si dichiara col robot in automatico:
	        // sotto pendant si rifiuta con l'allarme 969, invece del silenzio di prima.
	        IF NOT #RemoteMode THEN
	            CASE "DB_MQTT".lastCmdReceived OF
	                "CMD_DeclarePosition_TRAY":   // 39;subpos;stato  (2 vuota, 4 grezzo, 5 finito)
	                    #declSubPos := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                    #declStato := DINT_TO_INT("DB_MQTT".lastParams[1]);
	                    #declTipo := 0;                         // ramo STATO, non TIPO
	                    IF "DB_BOX_1".ExtractedTray <= 0 THEN
	                        #Error := 20001;                    // nessun cassetto estratto
	                    ELSIF #declSubPos <= 0 THEN
	                        #Error := 20002;                    // posizione non valida
	                    ELSIF #declStato <> 2 AND #declStato <> 4 AND #declStato <> 5 THEN
	                        #Error := 20005;                    // stato non ammesso
	                    ELSE
	                        #Dispatcher["_Declare_Position"] := 10;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := FALSE;   // nessun movimento robot
	                    
	                "CMD_DeclarePieceType_TRAY":   // 44;partType  tipo pezzo dell'INTERO cassetto estratto
	                    #declTipo := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                    IF "DB_BOX_1".ExtractedTray <= 0 THEN
	                        #Error := 20001;                    // nessun cassetto estratto
	                    ELSIF #declTipo <= 0 THEN
	                        #Error := 20008;                    // tipo pezzo non valido
	                    ELSE
	                        #Dispatcher["_Declare_Position"] := 15;   // ramo TIPO
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := FALSE;   // nessun movimento robot
	                    
	                "CMD_RobotDeclareState":   // 35;gripperID;cont1;id1;cont2;id2  (cont: 0=vuoto 1=grezzo 2=finito 3=pallet)
	                    IF #robotInPendant AND DINT_TO_INT("DB_MQTT".lastParams[0]) <> #Gripper_ID[1] THEN
	                        // sotto pendant non si puo' mandare al robot il TCP di una pinza diversa
	                        "FC_MQTT"(insert := true,
	                       send := false,
	                       topic := 'FROM_PLANT/ALARM/ROBOT',
	                       payload := STRING_TO_WSTRING('969'));   // cambio pinza: dichiarare a robot in automatico
	                        "DB_MQTT".lastCmdReceived := 0;
	                    ELSE
	                        #declGripper := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                        #declCont1 := DINT_TO_INT("DB_MQTT".lastParams[1]);
	                        #declId1 := DINT_TO_INT("DB_MQTT".lastParams[2]);
	                        #declCont2 := DINT_TO_INT("DB_MQTT".lastParams[3]);
	                        #declId2 := DINT_TO_INT("DB_MQTT".lastParams[4]);
	                        #Error := 0;
	                        #MissionCode := 0;
	                        #Dispatcher["_Declare_State"] := 10;
	                        "DB_MQTT".lastCmdReceived := 0;
	                        #WAIT_END_MISSION := FALSE;   // nessun movimento robot
	                    END_IF;
	            END_CASE;
	        END_IF;
	        
	        // ---- Comandi di missione con un ERRORE ATTIVO: rifiutati (7/10) ----
	        // Fino al 7/10 venivano accettati: MissionCode restava scritto e il master
	        // lo teneva in attesa di Error = 0. Il fronte del pulsante HOLD (FB8,
	        // REGION reset alarm) azzera Error, e la missione chiesta minuti prima
	        // partiva da sola, anche un'apertura chele (simulazione 7/10, problema 9).
	        // Adesso il comando si consuma senza scrivere niente e il pannello riceve
	        // 972 su ALARM/ROBOT: prima RESET (con il 938, la dichiarazione dello stato
	        // cella), poi si ripete il comando.
	        // Restano ammessi con l'errore attivo: home, manutenzione e posizionamenti
	        // (partono subito e azzerano le catene), le dichiarazioni e il reset.
	        // Sotto pendant resta il 968, piu' sotto. Il rifiuto sta qui, sui comandi
	        // del pannello, e non nel master: in HOLD MissionCode puo' essere anche una
	        // missione di FB204 in attesa, e azzerarla gliela farebbe leggere come
	        // riuscita.
	        // (35) DOPO IL 972 SI PUBBLICA IL CODICE ATTIVO. In HOLD Error non esce da
	        // nessuna parte (DESCR solo al cambio di stato): il pannello riceveva il 972
	        // senza sapere quale errore togliere, e dopo il RESET l'errore tornava muto
	        // (simulazione 7/10 bis, B7). Due messaggi sullo stesso topic: il pannello
	        // di oggi ha un solo riquadro di avviso e mostra l'ultimo, cioe' il codice
	        // col suo testo; il pannello aggiornato li mette insieme.
	        IF NOT #RemoteMode AND NOT #robotInPendant AND #Error <> 0 THEN
	            CASE "DB_MQTT".lastCmdReceived OF
	                "CMD_RobotPickGripper", "CMD_RobotRemoveGripper", "CMD_RobotExtractTray",
	                "CMD_RobotReleaseTray", "CMD_RobotPickObject", "CMD_RobotPlaceObject",
	                "CMD_HMI_SwapGripper", "CMD_RobotPickPartTray", "CMD_RobotPlacePartTray",
	                "CMD_RobotPickPartMC", "CMD_RobotPlacePartMC", "CMD_RobotPickPlacePartMC",
	                "CMD_OpenGripper1", "CMD_CloseGripper1", "CMD_OpenGripper2", "CMD_CloseGripper2":
	                    "FC_MQTT"(insert := true,
	                   send := false,
	                   topic := 'FROM_PLANT/ALARM/ROBOT',
	                   payload := STRING_TO_WSTRING('972'));   // comando rifiutato: errore attivo, prima RESET
	                    "FC_MQTT"(insert := true,
	                   send := false,
	                   topic := 'FROM_PLANT/ALARM/ROBOT',
	                   payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Error)));   // l'errore attivo
	                    "DB_MQTT".lastCmdReceived := 0;
	            END_CASE;
	        END_IF;
	        
	        // ---- Comandi di missione con una MISSIONE IN CORSO O SOSPESA: rifiutati (35) ----
	        // Il manager accettava le missioni senza guardare il master e MissionCode.
	        // In HOLD le missioni di FB204 possono restare scritte in MissionCode (molte
	        // il master 0 le avvia solo con RemoteMode; altre, come la 16, cassetti e
	        // pinze, aspettano Error = 0): un comando del pannello le sovrascriveva,
	        // e a fine missione FB204 leggeva MissionCode = 0 come la PROPRIA missione
	        // riuscita (simulazione 7/10 bis, B5). Durante una missione del pannello un
	        // secondo comando cambiava GripperRequested, PartSubPos, Tray_ID a meta'.
	        // Adesso: missione in corso (master <> 0) o in attesa (MissionCode <> 0) =
	        // comando consumato e 973 su ALARM/ROBOT. Si esce con CONTINUA (la missione
	        // sospesa riprende) oppure con la procedura (RESTART, HOME, Reimposta) o col
	        // RESET. Home, manutenzione, posizionamenti, dichiarazioni e reset restano
	        // ammessi: non sono in questo elenco.
	        IF NOT #RemoteMode AND NOT #robotInPendant
	            AND (#Dispatcher["_master"] <> 0 OR #MissionCode <> 0)
	        THEN
	            CASE "DB_MQTT".lastCmdReceived OF
	                "CMD_RobotPickGripper", "CMD_RobotRemoveGripper", "CMD_RobotExtractTray",
	                "CMD_RobotReleaseTray", "CMD_RobotPickObject", "CMD_RobotPlaceObject",
	                "CMD_HMI_SwapGripper", "CMD_RobotPickPartTray", "CMD_RobotPlacePartTray",
	                "CMD_RobotPickPartMC", "CMD_RobotPlacePartMC", "CMD_RobotPickPlacePartMC",
	                "CMD_OpenGripper1", "CMD_CloseGripper1", "CMD_OpenGripper2", "CMD_CloseGripper2":
	                    "FC_MQTT"(insert := true,
	                   send := false,
	                   topic := 'FROM_PLANT/ALARM/ROBOT',
	                   payload := STRING_TO_WSTRING('973'));   // missione in corso o sospesa: CONTINUA, oppure RESET
	                    "DB_MQTT".lastCmdReceived := 0;
	            END_CASE;
	        END_IF;
	        
	        // ---- Comandi di movimento: SOLO cella in locale E robot non in pendant ----
	        IF NOT #RemoteMode AND NOT #robotInPendant THEN
	            CASE "DB_MQTT".lastCmdReceived OF
	                "CMD_RobotToHomePos":
	                    "DB_RobotMission".Command := "CMD_RobotToHomePos";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                    #RESET_ALL_DISPATCH := TRUE; // abort missioni pendenti: no falso latch da 3 del movimento manuale
	                    #MissionCode := 0;
	                "CMD_RobotMaintenancePos":
	                    "DB_RobotMission".Command := "CMD_RobotMaintenancePos";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                    #RESET_ALL_DISPATCH := TRUE; // abort missioni pendenti: no falso latch da 3 del movimento manuale
	                    #MissionCode := 0;
	                "CMD_RobotPositioning":
	                    "DB_RobotMission".Command := "CMD_RobotPositioning"; // riceve comandi del tipo 15;1
	                    "DB_RobotMission".Unit_code := "DB_MQTT".lastParams[0];
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                    #RESET_ALL_DISPATCH := TRUE; // abort missioni pendenti: no falso latch da 3 del movimento manuale
	                    #MissionCode := 0;
	                "CMD_RobotPositioning_BOX1":
	                    "DB_RobotMission".Command := "CMD_RobotPositioning";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                    #RESET_ALL_DISPATCH := TRUE; // abort missioni pendenti: no falso latch da 3 del movimento manuale
	                    #MissionCode := 0;
	                "CMD_RobotPositioning_MC1":
	                    "DB_RobotMission".Command := "CMD_RobotPositioning";
	                    "DB_RobotMission".Unit_code := "MC1";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                    #RESET_ALL_DISPATCH := TRUE; // abort missioni pendenti: no falso latch da 3 del movimento manuale
	                    #MissionCode := 0;
	                "CMD_RobotPickGripper":
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #MissionCode := "MISSION_LoadGripper";
	                    #GripperRequested := "DB_MQTT".lastParams[0];
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_RobotRemoveGripper":
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #MissionCode := "MISSION_UnloadGripper";
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_RobotExtractTray":
	                    #Tray_ID := DINT_TO_INT("DB_MQTT".lastParams[0]);  // <-- riga nuova
	                    #MissionCode := "MISSION_ExtractTray";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_RobotReleaseTray":
	                    #MissionCode := "MISSION_ReleaseTray";
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_RobotPickObject":
	                    "DB_RobotMission".Object_Type := "DB_MQTT".lastParams[0];
	                    #PalletRequested := "DB_MQTT".lastParams[1];
	                    CASE "DB_RobotMission".Object_Type OF
	                        "Pallet":
	                            #PalletPosition := "DB_MQTT".lastParams[2];
	                            IF #PalletPosition = 0 THEN
	                                #MissionCode := "MISSION_PickPallet_MC_HMI";
	                                #MCRequested := 1;
	                            ELSE
	                                #MissionCode := "MISSION_Load_Pallet";
	                                #MCRequested := 0;
	                            END_IF;
	                            "DB_MQTT".lastCmdReceived := 0;
	                            #WAIT_END_MISSION := TRUE;
	                        "Part": //TODO
	                            ;
	                        "ViceWithoutPart":
	                            ;
	                        "ViceWithPart":
	                            ;
	                    END_CASE;
	                "CMD_RobotPlaceObject":
	                    "DB_RobotMission".Object_Type := "DB_MQTT".lastParams[0];
	                    #PalletRequested := "DB_MQTT".lastParams[1];
	                    CASE "DB_RobotMission".Object_Type OF
	                        "Pallet":
	                            #PalletPosition := "DB_MQTT".lastParams[2];
	                            IF #PalletPosition = 0 THEN
	                                #MissionCode := "MISSION_PlacePallet_MC_HMI";
	                                #MCRequested := 1;
	                            ELSE
	                                #MissionCode := "MISSION_Unload_Pallet";
	                                #MCRequested := 0;
	                            END_IF;
	                            "DB_MQTT".lastCmdReceived := 0;
	                            #WAIT_END_MISSION := TRUE;
	                        "Part": //TODO
	                            ;
	                        "ViceWithoutPart":
	                            ;
	                        "ViceWithPart":
	                            ;
	                    END_CASE;
	                "CMD_HMI_SwapGripper":
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #GripperRequested := "DB_MQTT".lastParams[0];
	                    #MissionCode := "MISSION_SwapGripper";
	                    #WAIT_END_MISSION := TRUE;
	                    
	                "CMD_RobotPickPartTray":   // 27;subpos;gripperID  (gripperID 0 = pinza a bordo)
	                    IF "DB_BOX_1".ExtractedTray <= 0 THEN
	                        #Error := 20001;                    // nessun cassetto estratto
	                    ELSIF DINT_TO_INT("DB_MQTT".lastParams[0]) <= 0 THEN
	                        #Error := 20002;                    // posizione pezzo non valida
	                    ELSIF DINT_TO_INT("DB_MQTT".lastParams[1]) = 0 AND #Gripper_ID[1] = 0 THEN
	                        #Error := 22;                       // flangia vuota e nessuna pinza richiesta
	                    ELSE
	                        #PartSubPos := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                        #GripperRequested := DINT_TO_INT("DB_MQTT".lastParams[1]);
	                        IF #GripperRequested = 0 THEN
	                            #GripperRequested := #Gripper_ID[1];
	                        END_IF;
	                        #Tray_ID := "DB_BOX_1".ExtractedTray;
	                        #MCRequested := 0;
	                        #MissionCode := "MISSION_PickPart_TRAY_HMI";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                    
	                "CMD_RobotPlacePartTray":  // 28;subpos  (0 = prima posizione vuota)
	                    IF "DB_BOX_1".ExtractedTray <= 0 THEN
	                        #Error := 20001;
	                    ELSE
	                        #PartSubPos := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                        #Tray_ID := "DB_BOX_1".ExtractedTray;
	                        #MCRequested := 0;
	                        #MissionCode := "MISSION_PlacePart_TRAY_HMI";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                    
	                "CMD_RobotPickPartMC":     // 29;gripperID  (0 = pinza a bordo)
	                    IF DINT_TO_INT("DB_MQTT".lastParams[0]) = 0 AND #Gripper_ID[1] = 0 THEN
	                        #Error := 22;
	                    ELSE
	                        #GripperRequested := DINT_TO_INT("DB_MQTT".lastParams[0]);
	                        IF #GripperRequested = 0 THEN
	                            #GripperRequested := #Gripper_ID[1];
	                        END_IF;
	                        #MCRequested := 1;                  // MC2 non esiste in questa cella
	                        #MissionCode := "MISSION_PickPart_MC_HMI";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                    
	                "CMD_RobotPlacePartMC":    // 30  (pezzo a bordo -> morsa MC1)
	                    #MCRequested := 1;
	                    #GripperRequested := #Gripper_ID[1];
	                    #MissionCode := "MISSION_PlacePart_MC_HMI";
	                    #WAIT_END_MISSION := TRUE;
	                    "DB_MQTT".lastCmdReceived := 0;
	                "CMD_RobotPickPlacePartMC":  // 244  (finito da morsa + grezzo in morsa, un ingresso)
	                    IF NOT #GripperOccuped[1] THEN
	                        #Error := 20003;                    // nessun grezzo a bordo lato 1
	                    ELSIF #GripperOccuped[2] THEN
	                        #Error := 20004;                    // lato finito gia' occupato
	                    ELSE
	                        #MCRequested := 1;
	                        #GripperRequested := #Gripper_ID[1];
	                        #MissionCode := "MISSION_PickPlacePart_MC";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                "CMD_OpenGripper1":
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #MissionCode := "MISSION_OpenGripper1";
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_CloseGripper1":
	                    "DB_MQTT".lastCmdReceived := 0;
	                    #MissionCode := "MISSION_CloseGripper1";
	                    #WAIT_END_MISSION := TRUE;
	                "CMD_OpenGripper2":
	                    IF #Gripper_ID[2] = 0 THEN
	                        #Error := 944;   // lato 2 inesistente sulla pinza a bordo
	                    ELSE
	                        #MissionCode := "MISSION_OpenGripper2";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	                "CMD_CloseGripper2":
	                    IF #Gripper_ID[2] = 0 THEN
	                        #Error := 944;
	                    ELSE
	                        #MissionCode := "MISSION_CloseGripper2";
	                        #WAIT_END_MISSION := TRUE;
	                    END_IF;
	                    "DB_MQTT".lastCmdReceived := 0;
	            END_CASE;
	        ELSIF NOT #RemoteMode AND #robotInPendant THEN
	            // SOTTO PENDANT (5/10): i comandi di movimento restano rifiutati, ma il
	            // pannello lo deve sapere: prima sparivano e il pannello vedeva solo
	            // "nessuna conferma". Allarme 968, comando consumato.
	            CASE "DB_MQTT".lastCmdReceived OF
	                "CMD_RobotToHomePos", "CMD_RobotMaintenancePos", "CMD_RobotPositioning",
	                "CMD_RobotPositioning_BOX1", "CMD_RobotPositioning_MC1", "CMD_RobotPickGripper",
	                "CMD_RobotRemoveGripper", "CMD_RobotExtractTray", "CMD_RobotReleaseTray",
	                "CMD_RobotPickObject", "CMD_RobotPlaceObject", "CMD_HMI_SwapGripper",
	                "CMD_RobotPickPartTray", "CMD_RobotPlacePartTray", "CMD_RobotPickPartMC",
	                "CMD_RobotPlacePartMC", "CMD_RobotPickPlacePartMC", "CMD_OpenGripper1",
	                "CMD_CloseGripper1", "CMD_OpenGripper2", "CMD_CloseGripper2":
	                    "FC_MQTT"(insert := true,
	                   send := false,
	                   topic := 'FROM_PLANT/ALARM/ROBOT',
	                   payload := STRING_TO_WSTRING('968'));   // robot in manuale dal pendant
	                    "DB_MQTT".lastCmdReceived := 0;
	            END_CASE;
	        END_IF;
	    END_IF;
	    
	    // ---- Completamento comando (invariato) ----
	    IF #WAIT_END_MISSION THEN
	        IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	            #WAIT_END_MISSION := FALSE;
	            //sync with robot
	            "DB_RobotMission".Command := 0;
	        ELSIF "DB_RobotMissionStatus".StatusCode = "cmd_rejected" OR "DB_RobotMissionStatus".StatusCode = "cmd_aborted" THEN
	            #WAIT_END_MISSION := FALSE;
	            // COMANDO MANUALE RIFIUTATO O ABORTITO (5/10): senza missione in
	            // corso si azzera anche il comando. Altrimenti il 4/5 resta esposto
	            // e la sorveglianza qui sotto lo attribuirebbe alla missione dopo.
	            IF #Dispatcher["_master"] = 0 THEN
	                "DB_RobotMission".Command := 0;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ---- Sorveglianza risposta robot (5/10) ----
	    // Le risposte 4 (abortito) e 5 (rifiutato) erano gestite solo qui sopra,
	    // per i comandi manuali, e nelle catene chele. Le catene pezzi e cassetto
	    // restavano ad aspettare un 3 che non arriva: cella ferma con Error = 0 e
	    // nessuna spiegazione. Con una missione in corso e un comando al robot,
	    // una risposta anomala che dura 1 s diventa un errore dichiarato, che il
	    // reset (99) toglie. Il secondo di filtro evita di leggere lo StatusCode
	    // rimasto dal comando precedente nei primi cicli dopo un comando nuovo.
	    // Esclusi: lo scan del reset (99, AUX, ResetAreaRobot), in cui il master
	    // e' ancora valorizzato; l'HOLD, in cui il programma robot e' in pausa; la
	    // ripartenza del programma dopo HOLD o restart (FB8 dispatcher 0 e 1), che
	    // puo' durare fino a 17 s.
	    // Il codice 6 ("interrotto") NON e' gestito: non e' fra le costanti cmd_
	    // e va prima confermato col robotista.
	    // PollingDB[1] e' un timer gia' dichiarato e mai usato: nessuna variabile
	    // nuova, interfaccia invariata.
	    #PollingDB[1](IN := #Dispatcher["_master"] <> 0
	   AND #Error = 0
	   AND "DB_RobotMission".Command <> 0
	   AND NOT #HOLD
	   AND NOT #RESET_ALL_DISPATCH
	   AND NOT "Start_AUX"
	   AND NOT "ResetAreaRobot"
	   AND "DB_Robot_Efort".dispatcher[0] = 0
	   AND "DB_Robot_Efort".dispatcher[1] = 0
	   AND ("DB_RobotMissionStatus".StatusCode = "cmd_aborted"
	   OR "DB_RobotMissionStatus".StatusCode = "cmd_rejected"),
	   PT := T#1s);
	    IF #PollingDB[1].Q THEN
	        IF "DB_RobotMissionStatus".StatusCode = "cmd_aborted" THEN
	            #Error := 961;   // missione abortita dal robot
	        ELSE
	            #Error := 962;   // comando rifiutato dal robot
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION Cycle MASTER ROBOT
	    
	    //DA TESTARE
	    (*IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	            "DB_RobotMission".Command := 0;
	        END_IF;
	        *)
	    
	    IF NOT "Main_Safety_RTG1_DB".Aux_OK THEN
	        #MissionCode := 0;
	    END_IF;
	    
	    // (35) I TIMEOUT NON CONTANO IN HOLD: l'HOLD e' una pausa e CONTINUA deve
	    // riprendere senza errori (decisione del 7/10). Prima una pausa oltre 60 s a
	    // meta' swap dava 943, oltre 180 s a meta' cassetto 19003, e FB204 andava in
	    // 9999 (simulazione 7/10 bis, B18). In HOLD il timer si azzera e riparte da
	    // capo alla ripresa: il tempo pieno vale di nuovo.
	    // "DB_plant".Hold e' l'HOLD del pulsante e della porta, #HOLD quello del pannello.
	    #tonSwapA(IN := #Dispatcher["_master"] >= 973 AND #Dispatcher["_master"] <= 974
	              AND NOT (#HOLD OR "DB_plant".Hold),
	              PT := T#60s);
	    // TIMEOUT ESTESO AL 9781 (17/9): il 978 ora chiude in un ciclo e passa la
	    // registrazione alla catena unica. Senza estendere la sorveglianza, un ponte
	    // SQL occupato lascerebbe il master appeso al 9781 in silenzio, con la pinza
	    // gia' a bordo.
	    #tonSwapB(IN := (#Dispatcher["_master"] = 978 OR #Dispatcher["_master"] = 9781)
	              AND NOT (#HOLD OR "DB_plant".Hold),
	              PT := T#60s);
	    IF (#tonSwapA.Q OR #tonSwapB.Q) AND #Error = 0 THEN
	        #Error := 943;  // swap: timeout di fase (deposito o prelievo)
	    END_IF;
	    
	    // SORVEGLIANZA CATENA CASSETTO (18/9): e' la terza catena che si pianta in
	    // silenzio. Il 12 aveva un ramo mancante — corretto — ma il principio resta:
	    // una catena senza timeout, quando si ferma, ferma anche il 750 che la
	    // aspetta e il 58 di FB204 che aspetta il 750, e nessuno lo dice.
	    // Tre minuti coprono estrazione e rilascio con margine largo.
	    #tonExtract(IN := (#Dispatcher["Extract_TRAY"] > 0 OR #Dispatcher["Release_TRAY"] > 0)
	                AND NOT (#HOLD OR "DB_plant".Hold),
	                PT := T#180s);
	    IF #tonExtract.Q AND #Error = 0 THEN
	        #Error := 19003;   // catena cassetto: timeout
	    END_IF;
	    
	    // (35) CASSETTO FUORI, CALCOLATO UNA VOLTA: registro, sensori di cassetto
	    // fuori (gli stessi di FB_easyBox) e catene di estrazione e rilascio. E' la
	    // stessa condizione dello stato 10 delle catene pinza (consegna 34), usata
	    // dai master che cambiano pinza PRIMA di lanciare le catene: lo swap (che
	    // non passa dalle catene), carico e scarico pinza, e i cambi pinza dei
	    // master 1010, 1100, 1200 e 1310. Un cassetto a meta' corsa non lo vede
	    // nessuno: AllTrayInside non e' cablato (limite noto, problema 19).
	    #cassettoFuori := "DB_BOX_1".ExtractedTray > 0
	    OR #Dispatcher["Extract_TRAY"] > 0 OR #Dispatcher["Release_TRAY"] > 0
	    OR "I_OUT_TRAY1" OR "I_OUT_TRAY2" OR "I_OUT_TRAY3" OR "I_OUT_TRAY4"
	    OR "I_OUT_TRAY5" OR "I_OUT_TRAY6" OR "I_OUT_TRAY7" OR "I_OUT_TRAY8"
	    OR "I_OUT_TRAY9" OR "I_OUT_TRAY10" OR "I_OUT_TRAY11" OR "I_OUT_TRAY12";
	    
	    IF #communication_OK THEN
	        CASE #Dispatcher["_master"] OF
	            0:
	                CASE #MissionCode OF
	                    "MISSION_LoadPallet_MC":        // pallet: Robot -> MC
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            IF #MCRequested = 1 THEN
	                                IF "DB_MC1".order.GRIPPER4PALLET > 0 THEN
	                                    #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER4PALLET);
	                                    #Dispatcher["_master"] := 100;
	                                END_IF;
	                            ELSIF #MCRequested = 2 THEN
	                                IF "DB_MC1".order.GRIPPER4PALLET > 0 THEN
	                                    #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER4PALLET);
	                                    #Dispatcher["_master"] := 100;
	                                END_IF;
	                            ELSE
	                                #Dispatcher["_master"] := 0;
	                            END_IF;
	                        END_IF;
	                    "MISSION_UnloadPallet_MC":      // pallet: MC -> Robot
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            IF #MCRequested = 1 THEN
	                                #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER4PALLET);
	                            ELSE
	                                #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER4PALLET);
	                            END_IF;
	                            #Dispatcher["_master"] := 200;
	                        END_IF;
	                    "MISSION_LoadPart_MC":          // part: Robot -> MC
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            IF #MCRequested = 1 THEN
	                                #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER);
	                            ELSE
	                                #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER);
	                            END_IF;
	                            IF #GripperRequested > 0 THEN
	                                #Dispatcher["_master"] := 300;
	                            ELSE
	                                #Error := "MISSION_LoadPart_MC" * 100 + 10;  //Error 12010
	                            END_IF;
	                        END_IF;
	                    "MISSION_UnloadPart_MC":        // part: MC -> Robot
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            IF #MCRequested = 1 THEN
	                                #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER);
	                            ELSE
	                                #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER);
	                            END_IF;
	                            IF #GripperRequested > 0 THEN
	                                #Dispatcher["_master"] := 400;
	                            ELSE
	                                #Error := "MISSION_UnloadPart_MC" * 100 + 10;  //Error 13010
	                            END_IF;
	                        END_IF;
	                    "MISSION_PickPlacePart_MC":     // 16: preleva finito + deposita grezzo, un ingresso solo
	                        IF "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" AND #Error = 0 THEN
	                            IF #GripperRequested > 0 THEN
	                                #Dispatcher["_master"] := 1400;
	                            ELSE
	                                #Error := "MISSION_PickPlacePart_MC" * 100 + 10;
	                            END_IF;
	                        END_IF;
	                    "MISSION_LoadPartOnRobot":      // part: TRAY -> Robot
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            IF #MCRequested = 1 THEN
	                                #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER);
	                            ELSIF #MCRequested = 2 THEN
	                                #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER);
	                            ELSE
	                                #GripperRequested := #Gripper_ID[1];   // nessuna MC indicata: pinza a bordo
	                            END_IF;
	                            IF #GripperRequested > 0 THEN
	                                #Dispatcher["_master"] := 500;
	                            ELSE
	                                #Error := "MISSION_LoadPartOnRobot" * 100 + 10;
	                            END_IF;
	                        END_IF;
	                    "MISSION_UnloadPartFromRobot":  // part: Robot -> TRAY
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            #Dispatcher["_master"] := 600;
	                            // IF #MCRequested = 1 THEN
	                            //     #GripperRequested := DINT_TO_INT("DB_MC1".order.GRIPPER);
	                            //     #Dispatcher["_master"] := 600;
	                            // ELSE
	                            //     #GripperRequested := DINT_TO_INT("DB_MC2".order.GRIPPER);
	                            //     #Dispatcher["_master"] := 600;
	                            // END_IF;
	                        END_IF;
	                        
	                        // COMMANDS NOT NEEDS RemoteMode ACTIVE
	                        
	                    "MISSION_ExtractTray":
	                        //devo prima mandare dentro gli altri se ci sono?
	                        IF #Dispatcher["Extract_TRAY"] = 0 AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 700;
	                        END_IF;
	                    "MISSION_ReleaseTray":
	                        IF #Dispatcher["Release_TRAY"] = 0 AND #Error = 0 THEN
	                            IF "DB_BOX_1".ExtractedTray > 0 THEN
	                                #Dispatcher["Release_TRAY"] := 10;
	                                #Dispatcher["_master"] := 800;
	                            ELSE
	                                #MissionCode := 0;
	                                #Dispatcher["_master"] := 0;
	                            END_IF;
	                        END_IF;
	                    "MISSION_UnloadGripper":
	                        // (35) LE GUARDIE DELLE CATENE PINZA ANCHE QUI: EasyBox in errore (949)
	                        // e cassetto fuori (1519) chiudono la missione subito, invece di
	                        // lasciare il 900 appeso dopo il rifiuto della catena.
	                        IF #Gripper_ID[1] <= 0 THEN
	                            #Error := 936;  // scarico richiesto ma nessuna pinza registrata al sistema
	                            #MissionCode := 0;   // (35) non resta in sospeso
	                        ELSIF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                            #Error := 949;
	                            #MissionCode := 0;
	                        ELSIF #cassettoFuori THEN
	                            #Error := 1519;
	                            #MissionCode := 0;
	                        ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                            #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                            #Dispatcher["_master"] := 900;
	                        END_IF;
	                    "MISSION_LoadGripper":
	                        IF "Gripper_mounted" THEN
	                            #Error := 935;
	                            // (35) NON RESTA IN SOSPESO: col MissionCode scritto il master
	                            // rivalutava a ogni ciclo e, appena il sensore pinza si
	                            // spegneva, partiva il carico chiesto minuti prima
	                            // (simulazione 7/10 bis, B13).
	                            #MissionCode := 0;
	                        ELSIF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                            #Error := 949;
	                            #MissionCode := 0;
	                        ELSIF #cassettoFuori THEN
	                            #Error := 1419;
	                            #MissionCode := 0;
	                        ELSE
	                            #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                            #MCRequested := 0;
	                            
	                            #Dispatcher["_master"] := 950;
	                        END_IF;
	                    "MISSION_SwapGripper":
	                        IF #GripperRequested <= 0 THEN
	                            #Error := 937;          // swap: pinza target non valida
	                            #MissionCode := 0;
	                        ELSIF #GripperRequested = #Gripper_ID[1] THEN
	                            #Error := 939;          // swap: pinza richiesta gia' a bordo
	                            #MissionCode := 0;
	                        ELSIF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                            // (35) LO SWAP NON PASSAVA DALLE GUARDIE DELLE CATENE PINZA: al
	                            // 970 compone da solo la query dello scaffale e manda il comando
	                            // 30. Col cassetto fuori il robot andava allo scaffale pinze,
	                            // contro la decisione del 7/10, e l'intestazione della 34 diceva
	                            // il contrario (simulazione 7/10 bis, B1). Le guardie stanno qui,
	                            // prima di 950 e 970: valgono per il pannello e per FB204, che
	                            // cambia pinza sempre con lo swap (35 di FB204). In automatico
	                            // l'errore porta FB204 in 9999 col 952.
	                            #Error := 949;
	                            #MissionCode := 0;
	                        ELSIF #cassettoFuori THEN
	                            IF #Gripper_ID[1] = 0 THEN
	                                #Error := 1419;     // flangia nuda: sarebbe un carico
	                            ELSE
	                                #Error := 1519;     // lo swap comincia col deposito della pinza a bordo
	                            END_IF;
	                            #MissionCode := 0;
	                        ELSIF #Gripper_ID[1] = 0 THEN
	                            // flangia vuota: degenera nel carico classico (chiude via 950/960)
	                            #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                            #MCRequested := 0;
	                            #Dispatcher["_master"] := 950;
	                        ELSE
	                            #swapDataReady := FALSE;
	                            #Dispatcher["_master"] := 970;
	                        END_IF;
	                    "MISSION_LoadManVice":
	                        ; //TODO
	                    "MISSION_UnloadManVice":
	                        ; //TODO
	                    "MISSION_Unload_Pallet":
	                        IF NOT #RemoteMode THEN
	                            IF #MCRequested = 0 THEN
	                                #Dispatcher["_master"] := 1500;
	                            END_IF;
	                        END_IF;  //TODO
	                    "MISSION_Load_Pallet":                 // pick Object -> Robot (HMI command)
	                        IF NOT #RemoteMode THEN
	                            IF #MCRequested = 0 THEN
	                                #Dispatcher["_master"] := 1000;
	                            END_IF;
	                        END_IF;
	                        
	                    "MISSION_PickPart_TRAY_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1100;
	                        END_IF;
	                    "MISSION_PlacePart_TRAY_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_Part_Robot_to_TRAY"] := 10;
	                            #Dispatcher["_master"] := 1150;
	                        END_IF;
	                    "MISSION_PickPart_MC_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1200;
	                        END_IF;
	                    "MISSION_PlacePart_MC_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_Part_Robot_to_MC"] := 10;
	                            #Dispatcher["_master"] := 1250;
	                        END_IF;
	                    "MISSION_PickPallet_MC_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1300;
	                        END_IF;
	                    "MISSION_PlacePallet_MC_HMI":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_Pallet_Robot_to_MC"] := 10;
	                            #Dispatcher["_master"] := 1350;
	                        END_IF;
	                        
	                    "MISSION_OpenGripper1":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1600;
	                        END_IF;
	                    "MISSION_CloseGripper1":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1620;
	                        END_IF;
	                    "MISSION_OpenGripper2":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1640;
	                        END_IF;
	                    "MISSION_CloseGripper2":
	                        IF NOT #RemoteMode AND #Error = 0 THEN
	                            #Dispatcher["_master"] := 1660;
	                        END_IF;
	                    "MISSION_PositioningMC_AUTO":   // avvicinamento a MC1 in attesa porta
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            "DB_RobotMission".Unit_code := "MC1";
	                            "DB_RobotMission".Command := "CMD_RobotPositioning";
	                            #Dispatcher["_master"] := 1700;
	                        END_IF;
	                    "MISSION_RobotHome_AUTO":   // ritorno in home a fine produzione
	                        // CMD_RobotToHomePos e' accettato SOLO in manuale (la
	                        // REGION comandi HMI lo chiude dentro NOT RemoteMode), e
	                        // in automatico non e' raggiungibile. Serviva una missione
	                        // dedicata, sul modello di MISSION_PositioningMC_AUTO che
	                        // esiste per lo stesso identico motivo.
	                        IF #RemoteMode AND
	                            "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                        THEN
	                            "DB_RobotMission".Command := "CMD_RobotToHomePos";
	                            #Dispatcher["_master"] := 1750;
	                        END_IF;
	                        
	                END_CASE;
	                
	                /////////////////////////// 
	            100: //MISSION_LoadPallet_MC1 or MC2
	                // TRE RAMI, come il 1100 (17/9): il controllo sulla sola
	                // disuguaglianza lanciava lo scarico anche a FLANGIA NUDA —
	                // Gripper_ID[1]=0 e' diverso da qualunque pinza richiesta, quindi
	                // _Gripper_Robot_to_TRAY partiva e componeva la query con id=0,
	                // che a scaffale non esiste: zero righe, errore 990, master
	                // appeso al 110 per sempre. Visto in campo avviando senza pinza.
	                IF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 110;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    // flangia nuda: niente da scaricare, si carica e basta
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 115;
	                ELSE
	                    #Dispatcher["_master"] := 120;
	                END_IF;
	            110:
	                // GUARDIA SULLA CATENA DI SCARICO (16/9): serve anche la conferma
	                // che _Gripper_Robot_to_TRAY abbia CHIUSO, non solo che il registro
	                // sia tornato a zero. Gripper_ID[1] viene azzerato allo stato 40
	                // della catena di scarico, che poi passa al 50 e aspetta l'update
	                // del database: in quella finestra il registro dice gia' "flangia
	                // nuda" mentre la catena sta ancora lavorando, e il carico partiva
	                // sovrapponendosi allo scarico sullo stesso ponte SQL.
	                // Gli altri rami analoghi — 210, 310, 410 — la guardia ce l'hanno
	                // gia': il 110 era l'unico rimasto scoperto.
	                // (35) ESITO DELLO SCARICO: con la catena chiusa senza scaricare (949,
	                // 1519 col cassetto fuori) o ferma a 990 il master restava appeso.
	                // Adesso chiude e lascia l'errore: FB204 va in 9999 col 952.
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    IF #Gripper_ID[1] = 0 THEN
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 115;
	                    ELSE
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            115:
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    #Dispatcher["get_TCP_Data"] := 10;
	                    #Dispatcher["_master"] := 120;
	                END_IF;
	            120: //gripper OK -> start mission
	                // TCP NON AGGIORNATO = NIENTE MISSIONE (5/10): se get_TCP_Data chiude
	                // in errore (2205 pinza assente dal DB, 99 errore DB) il robot ha
	                // ancora il TCP della pinza precedente. Prima si lanciava comunque il
	                // prelievo pallet; ora la missione si chiude e resta l'errore.
	                IF #Dispatcher["get_TCP_Data"] = 0 AND #Error <> 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF #Gripper_ID[1] = #GripperRequested AND #Dispatcher["get_TCP_Data"] = 0 THEN
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 130;
	                END_IF;
	            130:
	                IF #GripperOccuped[1] AND
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" AND  //"cmd_executed"   ****
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] = 0 THEN // #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 10;
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    #Dispatcher["_master"] := 140;
	                END_IF;
	            140: //Mission ended
	                IF #Dispatcher["_Pallet_Robot_to_MC"] = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                    #MissionCode := 0;
	                END_IF;
	                
	                /////////////////////////// 
	            200: //MISSION_UnloadPallet_MC1 or MC2
	                // TRE RAMI (17/9): a flangia nuda Gripper_ID[1]=0 e' diverso da
	                // qualunque pinza richiesta, quindi partiva lo scarico di una
	                // pinza inesistente -> query con id=0 -> 990. Vedi nota al 100.
	                // (35) Dopo un carico pinza si passa dal 215, che manda il TCP della
	                // pinza nuova come il 115 nel montaggio pallet. Prima il 220 lanciava
	                // il prelievo del pallet in macchina col TCP della pinza di prima.
	                IF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 210;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 215;
	                ELSE
	                    #Dispatcher["_master"] := 220;
	                END_IF;
	            210:
	                // (35) esito dello scarico: con la catena chiusa senza scaricare
	                // (949, 1519) o ferma a 990 il master restava appeso
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    IF #Gripper_ID[1] = 0 THEN
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 215;
	                    ELSE
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            215: // (35) pinza caricata: TCP al robot, come al 115
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    IF #Gripper_ID[1] = #GripperRequested THEN
	                        #Dispatcher["get_TCP_Data"] := 10;
	                        #Dispatcher["_master"] := 220;
	                    ELSE
	                        // la catena ha chiuso senza montare la pinza (949, 1419, 990):
	                        // resta l'errore, e FB204 va in 9999 col 952
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                END_IF;
	            220: //gripper OK -> start mission
	                // (35) TCP NON AGGIORNATO = NIENTE MISSIONE, come al 120
	                IF #Dispatcher["get_TCP_Data"] = 0 AND #Error <> 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF #Gripper_ID[1] = #GripperRequested AND #Dispatcher["_Gripper_TRAY_to_Robot"] = 0
	                    AND #Dispatcher["get_TCP_Data"] = 0
	                THEN
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 230;
	                END_IF;
	            230:
	                // (35) ATTESA SU waitingNewCmd, COME AL 130. Pallet_MC_to_Robot azzera
	                // Command al suo 50: il robot torna a waitingNewCmd e "cmd_executed" qui
	                // non si vedeva piu'. Il 230 restava fermo a ogni scarico pallet
	                // automatico (simulazione 7/10 bis, B4; agente 4 della prima).
	                IF #GripperOccuped[1] AND
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" AND
	                    #Dispatcher["_Pallet_MC_to_Robot"] = 0 THEN
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 10;
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    #Dispatcher["_master"] := 240;
	                END_IF;
	                
	            240: //Mission ended
	                IF #Dispatcher["_Pallet_Robot_to_TRAY"] = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                    #MissionCode := 0;
	                END_IF;
	                
	                /////////////////////////// 
	            300: //MissionLoadPart_MC1 or MC2
	                // TRE RAMI (17/9): vedi nota al 100.
	                IF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 310;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 320;
	                ELSE
	                    #Dispatcher["_master"] := 320;
	                END_IF;
	            310:
	                IF #Gripper_ID[1] = 0 AND #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 320;
	                END_IF;
	                
	            320: //gripper OK -> start mission
	                IF #Gripper_ID[1] = #GripperRequested AND
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    
	                    IF NOT #GripperOccuped[1] THEN
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 10;
	                    END_IF;
	                    #Dispatcher["_master"] := 330;
	                END_IF;
	            330:
	                IF #GripperOccuped[1] AND
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" AND
	                    #Dispatcher["_Part_TRAY_to_Robot"] = 0
	                THEN
	                    #Dispatcher["_Part_Robot_to_MC"] := 10;
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    #Dispatcher["_master"] := 340;
	                END_IF;
	            340: //Mission ended
	                IF #Dispatcher["_Part_Robot_to_MC"] = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                    #MissionCode := 0;
	                END_IF;
	                
	                ///////////////////////////
	            400: //MissionUnloadPart_MC1 or MC2
	                // TRE RAMI (17/9): vedi nota al 100.
	                IF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 410;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 420;
	                ELSE
	                    #Dispatcher["_master"] := 420;
	                END_IF;
	            410:
	                IF #Gripper_ID[1] = 0 AND
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] = 0
	                THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 420;
	                END_IF;
	                
	            420: //gripper OK -> start mission
	                IF #Gripper_ID[1] = #GripperRequested AND
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] = 0
	                THEN
	                    #Dispatcher["_Part_MC_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 430;
	                END_IF;
	                
	            430:
	                IF ("DB_RobotMissionStatus".StatusCode = "cmd_executed" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd") AND
	                    #Dispatcher["_Part_MC_to_Robot"] = 0
	                THEN
	                    IF #GripperOccuped[1] AND #GripperOccuped[2] THEN
	                        // entrambi i lati pieni: la macchina sceglie la prossima mossa
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperOccuped[1] OR #GripperOccuped[2] THEN
	                        // UN SOLO LATO PIENO, quale che sia: si deposita.
	                        // Prima la condizione era "GripperOccuped[1] AND NOT [2]":
	                        // col finito prelevato dal LATO 2 (caso normale del ciclo
	                        // automatico, lato 1 libero perche' il grezzo e' gia' in
	                        // macchina) nessun ramo scattava e la catena restava
	                        // appesa qui (visto 5/9).
	                        #Dispatcher["_Part_Robot_to_TRAY"] := 10;
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        
	                        #Dispatcher["_master"] := 440;
	                    END_IF;
	                END_IF;
	                
	            440: //Mission ended
	                IF #Dispatcher["_Part_Robot_to_TRAY"] = 0
	                THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                    #MissionCode := 0;
	                END_IF;
	                
	                /////////////////////////// 
	            500: //MISSION_LoadPartOnRobot
	                // TRE RAMI (17/9): vedi nota al 100.
	                IF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 510;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 520;
	                ELSE
	                    #Dispatcher["_master"] := 520;
	                END_IF;
	            510:
	                IF #Gripper_ID[1] = 0 AND
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] = 0
	                THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 520;
	                END_IF;
	                
	            520: //gripper OK -> start mission
	                IF #Gripper_ID[1] = #GripperRequested AND #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 530;
	                END_IF;
	            530:
	                IF #Dispatcher["_Part_TRAY_to_Robot"] = 100 THEN                 //MISSION SUSPENDED FOR WAIT TRAY
	                    IF "DB_BOX_1".ExtractedTray <> "DB_BOX_1".RequestedTray AND
	                        #MissionCode = "MISSION_ExtractTray" AND
	                        #Dispatcher["Extract_TRAY"] = 0
	                    THEN
	                        //HERE ONLY IF WAREHOUSE IS A EASYBOX
	                        //start extract tray
	                        #Dispatcher["Extract_TRAY"] := 10;
	                    END_IF;
	                ELSE
	                    IF #GripperOccuped[1] AND
	                        ("DB_RobotMissionStatus".StatusCode = "cmd_executed" OR
	                        "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd") AND
	                        #Dispatcher["_Part_TRAY_to_Robot"] = 0 THEN
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                        #MissionCode := 0;
	                    END_IF;
	                END_IF;
	                
	                /////////////////////////// 
	            600: //MISSION_UnloadPartOnRobot
	                // SI SCARICA CON LA PINZA CHE C'E' (5/10). Il confronto con
	                // GripperRequested era un residuo: FB204 lancia questa missione da 35,
	                // 52, 58, 95 e 104 senza impostarlo, dopo un riavvio vale 0 e il ramo
	                // gancio di get_TCP_Data lo azzera. Il master restava qui per sempre,
	                // senza errore. Part_Robot_to_TRAY non lo usa: lo si allinea alla pinza
	                // a bordo e si parte.
	                IF #Gripper_ID[1] > 0 THEN
	                    #GripperRequested := #Gripper_ID[1];
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 630;
	                ELSE
	                    #Error := 964;   // scarico pezzo senza pinza registrata a bordo
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            630:
	                // LATO CONFRONTATO, NON USATO COME INDICE (5/10). Gripper_Side vale 0
	                // dopo STOP->RUN (DB_RobotMission non ritentivo) finche' il 30 di
	                // Part_Robot_to_TRAY non lo scrive, e questo stato lo legge prima:
	                // GripperOccuped[0] e' fuori dall'array [1..2], errore di accesso.
	                // Prima il 600 restava fermo dopo un riavvio e qui non si arrivava.
	                IF (("DB_RobotMission".Gripper_Side = 1 AND NOT #GripperOccuped[1])
	                    OR ("DB_RobotMission".Gripper_Side = 2 AND NOT #GripperOccuped[2]))
	                    AND ("DB_RobotMissionStatus".StatusCode = "cmd_executed" OR "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd")
	                    AND #Dispatcher["_Part_Robot_to_TRAY"] = 0
	                THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF #Dispatcher["_Part_Robot_to_TRAY"] = 0
	                    AND (#Error <> 0
	                    OR ("DB_RobotMission".Gripper_Side <> 1 AND "DB_RobotMission".Gripper_Side <> 2))
	                THEN
	                    // la catena ha chiuso in errore (es. 949 porta operatore aperta)
	                    // prima di scrivere il lato: si chiude la missione, resta l'errore
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////////////////////     
	            700: //MISSION_ExtractTray
	                // (7/10, decisione di Dario) IL CASSETTO SI ESTRAE SOLO CON UNA PINZA CON
	                // L'UNCINO (GRIPPER.HAS_HOOK = 1). La ricerca dice quale: la pinza a bordo
	                // se ce l'ha, altrimenti una a scaffale. Fino al 7/10 con una pinza a bordo
	                // si estraeva con quella senza nessun controllo, e senza pinza si cercava
	                // una riga "gancio" che portava a una pinza inesistente (ID 2).
	                // Il controllo vero sta anche nella catena (30 di Extract_TRAY), che vale
	                // per ogni percorso.
	                #Dispatcher["_Gripper_Hook_Search"] := 10;
	                #Dispatcher["_master"] := 705;
	            705: // esito della ricerca della pinza con uncino
	                IF #Dispatcher["_Gripper_Hook_Search"] = 0 THEN
	                    IF #Error <> 0 THEN
	                        // nessuna pinza con uncino (19006) o errore DB: resta l'errore
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperRequested = #Gripper_ID[1] THEN
	                        // la pinza a bordo ha l'uncino
	                        #Dispatcher["_master"] := 730;
	                    ELSIF #RemoteMode THEN
	                        // CICLO AUTOMATICO: a bordo c'e' la pinza dell'ordine, che serve
	                        // anche per prendere il pezzo. Cambiarla qui vorrebbe dire
	                        // ricambiarla col cassetto fuori, che e' vietato (1419/1519).
	                        // Ci si ferma: la pinza dell'ordine deve avere l'uncino.
	                        #Error := 19005;
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperOccuped[1] OR #GripperOccuped[2] THEN
	                        #Error := 19007;   // per prendere la pinza con uncino quella a bordo deve essere vuota
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #Gripper_ID[1] > 0 THEN
	                        // COMANDO DAL PANNELLO (decisione di Dario): il PLC va a prendersi
	                        // la pinza con l'uncino. Prima scarica quella a bordo.
	                        #MCRequested := 0;
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                        #Dispatcher["_master"] := 710;
	                    ELSE
	                        // flangia nuda: si carica e basta
	                        #MCRequested := 0;
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 715;
	                    END_IF;
	                END_IF;
	                
	            710: // scarico della pinza a bordo, che non ha l'uncino
	                // Guardia doppia come al 110: registro a zero E catena chiusa.
	                IF #Gripper_ID[1] = 0 AND #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 715;
	                ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0
	                    OR #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990
	                THEN
	                    // la catena ha chiuso senza scaricare (949, 1519 cassetto fuori),
	                    // oppure (35) si e' fermata a 990 (slot a scaffale non trovato, che
	                    // non torna a 0 da solo): si chiude la missione, resta l'errore
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            715: // carico della pinza con uncino
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    IF #Gripper_ID[1] = #GripperRequested THEN
	                        #Dispatcher["get_TCP_Data"] := 10;
	                        #Dispatcher["_master"] := 720;
	                    ELSE
	                        // la catena ha chiuso senza montare la pinza (949, 1419 cassetto
	                        // fuori, 937): si chiude la missione, resta l'errore
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                END_IF;
	            720: // TCP della pinza nuova al robot
	                // TCP NON AGGIORNATO = NIENTE ESTRAZIONE, come al 120: il robot avrebbe
	                // ancora le misure della pinza di prima.
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    IF #Error <> 0 THEN
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSE
	                        #Dispatcher["_master"] := 730;
	                    END_IF;
	                END_IF;
	            730: //start extract tray
	                #Dispatcher["Extract_TRAY"] := 10;
	                #Dispatcher["_master"] := 750;
	                
	            750:// extract tray finished
	                // CHIUDE ANCHE IN ERRORE (19/9): la condizione era
	                // "Extract_TRAY = 0 AND #Error = 0". Se un errore si alzava
	                // durante l'estrazione, la catena chiudeva ma questo stato
	                // smetteva di guardarla e MissionCode restava a 200 per sempre.
	                // Da li' la sincronizzazione di FB8 — che pretende MissionCode = 0 —
	                // non girava piu', ExtractedTray restava disallineato dai sensori,
	                // il check posizione rigenerava l'errore a ogni scan e il 949
	                // tornava subito dopo ogni reset. Visto in campo.
	                IF #Dispatcher["Extract_TRAY"] = 0 THEN
	                    #MissionCode := 0;
	                    
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////////////////////     
	            800://MISSION_ReleaseTray
	                IF #Dispatcher["Release_TRAY"] > 10 THEN
	                    #Dispatcher["_master"] := 810;
	                ELSIF #Dispatcher["Release_TRAY"] = 0 THEN
	                    // CHIUSURA SE IL 10 HA GIA' RIFIUTATO (5/10): porta aperta (949),
	                    // pinza assente (2022) o nessun cassetto fuori (20001) portano la
	                    // catena a 0 nello stesso scan in cui la si lancia. L'800 aspettava
	                    // "> 10" per sempre e MissionCode restava a 203.
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            810:
	                // CHIUDE ANCHE IN ERRORE (19/9): vedi nota al 750.
	                IF #Dispatcher["Release_TRAY"] = 0 THEN
	                    #MissionCode := 0;
	                    
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                ///////////////////////////   
	            900://"MISSION_UnloadGripper"
	                // (35) CHIUDE ANCHE IN ERRORE: con "AND #Error = 0" una catena chiusa
	                // con un errore (949) o ferma a 990 lasciava il master appeso con
	                // MissionCode scritto. L'errore resta, si toglie col RESET.
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0
	                    OR #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990
	                THEN
	                    #MissionCode := 0;
	                    
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                ///////////////////////////   
	            950://"MISSION_LoadGripper"
	                // (35) SI DECIDE SUL REGISTRO, NON SULL'ERRORE: pinza montata e
	                // registrata = TCP al robot (960), anche se nel frattempo e' salito un
	                // errore che non c'entra (per esempio un 938 della supervisione). La
	                // catena chiusa senza montare (949, 1419, 937, 990) chiude la missione
	                // e lascia l'errore. Prima, con "AND #Error = 0", il master restava
	                // appeso con MissionCode scritto.
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    IF #Gripper_ID[1] = #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                        #Dispatcher["get_TCP_Data"] := 10;
	                        #Dispatcher["_master"] := 960;
	                    ELSE
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                END_IF;
	                
	            960: //WAIT end update data
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    #MissionCode := 0;
	                    
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    #Dispatcher["_master"] := 0;
	                    
	                END_IF;
	                
	                //////////////////////
	            970: // SWAP fase A: query slot di casa della pinza a bordo
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'SELECT X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_GRIPPER_SHELF where id=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_master"] := 971;
	                END_IF;
	            971: // presa in carico query VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza il confronto su
	                // sqlCommands[0] il 972 puo' leggere la risposta di un altro
	                // richiedente e mandare il robot su coordinate altrui.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_master"] := 972;
	                END_IF;
	            972: // frame A (deposito) + comando 17
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // slot di casa della pinza a bordo non trovato: con FB6 corretto
	                    // "zero righe" non e' piu' dataError, va intercettato qui.
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[0];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[7];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Gripper";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_Side := 1;
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    "DB_RobotMission".Command := "CMD_RobotSwapGripper";
	                    #Dispatcher["_master"] := 973;
	                ELSIF "DB_executeQuery".dataError THEN
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            973: // attesa acquisizione robot
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 974;
	                END_IF;
	            974: // deposito eseguito: il robot alza REQ_FASE2 restando in executing
	                IF "Robot_SwapPhase2Req" AND NOT "Gripper_mounted" THEN
	                    #Gripper_ID[1] := 0;                       // registro di meta' corsa: la vecchia e' a terra
	                    #Gripper_ID[2] := 0;
	                    #Dispatcher["updateGripperOnRobot"] := 10; // DB e pannello sanno subito
	                    #Dispatcher["_master"] := 975;
	                END_IF;
	            975: // query slot della pinza nuova
	                IF #Dispatcher["updateGripperOnRobot"] = 0 AND "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'SELECT X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_GRIPPER_SHELF where id=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#GripperRequested));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_master"] := 976;
	                END_IF;
	            976: // presa in carico query VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza il confronto su
	                // sqlCommands[0] il 977 puo' leggere la risposta di un altro
	                // richiedente. Qui e' particolarmente critico: la pinza vecchia
	                // e' gia' a terra e il robot sta per andare a prendere la nuova.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_master"] := 977;
	                END_IF;
	            977: // frame B (prelievo) + DATI_PRONTI
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // slot della pinza nuova non trovato: con FB6 corretto "zero
	                    // righe" non e' piu' dataError, va intercettato qui.
	                    // NB: pinza vecchia gia' a terra e registrata: stato coerente.
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[0];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[7];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "Gripper";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_Side := 1;
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #swapDataReady := TRUE;          // -> Option_free verso il robot
	                    #Dispatcher["_master"] := 978;
	                ELSIF "DB_executeQuery".dataError THEN
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    // NB: pinza vecchia gia' a terra e registrata: stato coerente, missione morta qui
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            978: // esito prelievo: doppia conferma (esito + sensore)
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" AND "Gripper_mounted" THEN
	                    #swapDataReady := FALSE;
	                    "DB_RobotMission".Command := 0;
	                    // REGISTRI E DATABASE LI SCRIVE LA CATENA UNICA (17/9): e' lei
	                    // che cerca la gemella. Prima il 978 scriveva solo il lato 1 e
	                    // il lato 2 restava a zero — e siccome il 35 di FB204 cambia
	                    // pinza SEMPRE via swap, in ciclo automatico la pinza doppia
	                    // veniva usata come singola: niente missione 16, finito preso
	                    // col lato 1, e l'operatore costretto a dichiararlo a mano.
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 10;
	                    #Dispatcher["_master"] := 9781;
	                END_IF;
	                
	            9781: // attesa registrazione conclusa
	                IF #Dispatcher["_Set_Gripper_OnBoard"] = 0 THEN
	                    #Dispatcher["_master"] := 979;
	                END_IF;
	                
	            979: // update chiuso + robot libero -> aggiornamento TCP
	                // La guardia su updateGripperOnRobot e' ridondante — la catena
	                // _Set_Gripper_OnBoard al 50 aspetta gia' che l'update chiuda —
	                // ma costa niente e rende lo stato leggibile da solo: qui si
	                // prosegue solo con database allineato E robot libero.
	                IF #Dispatcher["updateGripperOnRobot"] = 0 AND
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN
	                    #Dispatcher["get_TCP_Data"] := 10;
	                    #Dispatcher["_master"] := 980;
	                END_IF;
	            980: // TCP chiuso -> fine missione
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    #Dispatcher["_master"] := 985;
	                END_IF;
	            985: // ri-assert del codice pinza dopo il reset (il registro è la verità)
	                IF #Dispatcher["Reset_or_log_MissionData"] = 0 THEN
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                //////////////////////
	            1000: //MISSION_Load_Pallet
	                // (35) GripperRequested azzerato prima della ricerca: se la ricerca non
	                // trova la pinza del pallet (1722) il valore vecchio restava, e il 1010
	                // cambiava pinza verso una pinza che col pallet non c'entra.
	                #GripperRequested := 0;
	                #Dispatcher["_Gripper4Pallet_Search"] := 10;
	                #Dispatcher["_master"] := 1010;
	                
	            1010:
	                // (35) OGNI PASSO GUARDA L'ESITO DEL PRECEDENTE. Prima il 1020 e il 1050
	                // guardavano solo "catena a 0": dopo un rifiuto del cambio pinza (1519,
	                // 1419 col cassetto fuori, 949) il robot andava a prendere il pallet
	                // con la pinza di prima (simulazione 7/10 bis, B2). In piu':
	                //   - cambio pinza col cassetto fuori: rifiutato qui, prima di muovere;
	                //   - flangia nuda: si carica la pinza (prima si saltava al 1050 e si
	                //     lanciava il prelievo pallet senza pinza);
	                //   - dopo un carico, il TCP della pinza nuova (1030-1040), come al 115;
	                //   - ogni esito negativo chiude la missione e lascia l'errore.
	                IF #Dispatcher["_Gripper4Pallet_Search"] = 0 THEN
	                    IF #GripperRequested <= 0 THEN
	                        #Error := "_Gripper4Pallet_Search" * 100 + 22;
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperRequested = #Gripper_ID[1] THEN
	                        #Dispatcher["_master"] := 1050;      // pinza giusta gia' a bordo
	                    ELSIF #cassettoFuori THEN
	                        #Error := 1519;                      // cambio pinza col cassetto fuori
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #Gripper_ID[1] > 0 THEN
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                        #Dispatcher["_master"] := 1020;
	                    ELSE
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 1030;
	                    END_IF;
	                END_IF;
	                
	            1020: // scarico della pinza a bordo
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    IF #Gripper_ID[1] = 0 THEN
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 1030;
	                    ELSE
	                        #MissionCode := 0;                   // scarico non riuscito: resta l'errore
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990 THEN
	                    #MissionCode := 0;                       // catena ferma a 990: resta l'errore
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1030: // carico della pinza del pallet
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    IF #Gripper_ID[1] = #GripperRequested THEN
	                        #Dispatcher["get_TCP_Data"] := 10;
	                        #Dispatcher["_master"] := 1040;
	                    ELSE
	                        #MissionCode := 0;                   // carico non riuscito: resta l'errore
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                END_IF;
	            1040: // TCP della pinza nuova: non aggiornato = niente prelievo, come al 120
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    IF #Error <> 0 THEN
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSE
	                        #Dispatcher["_master"] := 1050;
	                    END_IF;
	                END_IF;
	            1050: // prelievo del pallet, solo con la pinza giusta
	                IF #Gripper_ID[1] = #GripperRequested AND #Error = 0 THEN
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1060;
	                ELSE
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            1060:
	                IF #Dispatcher["_Pallet_TRAY_to_Robot"] = 0 THEN
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                //////////////////////
	            1500: //MISSION_Unload_Pallet  (HMI command)
	                IF #Gripper_ID[1] = 0 THEN
	                    #Error := "MISSION_Unload_Pallet" * 100 + 22;
	                ELSIF NOT #GripperOccuped[1] THEN
	                    #Error := "MISSION_Unload_Pallet" * 100 + 23;
	                ELSE
	                    #Dispatcher["_master"] := 1510;
	                END_IF;
	                
	                ///////////// 1100: pick pezzo da cassetto (HMI)
	            1100: // swap pinza se serve (pattern catene auto)
	                // (35) cambio pinza col cassetto fuori: rifiutato qui, prima di muovere.
	                // Questa missione vuole il cassetto fuori per costruzione: con una pinza
	                // diversa da quella a bordo il master restava appeso al 1110 col 1519
	                // della catena (simulazione 7/10 bis, B8).
	                IF #Gripper_ID[1] <> #GripperRequested AND #cassettoFuori THEN
	                    #Error := 1519;
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 1110;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1115;
	                ELSE
	                    #Dispatcher["_master"] := 1120;
	                END_IF;
	                
	            1110: // scarico pinza attuale
	                IF #Gripper_ID[1] = 0 AND #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1115;
	                END_IF;
	            1115: // carico pinza richiesta
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    #Dispatcher["_master"] := 1120;
	                END_IF;
	            1120: // pinza ok -> preleva pezzo
	                IF #Gripper_ID[1] = #GripperRequested THEN
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1130;
	                END_IF;
	            1130: // fine
	                IF #Dispatcher["_Part_TRAY_to_Robot"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1150: place pezzo in cassetto (HMI)
	            1150:
	                IF #Dispatcher["_Part_Robot_to_TRAY"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1200: pick pezzo da MC1 (HMI)
	            1200: // swap pinza se serve
	                // (35) cambio pinza col cassetto fuori: rifiutato qui, come al 1100
	                IF #Gripper_ID[1] <> #GripperRequested AND #cassettoFuori THEN
	                    #Error := 1519;
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF #Gripper_ID[1] <> #GripperRequested AND #Gripper_ID[1] > 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["_master"] := 1210;
	                ELSIF #Gripper_ID[1] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1215;
	                ELSE
	                    #Dispatcher["_master"] := 1220;
	                END_IF;
	                
	            1210:
	                IF #Gripper_ID[1] = 0 AND #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1215;
	                END_IF;
	            1215:
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    #Dispatcher["_master"] := 1220;
	                END_IF;
	            1220:
	                IF #Gripper_ID[1] = #GripperRequested THEN
	                    #Dispatcher["_Part_MC_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1230;
	                END_IF;
	            1230:
	                IF #Dispatcher["_Part_MC_to_Robot"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1250: place pezzo su MC1 (HMI)
	            1250:
	                IF #Dispatcher["_Part_Robot_to_MC"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1300: pick pallet da MC1 (HMI)
	            1300: // pinza giusta dal pallet (come 1000 warehouse)
	                #GripperRequested := 0;   // (35) vedi il 1000
	                #Dispatcher["_Gripper4Pallet_Search"] := 10;
	                #Dispatcher["_master"] := 1310;
	            1310:
	                // (35) STESSO SCHEMA DEL 1010: esito di ogni passo, cambio pinza col
	                // cassetto fuori rifiutato, TCP dopo un carico (1335), chiusura con
	                // l'errore invece del master appeso.
	                IF #Dispatcher["_Gripper4Pallet_Search"] = 0 THEN
	                    IF #GripperRequested <= 0 THEN
	                        #Error := "_Gripper4Pallet_Search" * 100 + 22;
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperRequested = #Gripper_ID[1] THEN
	                        #Dispatcher["_master"] := 1340;
	                    ELSIF #cassettoFuori THEN
	                        #Error := 1519;
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #Gripper_ID[1] > 0 THEN
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                        #Dispatcher["_master"] := 1320;
	                    ELSE
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 1330;
	                    END_IF;
	                END_IF;
	            1320:
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    IF #Gripper_ID[1] = 0 THEN
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                        #Dispatcher["_master"] := 1330;
	                    ELSE
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] >= 990 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1330:
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    IF #Gripper_ID[1] = #GripperRequested THEN
	                        #Dispatcher["get_TCP_Data"] := 10;
	                        #Dispatcher["_master"] := 1335;
	                    ELSE
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    END_IF;
	                END_IF;
	            1335: // (35) TCP della pinza nuova: non aggiornato = niente prelievo
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    IF #Error <> 0 THEN
	                        #MissionCode := 0;
	                        #MCRequested := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSE
	                        #Dispatcher["_master"] := 1340;
	                    END_IF;
	                END_IF;
	            1340:
	                IF #Gripper_ID[1] = #GripperRequested AND #Error = 0 THEN
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 10;
	                    #Dispatcher["_master"] := 1345;
	                ELSE
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1345:
	                IF #Dispatcher["_Pallet_MC_to_Robot"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1350: place pallet su MC1 (HMI)
	            1350:
	                IF #Dispatcher["_Pallet_Robot_to_MC"] = 0 AND #Error = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                ///////////// 1400: prelievo finito + deposito grezzo in MC (comando robot 16)
	                // Un solo ingresso in macchina: il robot arriva col grezzo sul lato 1,
	                // preleva il finito col lato 2, ruota, deposita il grezzo.
	                // Handshake a due fasi come lo swap pinza: il robot alza
	                // Robot_SwapPhase2Req, il PLC manda il frame di deposito e Ok_Phase2_MC.
	            1400: // query unica: entrambe le quote dalla stessa posizione MC.
	                // Il calcolo sta nella vista COORDINATES_PICKPLACE_MC: la query
	                // composta a mano superava i 254 caratteri di queryTemp e arrivava
	                // TRONCATA a SQL -> zero righe -> 13599 (visto 15/9). Il 1401 non
	                // se ne accorge perche' confronta con la stessa stringa tagliata.
	                // Z_PICK_MC = prelievo del FINITO (Z_PLACE del pezzo)
	                // Z_PLACE_MC = deposito del GREZZO (Z_PICK del pezzo)
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #GripperOccuped[1] THEN
	                        #Error := "MISSION_PickPlacePart_MC" * 100 + 23;   // nessun grezzo a bordo
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF #GripperOccuped[2] THEN
	                        #Error := "MISSION_PickPlacePart_MC" * 100 + 21;   // lato finito gia' occupato
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF "DB_MC1".io_in.viceOpened THEN
	                        // MORSA APERTA = NESSUN FINITO DA PRELEVARE (17/9).
	                        // Stessa guardia del 10 di Part_MC_to_Robot: la 16 entra in
	                        // macchina per prelevare E depositare, senza pezzo da
	                        // prendere la sequenza a due fasi non ha senso.
	                        #Error := 894;
	                        #MissionCode := 0;
	                        #Dispatcher["_master"] := 0;
	                    ELSIF "DB_MC1".order.ID > 0 THEN
	                        #queryTemp := CONCAT(IN1 := 'select X,Y,Z_PICK_MC,Z_PLACE_MC,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_PICKPLACE_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_master"] := 1401;
	                    ELSE
	                        // MANUALE: nessun ordine attivo, uso il piu' recente
	                        #queryTemp := 'select top 1 X,Y,Z_PICK_MC,Z_PLACE_MC,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_PICKPLACE_MC order by ORDER_ID desc';
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_master"] := 1401;
	                    END_IF;
	                END_IF;
	            1401: // presa in carico query VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza il confronto su
	                // sqlCommands[0] il 1402 puo' leggere la risposta di un altro
	                // richiedente e mandare al robot quote sbagliate per il prelievo
	                // del finito E per il deposito del grezzo (zPlaceTemp).
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_master"] := 1402;
	                END_IF;
	            1402: // FRAME A: prelievo del finito, lato 2. La missione NON parte qui:
	                // prima si leggono e si congelano le quote di spinta (1410-1414),
	                // perche' il robot non deve aspettare il ponte SQL a pezzo posato.
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // quote non trovate (ordine/pezzo/attrezzatura incoerenti a DB):
	                    // con FB6 corretto "zero righe" non e' piu' dataError.
	                    #Error := "MISSION_PickPlacePart_MC" * 100 + 99;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    // QUOTE DI DEPOSITO CONGELATE, come zPlaceTemp: il frame B le
	                    // riprende tali e quali. Cosi' la fase di deposito e' identica
	                    // a quella collaudata in Part_Robot_to_MC.
	                    #xPlaceTemp := "SqlData".data.rows[0].col[0];
	                    #zPlaceTemp := "SqlData".data.rows[0].col[3];
	                    
	                    // X DI PRELIEVO = quota nominale + CORSA DELLA SPINTA DEL PEZZO
	                    // PRECEDENTE: il finito in macchina puo' esserci stato messo
	                    // con la spinta, e allora non sta dove il deposito lo aveva
	                    // posato. Vale zero se la spinta non c'e' stata.
	                    "DB_RobotMission"."X_Pick-Place" := #xPlaceTemp + #xPushOffsetMC;
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];   // Z_PICK
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[6];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[10];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[7], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "Part";
	                    "DB_RobotMission".Unit_code := #MCRequested + 10;
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_RobotMission".Gripper_Side := 2;                  // finito
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #xPushTemp := 0;
	                    #xStopTemp := 0;
	                    #Dispatcher["_master"] := 1410;
	                ELSIF "DB_executeQuery".dataError THEN
	                    #Error := "MISSION_PickPlacePart_MC" * 100 + 99;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            1403: // attesa acquisizione robot
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1404;
	                END_IF;
	                
	            1404: // il robot ha il finito e chiede la fase 2 -> FRAME B: deposito grezzo, lato 1
	                IF "Robot_Phase2Req_MC" THEN
	                    "DB_RobotMission"."X_Pick-Place" := #xPlaceTemp;      // quota nominale
	                    "DB_RobotMission"."Z_Pick-Place" := #zPlaceTemp;      // Z_PLACE
	                    "DB_RobotMission".Gripper_Side := 1;                  // grezzo
	                    "Ok_Phase2_MC" := TRUE;
	                    IF "Q_PushEnable_MC" THEN
	                        #Dispatcher["_master"] := 1420;
	                    ELSE
	                        #Dispatcher["_master"] := 1405;
	                    END_IF;
	                END_IF;
	                
	            1405: // missione conclusa: aggiorna i registri di bordo
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "Ok_Phase2_MC" := FALSE;
	                    "DB_RobotMission".Command := 0;
	                    #GripperOccuped[2] := TRUE;                           // finito a bordo
	                    #GripperOccuped[1] := FALSE;                          // grezzo lasciato in macchina
	                    
	                    // CORSA DELLA SPINTA applicata al grezzo appena depositato: il
	                    // prelievo del prossimo giro dovra' andare a prenderlo li'.
	                    IF "Q_PushEnable_MC" THEN
	                        #xPushOffsetMC := #xStopTemp - #xPushTemp;
	                    ELSE
	                        #xPushOffsetMC := 0;
	                    END_IF;
	                    
	                    "Q_PushEnable_MC" := FALSE;
	                    "Ok_PushSpinta_MC" := FALSE;
	                    "Ok_PushArrivo_MC" := FALSE;
	                    
	                    #Dispatcher["updatePartOnRobot"] := 20 + DINT_TO_INT("FINISHED");
	                    #Dispatcher["_master"] := 1406;
	                END_IF;
	                
	            1406:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    "DB_RobotMission".Gripper_Side := 1;
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("EMPTY");
	                    #Dispatcher["_master"] := 1407;
	                END_IF;
	            1407:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnMC"] := 10 + DINT_TO_INT("RAW");
	                    #Dispatcher["_master"] := 1408;
	                END_IF;
	            1408: // fine missione
	                IF #Dispatcher["updatePartOnMC"] = 0 THEN
	                    #MissionCode := 0;
	                    #MCRequested := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	            1410: // SPINTA: query sulle quote di spinta e arrivo per il grezzo che
	                // sta per entrare. Stesso schema dello stato 32 di Part_Robot_to_MC,
	                // compresa la terza colonna Z_PUSH_DROP (6/10, vedi 1412).
	                // (35) isnull sulle quote: vedi la nota al 32 di Part_Robot_to_MC.
	                IF #MCRequested <> 1 THEN
	                    #Dispatcher["_master"] := 1414;          // MC2 non esiste: nessuna spinta
	                ELSIF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF "DB_MC1".order.ID > 0 THEN
	                        #queryTemp := CONCAT(IN1 := 'select isnull(X_PUSH,0),isnull(X_STOP,0),Z_PUSH_DROP from COORDINATES_PUSH_MC where MC=1 and ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                    ELSE
	                        #queryTemp := 'select top 1 isnull(X_PUSH,0),isnull(X_STOP,0),Z_PUSH_DROP from COORDINATES_PUSH_MC where MC=1 order by ORDER_ID desc';
	                    END_IF;
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_master"] := 1411;
	                END_IF;
	                
	            1411: // presa in carico VERIFICATA della query spinta
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_master"] := 1412;
	                END_IF;
	                
	            1412: // esito spinta con CONTROLLO DI PLAUSIBILITA'.
	                // Il ponte SQL NON converte NULL in zero: restituisce valori
	                // casuali (visto 15/9: -1.056.960.259 con PUSH_STATUS DISABLED).
	                // Il riferimento e' la quota di DEPOSITO congelata.
	                // QUOTA Z DELLA SPINTA (6/10): come al 36 di Part_Robot_to_MC, con la
	                // Z di deposito congelata al 1402 (#zPlaceTemp, Z_PLACE_MC).
	                IF "DB_executeQuery".dataReady THEN
	                    IF "DB_executeQuery".noData OR "DB_executeQuery".dataError THEN
	                        #xPushTemp := 0;
	                        #xStopTemp := 0;
	                        "FC_Split_Dint"(IN := #zPlaceTemp,
	                                        HIGH_Word => "Z_Push_HIGH",
	                                        LOW_Word => "Z_Push_LOW");
	                    ELSE
	                        #xPushTemp := "SqlData".data.rows[0].col[0];
	                        #xStopTemp := "SqlData".data.rows[0].col[1];
	                        
	                        // (35) stessa plausibilita' del 36 di Part_Robot_to_MC
	                        IF ABS(DINT_TO_LINT(#xPushTemp) - DINT_TO_LINT(#xPlaceTemp)) > 500000
	                            OR ABS(DINT_TO_LINT(#xStopTemp) - DINT_TO_LINT(#xPlaceTemp)) > 500000
	                            OR #xStopTemp < #xPushTemp
	                            OR DINT_TO_LINT(#xStopTemp) - DINT_TO_LINT(#xPushTemp) > 200000
	                        THEN
	                            #xPushTemp := 0;
	                            #xStopTemp := 0;
	                        END_IF;
	                        
	                        IF #xPushTemp <> 0 AND #xStopTemp <> 0
	                            AND "SqlData".data.rows[0].col[2] >= 0
	                            AND "SqlData".data.rows[0].col[2] <= 300000
	                        THEN
	                            "FC_Split_Dint"(IN := #zPlaceTemp - "SqlData".data.rows[0].col[2],
	                                            HIGH_Word => "Z_Push_HIGH",
	                                            LOW_Word => "Z_Push_LOW");
	                        ELSE
	                            "FC_Split_Dint"(IN := #zPlaceTemp,
	                                            HIGH_Word => "Z_Push_HIGH",
	                                            LOW_Word => "Z_Push_LOW");
	                        END_IF;
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Dispatcher["_master"] := 1416;
	                END_IF;
	                
	            1416: // SOFFIAGGIO: vedi nota estesa al 37 di Part_Robot_to_MC.
	                // Qui la X di deposito e' xPlaceTemp, congelata al 1402: la
	                // missione ne usa due — prelievo finito e deposito grezzo — e
	                // l'appoggio si calcola sempre su quella di DEPOSITO.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF "DB_MC1".order.ID > 0 THEN
	                        #queryTemp := CONCAT(IN1 := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_master"] := 1417;
	                    ELSE
	                        // MANUALE, nessun ordine attivo (6/10, richiesta di Dario): i dati del
	                        // pezzo arrivano dallo STESSO ordine da cui il 1400 ha preso le quote di
	                        // prelievo e deposito (COORDINATES_PICKPLACE_MC, ORDER_ID decrescente),
	                        // cioe' l'ordine piu' recente: la produzione possibile, anche se non
	                        // e' avviata. Prima qui non si leggeva niente e il robot riceveva i
	                        // valori dell'ultimo giro, anche di un altro pezzo.
	                        // La sottoquery ripete la regola del 1400, cosi' quote e dati del pezzo
	                        // vengono sempre dallo stesso ordine. 187 caratteri, queryTemp ne regge 254.
	                        #queryTemp := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=(select top 1 ORDER_ID from COORDINATES_PICKPLACE_MC order by ORDER_ID desc)';
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_master"] := 1417;
	                    END_IF;
	                END_IF;
	                
	            1417: // presa in carico VERIFICATA
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_master"] := 1418;
	                END_IF;
	                
	            1418: // esito: scrive le cinque variabili PROFINET.
	                // APPOGGIO COME MISURA: vedi nota al 39 di Part_MC_to_Robot.
	                // Qui xPlaceTemp non entra piu': era la quota di deposito, e il
	                // robotista la posizione non la vuole.
	                IF "DB_executeQuery".dataReady THEN
	                    IF NOT "DB_executeQuery".noData AND NOT "DB_executeQuery".dataError THEN
	                        "Vice_ClawLength_mm" := DINT_TO_INT("SqlData".data.rows[0].col[0] / 1000);
	                        "Part_Width_mm" := DINT_TO_INT("SqlData".data.rows[0].col[3] / 1000);
	                        "X_Support_mm" := DINT_TO_INT(("SqlData".data.rows[0].col[0] / 2
	                                                                                    + "SqlData".data.rows[0].col[2]) / 1000);
	                        // DATI PEZZO PER IL ROBOT (5/10, richiesta del robotista): lunghezza
	                        // e altezza del pezzo dell'ordine, stesso formato e stesso momento
	                        // delle tre qui sopra (mm interi, mai azzerate). Quale colonna di
	                        // PIECE diventa lunghezza e quale altezza lo decide la vista
	                        // COORDINATES_BLOW_MC, non il PLC.
	                        "Part_Length_mm" := DINT_TO_INT("SqlData".data.rows[0].col[1] / 1000);
	                        "Part_Height_mm" := DINT_TO_INT("SqlData".data.rows[0].col[4] / 1000);
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Dispatcher["_master"] := 1414;
	                END_IF;
	                
	            1414: // consenso alla spinta PRIMA del comando, come al 40 di
	                // Part_Robot_to_MC: il robot lo legge quando acquisisce la
	                // missione e sa quante fasi dovra' chiedere.
	                "Q_PushEnable_MC" := (#xPushTemp <> 0) AND (#xStopTemp <> 0);
	                "Ok_PushSpinta_MC" := FALSE;
	                "Ok_PushArrivo_MC" := FALSE;
	                "Ok_Phase2_MC" := FALSE;
	                
	                "DB_RobotMission".Command := "CMD_RobotPickPlaceObject";
	                #Dispatcher["_master"] := 1403;
	                
	            1420: // SPINTA fase 1: il robot ha depositato e chiede la quota di spinta
	                IF "Robot_PushDepositoFatto_MC" THEN
	                    "DB_RobotMission"."X_Pick-Place" := #xPushTemp;
	                    "Ok_PushSpinta_MC" := TRUE;
	                    #Dispatcher["_master"] := 1421;
	                END_IF;
	                
	            1421: // attesa che il robot abbassi il suo bit: ha letto la quota
	                IF NOT "Robot_PushDepositoFatto_MC" THEN
	                    "Ok_PushSpinta_MC" := FALSE;
	                    #Dispatcher["_master"] := 1422;
	                END_IF;
	                
	            1422: // SPINTA fase 2: il robot e' in posizione e chiede la quota di arrivo
	                IF "Robot_PushInPos_MC" THEN
	                    "DB_RobotMission"."X_Pick-Place" := #xStopTemp;
	                    "Ok_PushArrivo_MC" := TRUE;
	                    #Dispatcher["_master"] := 1423;
	                END_IF;
	                
	            1423: // attesa che il robot abbassi il suo bit: ha letto la quota
	                IF NOT "Robot_PushInPos_MC" THEN
	                    "Ok_PushArrivo_MC" := FALSE;
	                    #Dispatcher["_master"] := 1405;
	                END_IF;
	                
	            1510:
	                #Dispatcher["_Pallet_Robot_to_TRAY"] := 10;
	                #Dispatcher["_master"] := 1520;
	                
	            1520:
	                IF #Dispatcher["_Pallet_Robot_to_TRAY"] = 0 THEN
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1600: apertura chela lato 1 (HMI)
	            1600:
	                "DB_RobotMission".Gripper_Side := 1;
	                "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                "DB_RobotMission".Command := "CMD_RobotOpenGripper1";
	                #Dispatcher["_master"] := 1601;
	            1601:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1602;
	                ELSIF "DB_RobotMissionStatus".StatusCode = "cmd_rejected" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_aborted" THEN
	                    // il robot non ha accettato: chiudi invece di restare appeso
	                    "DB_RobotMission".Command := 0;
	                    #Error := 22;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1602:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    // aprire = rilasciare: il lato torna vuoto
	                    #GripperOccuped[1] := FALSE;
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("EMPTY");
	                    #Dispatcher["_master"] := 1603;
	                END_IF;
	            1603:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1620: chiusura chela lato 1 (HMI)
	            1620:
	                "DB_RobotMission".Gripper_Side := 1;
	                "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                "DB_RobotMission".Command := "CMD_RobotCloseGripper1";
	                #Dispatcher["_master"] := 1621;
	            1621:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1622;
	                END_IF;
	            1622:
	                // chiudere NON implica aver preso: il contenuto resta quello
	                // dichiarato, si aggiorna solo con il comando 35
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1640: apertura chela lato 2 (HMI)
	            1640:
	                "DB_RobotMission".Gripper_Side := 2;
	                "DB_RobotMission".Gripper_code := #Gripper_ID[2];
	                "DB_RobotMission".Command := "CMD_RobotOpenGripper2";
	                #Dispatcher["_master"] := 1641;
	            1641:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1642;
	                END_IF;
	            1642:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    #GripperOccuped[2] := FALSE;
	                    #Dispatcher["updatePartOnRobot"] := 20 + DINT_TO_INT("EMPTY");
	                    #Dispatcher["_master"] := 1643;
	                END_IF;
	            1643:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                
	                ///////////// 1660: chiusura chela lato 2 (HMI)
	            1660:
	                "DB_RobotMission".Gripper_Side := 2;
	                "DB_RobotMission".Gripper_code := #Gripper_ID[2];
	                "DB_RobotMission".Command := "CMD_RobotCloseGripper2";
	                #Dispatcher["_master"] := 1661;
	            1661:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1662;
	                END_IF;
	            1662:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                ///////////// 1700: posizionamento davanti a MC1 (automatico)
	                // Il robot si porta in attesa e la missione chiude: restera' fermo
	                // li' perche' FB204 non assegna nulla finche' la porta non si apre.
	            1700:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1701;
	                ELSIF "DB_RobotMissionStatus".StatusCode = "cmd_rejected" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_aborted" THEN
	                    "DB_RobotMission".Command := 0;
	                    #Error := "MISSION_PositioningMC_AUTO" * 100 + 22;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1701:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	                ///////////// 1750: ritorno in home (automatico)
	                // Stessa struttura del 1700: attesa acquisizione con gestione del
	                // rifiuto, poi attesa esecuzione. Il robot ci va e resta li'.
	            1750:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_master"] := 1751;
	                ELSIF "DB_RobotMissionStatus".StatusCode = "cmd_rejected" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_aborted" THEN
	                    // il robot non ha accettato: si chiude comunque. Il home e' una
	                    // rifinitura, non deve fermare la cella se fallisce.
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	            1751:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;
	                    #MissionCode := 0;
	                    #Dispatcher["_master"] := 0;
	                END_IF;
	        END_CASE;
	    END_IF;
	    
	END_REGION
	
	REGION Gripper_MANAGER
	    REGION Gripper_Robot_to_TRAY
	        CASE #Dispatcher["_Gripper_Robot_to_TRAY"] OF
	            0:  //nothing to do
	                ;
	            10:  //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                        #Error := 949;
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 0;
	                    ELSIF "DB_BOX_1".ExtractedTray > 0
	                        OR #Dispatcher["Extract_TRAY"] > 0 OR #Dispatcher["Release_TRAY"] > 0
	                        OR "I_OUT_TRAY1" OR "I_OUT_TRAY2" OR "I_OUT_TRAY3" OR "I_OUT_TRAY4"
	                        OR "I_OUT_TRAY5" OR "I_OUT_TRAY6" OR "I_OUT_TRAY7" OR "I_OUT_TRAY8"
	                        OR "I_OUT_TRAY9" OR "I_OUT_TRAY10" OR "I_OUT_TRAY11" OR "I_OUT_TRAY12"
	                    THEN
	                        // CASSETTO FUORI = PINZA FERMA (7/10, decisione di Dario): con un
	                        // cassetto aperto il robot che va allo scaffale pinze rischia l'urto.
	                        // Registro E sensori di cassetto fuori (I_OUT_TRAYn, gli stessi di
	                        // FB_easyBox), piu' le catene di estrazione e rilascio. Un cassetto a
	                        // meta' corsa non lo vede nessuno: AllTrayInside non e' cablato.
	                        // Stessa uscita del 949: la catena si chiude senza scaricare.
	                        // Chi l'ha lanciata si ferma con l'errore alzato (il 700 chiude
	                        // la missione, gli altri master restano in attesa come col 949):
	                        // si esce col RESET, dopo aver chiuso il cassetto.
	                        #Error := 1519;
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 0;
	                    ELSE
	                        #queryTemp := CONCAT(IN1 := 'SELECT X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_GRIPPER_SHELF where id=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]));
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["_Gripper_Robot_to_TRAY"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20:  // wait for result DB -> prepare mission data 
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbe lo SLOT A SCAFFALE dove posare
	                // la pinza.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 25;
	                END_IF;
	                
	            25: //execute query
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // slot di casa della pinza non trovato a scaffale: con FB6
	                    // corretto "zero righe" non e' piu' dataError, va preso qui.
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 990;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    "DB_RobotMission".Command := "CMD_RobotRemoveGripper";
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[0];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[7];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Gripper";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 30;
	                ELSIF "DB_executeQuery".dataError THEN
	                    // Alarm
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 990;
	                END_IF;
	            30:  // start robot mission
	                //"DB_RobotMission".Command := "CMD_RobotRemoveGripper";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 40;
	                END_IF;
	            40:  // finished -> update DB
	                // DOPPIA CONFERMA (5/9), simmetrica a quella del carico allo
	                // stato 50 di Gripper_TRAY_to_Robot: non basta cmd_executed del
	                // robot, serve anche che il sensore NON veda piu' la pinza.
	                // Senza, i registri direbbero "flangia nuda" con la pinza ancora
	                // attaccata, e ogni scelta successiva partirebbe da un dato falso.
	                // Stallo qui = guardare %I502.0.
	                // NB: lo scarico NON passa dalla catena unica — azzerare i registri
	                // e' un gesto che non ha bisogno di cercare gemelle, e #GripperRequested
	                // deve restare intatto per il carico che i rami 110/210/310/410/510
	                // lanciano subito dopo.
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed"
	                    AND NOT "Gripper_mounted"
	                THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #Gripper_ID[1] := 0;
	                    #Gripper_ID[2] := 0;
	                    #Dispatcher["updateGripperOnRobot"] := 10;
	                    
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 50;
	                END_IF;
	            50: // attesa fine update DB -> chiusura catena scarico
	                IF #Dispatcher["updateGripperOnRobot"] = 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 0;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Gripper_TRAY_to_Robot
	        CASE #Dispatcher["_Gripper_TRAY_to_Robot"] OF
	            0: // nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                        #Error := 949;
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                    ELSIF "DB_BOX_1".ExtractedTray > 0
	                        OR #Dispatcher["Extract_TRAY"] > 0 OR #Dispatcher["Release_TRAY"] > 0
	                        OR "I_OUT_TRAY1" OR "I_OUT_TRAY2" OR "I_OUT_TRAY3" OR "I_OUT_TRAY4"
	                        OR "I_OUT_TRAY5" OR "I_OUT_TRAY6" OR "I_OUT_TRAY7" OR "I_OUT_TRAY8"
	                        OR "I_OUT_TRAY9" OR "I_OUT_TRAY10" OR "I_OUT_TRAY11" OR "I_OUT_TRAY12"
	                    THEN
	                        // CASSETTO FUORI = PINZA FERMA (7/10, decisione di Dario): con un
	                        // cassetto aperto il robot che va allo scaffale pinze rischia l'urto.
	                        // Registro E sensori di cassetto fuori (I_OUT_TRAYn, gli stessi di
	                        // FB_easyBox), piu' le catene di estrazione e rilascio. Un cassetto a
	                        // meta' corsa non lo vede nessuno: AllTrayInside non e' cablato.
	                        // Stessa uscita del 949: la catena si chiude senza montare la pinza.
	                        // Chi l'ha lanciata si ferma con l'errore alzato (il 700 chiude
	                        // la missione, gli altri master restano in attesa come col 949):
	                        // si esce col RESET, dopo aver chiuso il cassetto.
	                        #Error := 1419;
	                        #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                    ELSE
	                        // SORGENTE UNICA: #GripperRequested (17/9).
	                        // Prima i tre rami leggevano sorgenti diverse — GripperRequested
	                        // per il magazzino, order.GRIPPER per MC1, order.GRIPPER di MC1
	                        // anche nel ramo MC2 (refuso). Nel ciclo automatico i valori
	                        // coincidono perche' i master 100/300/400/500 scrivono
	                        // GripperRequested := order.GRIPPER prima di lanciare, ma
	                        // l'accoppiamento era implicito: la catena cercava a scaffale
	                        // una pinza e la catena unica ne registrava un'altra se le due
	                        // sorgenti divergevano.
	                        // Adesso chi lancia dice QUALE pinza vuole, e questa catena
	                        // la cerca e basta — stessa variabile che _Set_Gripper_OnBoard
	                        // usera' per scrivere i registri.
	                        IF #GripperRequested > 0 THEN
	                            // GEMELLA SOLO CON SUB_POS VALORIZZATO (5/10, concordato 1/9): una pinza
	                            // singola ha SUB_POS = 0, e "SUB_POS in (0)" tirava dentro tutte le altre
	                            // pinze singole a scaffale come se fossero il suo lato 2.
	                            #queryTemp := CONCAT_STRING(IN1 := 'select X,Y,Z,X_rot,Y_rot,Z_ROT, APPROACH_TYPE, APPROACH_X, APPROACH_Y, APPROACH_Z, ID from COORDINATES_GRIPPER_SHELF where id=',
	                                                        IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#GripperRequested),
	                                                        IN3 := ' OR (SUB_POS>0 AND SUB_POS in (select sub_pos from COORDINATES_GRIPPER_SHELF where id=',
	                                                        IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#GripperRequested),
	                                                        IN5 := ')) order by gripper_sub_pos');
	                            #queryStartExecution := TRUE;
	                            #Dispatcher["_Gripper_TRAY_to_Robot"] := 20;
	                        ELSE
	                            // nessuna pinza richiesta: senza questa guardia la query
	                            // usciva con id=0, zero righe e 990 — lo stesso difetto
	                            // che il 17/9 ha tenuto appeso il master ai rami 1xx.
	                            #Error := 937;   // pinza target non valida
	                            #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbe lo SLOT della pinza da prendere.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 30;
	                END_IF;
	                
	            30: // wait anwser
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // pinza richiesta non trovata a scaffale. Ramo NUOVO: prima
	                    // non esisteva, e con FB6 corretto la catena proseguirebbe
	                    // con coordinate a zero mandando il robot a sbattere.
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[0];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[7];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "Gripper";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_code := DINT_TO_INT(#GripperRequested);
	                    //"DB_RobotMission".Option
	                    
	                    // LATO 2 NON PIU' QUI (17/9): lo scrive la catena
	                    // _Set_Gripper_OnBoard, che e' il punto unico. Questo stato
	                    // leggeva le coordinate di prelievo e per comodita' anche la
	                    // gemella, ma quella doppia responsabilita' e' proprio il
	                    // motivo per cui lo swap — che non passa di qui — dimenticava
	                    // il lato 2.
	                    
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    // ramo NUOVO: errore vero del ponte
	                    #Error := 990;
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                END_IF;
	                
	            40:  // start Robot mission
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN
	                    "DB_RobotMission".Command := "CMD_RobotPickGripper";
	                    
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 45;
	                END_IF;
	            45:
	                //"DB_RobotMission".Command := "CMD_RobotPickGripper";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 50;
	                END_IF;
	                
	            50: // latch a doppia conferma: esito missione + sensore fisico — stallo qui = guardare %I502.0
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" AND "Gripper_mounted" THEN
	                    
	                    // AZZERAMENTO COMANDO (5/9): senza, il robot resta a
	                    // cmd_executed in attesa che il PLC risponda, e get_TCP_Data
	                    // allo stato 40 aspetta che il robot torni a waitingNewCmd:
	                    // stallo circolare col master fermo al 960.
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    // registri + database alla catena unica (17/9)
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 10;
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 60;
	                END_IF;
	            60: // attesa fine registrazione -> chiusura catena carico
	                IF #Dispatcher["_Set_Gripper_OnBoard"] = 0 THEN
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	                END_IF;
	        END_CASE;
	        
	    END_REGION
	    
	    REGION Gripper_Hook_Search
	        REGION Gripper_Hook_Search
	            // PINZA CON UNCINO PER I CASSETTI (7/10, decisione di Dario). L'uncino e'
	            // fisso su certe pinze e lo dice l'anagrafica: GRIPPER.HAS_HOOK = 1 (in cella
	            // il 7/10: la pinza doppia, righe 26 e 37). Le vecchie righe "gancio" con
	            // SUB_POS > 1000 (15 e 24) hanno HAS_HOOK = 0 e restano fuori.
	            // USCITA: #GripperRequested = la pinza a bordo se ha l'uncino, altrimenti la
	            // prima con uncino a scaffale (POS_PLANT 0; riga canonica, ID minore).
	            // Nessuna: 19006. Fino al 7/10 si cercavano le righe gancio e in
	            // GripperRequested finiva SUB_POS-1000, cioe' 2: una pinza che non esiste.
	            CASE #Dispatcher["_Gripper_Hook_Search"] OF
	                0: // nothing to do
	                    ;
	                10: //prepare mission data
	                    IF "SqlCommands".sqlCommands[0] = '' THEN
	                        #queryTemp := CONCAT(IN1 := 'select top 1 ID from GRIPPER where HAS_HOOK=1 and (ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                             IN3 := ' or POS_PLANT=0) order by case when ID=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                             IN5 := ' then 0 else 1 end, ID');
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Gripper_Hook_Search"] := 20;
	                    END_IF;
	                    
	                20:  //execute query
	                    // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                    // senza il confronto su sqlCommands[0] si legge la risposta di un
	                    // altro richiedente — qui finirebbe in GripperRequested un ID pinza
	                    // preso da una colonna qualsiasi di un'altra query.
	                    IF NOT "DB_executeQuery".readyForNextQuery
	                        AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                        #Dispatcher["_Gripper_Hook_Search"] := 30;
	                    END_IF;
	                    
	                30: // wait anwser
	                    IF "DB_executeQuery".dataReady THEN
	                        IF "DB_executeQuery".noData THEN
	                            #Error := 19006;   // nessuna pinza con uncino, ne' a bordo ne' a scaffale
	                        ELSIF "DB_executeQuery".dataError THEN
	                            #Error := 99;      // errore DB
	                        ELSE
	                            #GripperRequested := DINT_TO_INT("SqlData".data.rows[0].col[0]);
	                        END_IF;
	                        
	                        "DB_executeQuery".readyForNextQuery := true;
	                        #Dispatcher["_Gripper_Hook_Search"] := 0;
	                    END_IF;
	            END_CASE;
	            
	        END_REGION
	        
	    END_REGION
	    
	    REGION Gripper4Pallet_Search
	        CASE #Dispatcher["_Gripper4Pallet_Search"] OF
	            0: // nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT_STRING(IN1 := 'select GRIPPERREQ from pallets_grippers where palletID=',
	                                                IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletRequested));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Gripper4Pallet_Search"] := 20;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui finirebbe in GripperRequested un ID pinza
	                // preso da una colonna qualsiasi di un'altra query.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Gripper4Pallet_Search"] := 30;
	                END_IF;
	                
	            30: // wait anwser
	                IF "DB_executeQuery".dataReady THEN
	                    IF "DB_executeQuery".noData OR "DB_executeQuery".dataError THEN
	                        #Error := "_Gripper4Pallet_Search" * 100 + 22;
	                    ELSE
	                        #GripperRequested := DINT_TO_INT("SqlData".data.rows[0].col[0]);
	                    END_IF;
	                    
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Dispatcher["_Gripper4Pallet_Search"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION Set_Gripper_OnBoard
	        // PUNTO UNICO DI SCRITTURA DEI REGISTRI PINZA (17/9).
	        // Prima Gripper_ID[1] e [2] venivano scritti da piu' percorsi diversi e
	        // ognuno doveva ricordarsi di cercare la gemella: lo swap non lo faceva,
	        // e siccome il 35 di FB204 cambia pinza SEMPRE via swap, in automatico il
	        // lato 2 restava a zero e la pinza doppia veniva usata come singola.
	        // Da qui in poi chi monta una pinza scrive #GripperRequested e lancia
	        // questa catena: la gemella la cerca lei, i registri li scrive lei, il
	        // database lo allinea lei.
	        //
	        // INGRESSO:  #GripperRequested = ID pinza a bordo, 0 = flangia nuda
	        // USCITA:    Gripper_ID[1], Gripper_ID[2], POS_PLANT a database
	        //
	        // La query e' sulla TABELLA GRIPPER, non sulla vista dello scaffale:
	        // la vista puo' non contenere una pinza gia' registrata a bordo.
	        CASE #Dispatcher["_Set_Gripper_OnBoard"] OF
	            0: // nothing to do
	                ;
	                
	            10: // flangia nuda oppure ricerca gemella
	                IF #GripperRequested <= 0 THEN
	                    #Gripper_ID[1] := 0;
	                    #Gripper_ID[2] := 0;
	                    #Dispatcher["updateGripperOnRobot"] := 10;
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 50;
	                ELSIF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'select ID from GRIPPER where ID=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#GripperRequested),
	                                         IN3 := ' or (SUB_POS>0 and SUB_POS in (select SUB_POS from GRIPPER where ID=',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#GripperRequested),
	                                         IN5 := '))');
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 20;
	                END_IF;
	                
	            20: // presa in carico VERIFICATA
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 30;
	                END_IF;
	                
	            30: // esito: due righe = pinza doppia, la gemella e' il lato 2.
	                // La query include se stessa, quindi una riga sola significa
	                // pinza singola. Su errore o zero righe NON si alza allarme: la
	                // pinza e' fisicamente a bordo e il ciclo deve poter proseguire
	                // come singola — che e' il comportamento storico.
	                IF "DB_executeQuery".dataReady THEN
	                    #Gripper_ID[1] := #GripperRequested;
	                    #Gripper_ID[2] := 0;
	                    
	                    IF NOT "DB_executeQuery".noData
	                        AND NOT "DB_executeQuery".dataError
	                        AND "SqlData".data.rowCount > 1
	                    THEN
	                        IF DINT_TO_INT("SqlData".data.rows[0].col[0]) <> #GripperRequested THEN
	                            #Gripper_ID[2] := DINT_TO_INT("SqlData".data.rows[0].col[0]);
	                        ELSE
	                            #Gripper_ID[2] := DINT_TO_INT("SqlData".data.rows[1].col[0]);
	                        END_IF;
	                    END_IF;
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    
	                    #Dispatcher["updateGripperOnRobot"] := 10;
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 50;
	                END_IF;
	                
	            50: // allineamento database chiuso
	                IF #Dispatcher["updateGripperOnRobot"] = 0 THEN
	                    #Dispatcher["_Set_Gripper_OnBoard"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	END_REGION
	
	REGION PALLETS_MANAGER
	    REGION Pallet_Tray_to_Robot
	        CASE #Dispatcher["_Pallet_TRAY_to_Robot"] OF
	            0: //nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #GripperOccuped[1] THEN
	                        //gripper occupata
	                        #Error := 21;
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := 0;
	                    ELSIF #MCRequested = 1 AND "DB_MC1".order.ID <= 0 THEN
	                        #Error := "_Pallet_TRAY_to_Robot" * 1000 + 1;  //Error 1001
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := "_Pallet_TRAY_to_Robot" * 1000 + 1;
	                    ELSIF #MCRequested = 2 AND "DB_MC2".order.ID <= 0 THEN
	                        #Error := "_Pallet_TRAY_to_Robot" * 1000 + 2;  //Erroe 1002
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := "_Pallet_TRAY_to_Robot" * 1000 + 2;
	                    ELSIF #RemoteMode AND #MCRequested = 1 THEN
	                        #queryTemp := CONCAT(IN1 := 'select * from COORDINATES_FOR_PALLET_WAREHOUSE  where status=4 and palletID = ',  //Order_ID
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := 20;
	                    ELSIF #RemoteMode AND #MCRequested = 2 THEN
	                        #queryTemp := CONCAT(IN1 := 'select * from COORDINATES_FOR_PALLET_WAREHOUSE  where status=4 and PalletID = ',  //Order_ID
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PALLET)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := 20;
	                    ELSIF NOT #RemoteMode AND #MCRequested = 0 THEN  //COMMAND FROM HMI
	                        #queryTemp := CONCAT(IN1 := 'select * from COORDINATES_FOR_PALLET_WAREHOUSE where POS= ',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT(#PalletPosition)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_TRAY_to_Robot"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le COORDINATE del pallet a
	                // magazzino, comprese le rotazioni di approccio.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // nessun pallet pronto: con FB6 corretto "zero righe" non e'
	                    // piu' dataError, va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Error := "_Pallet_TRAY_to_Robot" * 1000 + 10;  //Error 1010
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := "_Pallet_TRAY_to_Robot" * 1000 + 10;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".XRot_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".YRot_approach := ("SqlData".data.rows[0].col[10]);
	                    "DB_RobotMission".ZRot_approach := ("SqlData".data.rows[0].col[11]);
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[12]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[12], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "Pallet";
	                    "DB_RobotMission".Unit_code := "WarehousePallet";
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_RobotMission".Gripper_Side := 1;
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Error := "_Pallet_TRAY_to_Robot" * 1000 + 10;  //Error 1010
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := "_Pallet_TRAY_to_Robot" * 1000 + 10;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPickObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #GripperOccuped[1] := TRUE;
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("RAW");  //il pallet lo considero grezzo cosi va in macchina
	                    
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 60;
	                END_IF;
	            60:  // updateDB
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePalletOnTRAY"] := 10 + DINT_TO_INT("EMPTY");
	                    
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePalletOnTRAY"] = 0 THEN
	                    #Dispatcher["_Pallet_TRAY_to_Robot"] := 0;
	                END_IF;
	                
	                // ==== ERRORS 1xxx ====
	            1001:
	                ; //WorkOrder not defined for MC1
	            1002:
	                ; //WorkOrder not defined for MC2
	            1010:
	                ; //No pallets ready for work
	                // ==== ERRORS 1xxx ====    
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Pallet_Robot_to_Tray
	        CASE #Dispatcher["_Pallet_Robot_to_TRAY"] OF
	            0: //nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #GripperOccuped[1] AND "Gripper1_Closed" THEN   //non usare direttamente Ingresso
	                        //gripper empty
	                        #Error := 2021;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 2021;
	                    ELSIF #MCRequested = 1 AND "DB_MC1".order.ID <= 0 THEN
	                        #Error := 2001;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 2001;
	                    ELSIF #MCRequested = 2 AND "DB_MC2".order.ID <= 0 THEN
	                        #Error := 2002;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 2002;
	                    ELSIF #MCRequested = 1 THEN
	                        #queryTemp := CONCAT(IN1 := 'select * from COORDINATES_FOR_PALLET_WAREHOUSE where PalletID = ',  //Order_ID
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)),
	                                             IN3 := ' AND Status=2');
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 20;
	                    ELSIF #MCRequested = 2 THEN
	                        #queryTemp := CONCAT(IN1 := 'select * from COORDINATES_FOR_PALLET_WAREHOUSE where PalletID = ',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PALLET)),
	                                             IN3 := ' AND Status=2');
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 20;
	                    ELSIF #MCRequested = 0 THEN     //HMI COMMAND
	                        // VISTA NUOVA (16/9): COORDINATES_FOR_PALLET_WAREHOUSE e' un
	                        // join implicito fra POSITION e PALLET su sub_pos = MAG_POS,
	                        // quindi restituisce SOLO i posti gia' occupati — le venti
	                        // posizioni libere non ci sono per costruzione, e il deposito
	                        // in un posto vuoto dava 2005 (visto 16/9).
	                        // Il join non era un errore: la Y dipende dalle misure del
	                        // pallet (Y/2, Y_CORR, Y_HandlePoint), quindi una posizione
	                        // senza pallet non ha coordinate calcolabili. Serviva la
	                        // combinazione POSTO x PALLET, che e' COORDINATES_FOR_PALLET_PLACE:
	                        // stesso calcolo, CROSS JOIN, filtrata sui due parametri.
	                        // Verificato che sul posto 10 col pallet 9 le due viste danno
	                        // le stesse identiche coordinate.
	                        #queryTemp := CONCAT(IN1 := 'select X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_X,APPROACH_Y,APPROACH_Z,APPROACH_X_ROT,APPROACH_Y_ROT,APPROACH_Z_ROT,APPROACH_TYPE from COORDINATES_FOR_PALLET_PLACE where POS=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT(#PalletPosition)),
	                                             IN3 := ' and PalletID=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletRequested));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Pallet_Robot_to_TRAY"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le COORDINATE di deposito del
	                // pallet a magazzino.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // posizione di deposito pallet non trovata: con FB6 corretto
	                    // "zero righe" non e' piu' dataError, va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Error := 2005;
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 2005;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".XRot_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".YRot_approach := ("SqlData".data.rows[0].col[10]);
	                    "DB_RobotMission".ZRot_approach := ("SqlData".data.rows[0].col[11]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[12], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Pallet";
	                    "DB_RobotMission".Unit_code := "WarehousePallet";
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Error := 2005;
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 2005;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPlaceObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #GripperOccuped[1] := FALSE;
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("EMPTY");
	                    
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 60;
	                END_IF;
	            60:  // updateDB
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePalletOnTRAY"] := 10 + DINT_TO_INT("RAW");
	                    
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePalletOnTRAY"] = 0 THEN
	                    #Dispatcher["_Pallet_Robot_to_TRAY"] := 0;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Pallet_Robot_to_MC
	        CASE #Dispatcher["_Pallet_Robot_to_MC"] OF
	            0: //nothing to do
	                ;
	                
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #GripperOccuped[1] AND NOT #GripperOccuped[2] THEN
	                        //gripper vuota
	                        #Error := 22;
	                        #Dispatcher["_Pallet_Robot_to_MC"] := 3022;
	                    ELSE
	                        IF NOT #RemoteMode THEN
	                            #pieceReq := #PalletRequested;   // comando manuale: pallet dal pannello
	                            IF #pieceReq = 0 THEN
	                                #Error := 936;               // nessun pallet indicato nel comando
	                            END_IF;
	                        ELSE
	                            IF #MCRequested = 1 THEN
	                                #pieceReq := DINT_TO_INT("DB_MC1".order.PALLET);
	                            ELSIF #MCRequested = 2 THEN
	                                #pieceReq := DINT_TO_INT("DB_MC2".order.PALLET);
	                            ELSE
	                                #Error := 936;
	                            END_IF;
	                        END_IF;
	                        
	                        IF #Error = 0 THEN
	                            #queryTemp := CONCAT(IN1 := 'select X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_X,APPROACH_Y,APPROACH_Z,APPROACH_X_ROT, APPROACH_Y_ROT, APPROACH_Z_ROT, APPROACH_TYPE from COORDINATES_MC_FOR_PALLET where parent like $'MC_',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#MCRequested),
	                                                 IN3 := '_pallet%$' AND SUB_POS=1 AND PalletId=',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#pieceReq));
	                            #queryStartExecution := true;
	                            #Dispatcher["_Pallet_Robot_to_MC"] := 20;
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le COORDINATE di deposito del
	                // pallet IN MACCHINA.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // posizione pallet in macchina non trovata: con FB6 corretto
	                    // "zero righe" non e' piu' dataError, va intercettato qui.
	                    #Error := 3005;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 3005;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".XRot_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".YRot_approach := ("SqlData".data.rows[0].col[10]);
	                    "DB_RobotMission".ZRot_approach := ("SqlData".data.rows[0].col[11]);
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[12]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[12], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Pallet";
	                    "DB_RobotMission".Unit_code := 10 + #MCRequested; //MC1-4 -> 11-14
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_RobotMission".Gripper_Side := 1;
	                    //"DB_RobotMission".Option
	                    //
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    //Errore
	                    #Error := 3005;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 3005;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPlaceObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    IF "DB_RobotMission".Gripper_Side = 2 THEN
	                        #GripperOccuped[2] := FALSE;
	                    ELSE
	                        #GripperOccuped[1] := FALSE;
	                    END_IF;
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("EMPTY");
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 60;
	                END_IF;
	                
	            60:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnMC"] := 20 + DINT_TO_INT("RAW");
	                    
	                    // IL REGISTRO DELLA MACCHINA VA SCRITTO (17/9): simmetrico
	                    // all'azzeramento nel 60 di Pallet_MC_to_Robot. Il pallet e'
	                    // appena entrato; in automatico il 30 substate 2 di FB204 lo
	                    // scrive gia', ma sui comandi MANUALI dal pannello nessuno lo
	                    // faceva e il registro restava a zero.
	                    // (7/10) IL PALLET SI RICALCOLA QUI. pieceReq e' una variabile
	                    // TEMP: la calcolava il 10, in un altro ciclo, e qui non conteneva
	                    // piu' il pallet comandato (0 o un residuo). Dopo un deposito manuale
	                    // il registro della macchina restava sbagliato (simulazione 7/10,
	                    // problema 2). La regola e' quella del 10, ma il manuale si
	                    // riconosce dal master (1350 = comando dal pannello) invece che da
	                    // RemoteMode: un HOLD messo o tolto a meta' missione non cambia il
	                    // pallet che il robot ha davvero portato in macchina.
	                    IF #Dispatcher["_master"] = 1350 THEN
	                        #pieceReq := #PalletRequested;
	                    ELSIF #MCRequested = 2 THEN
	                        #pieceReq := DINT_TO_INT("DB_MC2".order.PALLET);
	                    ELSE
	                        #pieceReq := DINT_TO_INT("DB_MC1".order.PALLET);
	                    END_IF;
	                    IF #MCRequested = 1 THEN
	                        "DB_MC1".pallet := #pieceReq;
	                    ELSIF #MCRequested = 2 THEN
	                        "DB_MC2".pallet := #pieceReq;
	                    END_IF;
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 70;
	                END_IF;
	                
	            70:
	                IF #Dispatcher["updatePartOnMC"] = 0 THEN
	                    
	                    #Dispatcher["_Pallet_Robot_to_MC"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION Pallet_MC_to_Robot
	        CASE #Dispatcher["_Pallet_MC_to_Robot"] OF
	            0: //nothing to do
	                ;
	                
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #GripperOccuped[1] THEN
	                        #Error := 4022;
	                        #Dispatcher["_Pallet_MC_to_Robot"] := 4022;
	                    ELSIF NOT #RemoteMode THEN   // HMI: pallet esplicito
	                        IF #PalletRequested = 0 THEN
	                            #Error := 936;   // nessun pallet indicato nel comando
	                        ELSE
	                            #queryTemp := CONCAT(IN1 := 'select X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_X,APPROACH_Y,APPROACH_Z,APPROACH_X_ROT, APPROACH_Y_ROT, APPROACH_Z_ROT, APPROACH_TYPE from COORDINATES_MC_FOR_PALLET where parent like $'MC_',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#MCRequested),
	                                                 IN3 := '_pallet%$' AND SUB_POS=1 AND PalletID=',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletRequested));
	                            #queryStartExecution := TRUE;
	                            #Dispatcher["_Pallet_MC_to_Robot"] := 20;
	                        END_IF;
	                    ELSE
	                        #queryTemp := CONCAT(IN1 := 'select X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_X,APPROACH_Y,APPROACH_Z,APPROACH_X_ROT, APPROACH_Y_ROT, APPROACH_Z_ROT, APPROACH_TYPE from COORDINATES_MC_FOR_PALLET where parent like $'MC_',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#MCRequested),
	                                             IN3 := '_pallet%$' AND SUB_POS=1 AND PalletID=');
	                        IF #MCRequested = 1 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)));
	                        ELSE
	                            #Error := 936;
	                        END_IF;
	                        
	                        IF #Error = 0 THEN
	                            #queryStartExecution := true;
	                            #Dispatcher["_Pallet_MC_to_Robot"] := 20;
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le COORDINATE di prelievo del
	                // pallet DALLA MACCHINA.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // posizione pallet in macchina non trovata: con FB6 corretto
	                    // "zero righe" non e' piu' dataError, va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Error := 4099;
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 4099;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".XRot_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".YRot_approach := ("SqlData".data.rows[0].col[10]);
	                    "DB_RobotMission".ZRot_approach := ("SqlData".data.rows[0].col[11]);
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[12]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[12], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Pallet";
	                    "DB_RobotMission".Unit_code := 10 + #MCRequested; //MC1-4 -> 11-14
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_RobotMission".Gripper_Side := 1;
	                    //"DB_RobotMission".Option
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    //Errore
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Error := 4099;
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 4099;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPickObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    IF "DB_RobotMission".Gripper_Side = 2 THEN
	                        #GripperOccuped[2] := TRUE;
	                    ELSE
	                        #GripperOccuped[1] := TRUE;
	                    END_IF;
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    // RAW, NON LOADED (18/9): il prelievo pallet dal magazzino
	                    // scrive RAW ("il pallet lo considero grezzo cosi' va in
	                    // macchina", 50 di Pallet_TRAY_to_Robot) e su quel valore sono
	                    // costruite le viste e i filtri del ciclo, che cercano STATUS=4.
	                    // Con LOADED=1 la riga a DB diceva uno stato che nessuno
	                    // interroga: il pallet in pinza risultava invisibile.
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("RAW");
	                    
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 60;
	                END_IF;
	            60:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnMC"] := 30 + DINT_TO_INT("EMPTY");
	                    
	                    // IL PEZZO SI AZZERA SUBITO (18/9): senza il pallet in macchina
	                    // non c'e' niente che possa trattenere un pezzo — qualunque cosa
	                    // dica piecepresent, li' dentro e' vuoto. Visto in campo: pallet
	                    // smontato e registro ancora a 1033, il 50 di FB204 ha concluso
	                    // che c'era un finito da prelevare.
	                    IF #MCRequested = 1 THEN
	                        "DB_MC1".piecepresent[1] := 0;
	                    END_IF;
	                    
	                    // IL PALLET NO: il ramo 31..35 di updatePartOnMC lo legge per
	                    // sapere QUALE riga aggiornare a POS_PLANT=1000, e gira in una
	                    // REGION successiva dello stesso scan. Azzerarlo qui gli
	                    // toglierebbe il dato sotto i piedi. Si azzera al 70, a catena
	                    // chiusa.
	                    
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePartOnMC"] = 0 THEN
	                    // ADESSO il registro puo' cadere: la query lo ha gia' letto e
	                    // il database sa che il pallet e' a bordo.
	                    // IL REGISTRO DELLA MACCHINA VA AZZERATO (16/9): il pallet e'
	                    // appena uscito, ma DB_MC1.pallet restava al valore dichiarato.
	                    // Il 30 di FB204 confronta order.PALLET con quel registro per
	                    // decidere se montare il pallet: con il registro che mente,
	                    // saltava il montaggio e passava al check pinza chiedendo la
	                    // pinza del PEZZO.
	                    IF #MCRequested = 1 THEN
	                        "DB_MC1".pallet := 0;
	                    ELSIF #MCRequested = 2 THEN
	                        "DB_MC2".pallet := 0;
	                    END_IF;
	                    
	                    #Dispatcher["_Pallet_MC_to_Robot"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	END_REGION
	
	
	REGION PARTS_MANAGER
	    //abbasso velocita se ho i cassetti aperti? TODO
	    REGION Part_TRAY_to_Robot
	        CASE #Dispatcher["_Part_TRAY_to_Robot"] OF
	            0: //nothing to do
	                ;
	                
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    // Il magazzino deve essere abilitato: porta operatore chiusa e
	                    // registro cassetto coerente con i sensori. Senza questa guardia
	                    // la catena si fida di ExtractedTray, che e' Retain e puo' mentire.
	                    IF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                        #Error := 949;
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 0;
	                    ELSIF #GripperOccuped[1] THEN
	                        //gripper not empty
	                        #Error := "_Part_TRAY_to_Robot" * 100 + 21;     //error 521
	                        #Dispatcher["_Part_TRAY_to_Robot"] := "_Part_TRAY_to_Robot" * 100 + 21;
	                    ELSIF NOT #RemoteMode AND #MCRequested = 0 THEN   // HMI: pezzo esplicito nel cassetto estratto
	                        #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z,cast(TRAY as int) from COORDINATES_PIECES_TRAYS_4Robot where TRAY = $'',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                             IN3 := '$' AND SUB_POS=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 20;
	                    ELSE
	                        // AUTOMATICO: SUB_POS in coda (col[11]) per congelare la tasca,
	                        // cosi' il finito potra' tornare esattamente da dove e' uscito.
	                        // FILTRO PER TIPO PEZZO (16/9): partType, non order_ID. Il
	                        // magazzino contiene grezzi di un tipo, non grezzi riservati
	                        // a un ordine — cosi' il rifornimento a meta' produzione viene
	                        // visto subito.
	                        // FILTRO SUL CASSETTO ESTRATTO (5/9): il CHECK CASSETTO di
	                        // FB204 (stati 40-46) garantisce che quando si arriva qui il
	                        // cassetto giusto e' gia' fuori.
	                        IF #MCRequested = 1 THEN
	                            #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z,cast(TRAY as int),SUB_POS from COORDINATES_PIECES_TRAYS_4Robot where STATUS=4 AND partType=',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PIECE)),
	                                                 IN3 := ' AND TRAY=$'',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                                 IN5 := '$'');
	                        ELSE
	                            #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z,cast(TRAY as int),SUB_POS from COORDINATES_PIECES_TRAYS_4Robot where STATUS=4 AND partType=',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PIECE)),
	                                                 IN3 := ' AND TRAY=$'',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                                 IN5 := '$'');
	                        END_IF;
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: non basta che il ponte sia occupato,
	                // deve esserci LA NOSTRA query. SqlData e' un buffer unico condiviso
	                // con FB204 e con le altre catene: senza questo confronto si puo'
	                // leggere la risposta di un altro richiedente (3/9: PartProgID
	                // 100000 al posto di 1, coordinate di approccio lette come dati).
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // Nessun pezzo trovato per quest'ordine. Con FB6 corretto
	                    // "zero righe" non e' piu' dataError, quindi va intercettato
	                    // qui: senza, si proseguirebbe con coordinate a zero.
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Error := 991;
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 991;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    IF ("SqlData".data.rows[0].col[10] = "DB_BOX_1".ExtractedTray) THEN
	                        //tray_requested is ready!
	                        "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                        "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                        "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                        "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                        "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                        "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                        "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[7]);
	                        "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[8]);
	                        "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[9]);
	                        "DB_RobotMission".XRot_approach := 0;
	                        "DB_RobotMission".YRot_approach := 0;
	                        "DB_RobotMission".ZRot_approach := 0;
	                        "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := TRUE);
	                        "DB_RobotMission".Object_Type := "Part";
	                        "DB_RobotMission".Unit_code := "Warehouse1";
	                        "DB_RobotMission".Gripper_Side := 1;
	                        "DB_RobotMission".Gripper_code := #GripperRequested;
	                        
	                        // congelo la tasca: il finito dovra' tornare qui
	                        IF #RemoteMode OR #MCRequested > 0 THEN
	                            #PartSubPos := DINT_TO_INT("SqlData".data.rows[0].col[11]);
	                        END_IF;
	                        
	                        "DB_executeQuery".readyForNextQuery := true;
	                        
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 40;
	                    ELSE
	                        "DB_executeQuery".readyForNextQuery := true;
	                        #Tray_ID := DINT_TO_INT("SqlData".data.rows[0].col[10]);
	                        "DB_BOX_1".RequestedTray := DINT_TO_INT("SqlData".data.rows[0].col[10]);
	                        
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 100;
	                    END_IF;
	                ELSIF "DB_executeQuery".dataError THEN
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Error := 991;
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 991;
	                END_IF;
	                
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPickObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 50;
	                END_IF;
	                
	            50: // PRELIEVO CONCLUSO: CONFERMA COL SENSORE (16/9).
	                // Gripper1_Closed non dice "chele chiuse": il robot gestisce un
	                // extracorsa e se non ha afferrato niente le riapre. Chiuse =
	                // PEZZO A BORDO. Finora la catena si fidava del solo cmd_executed
	                // e scriveva "grezzo prelevato" su un prelievo che poteva non
	                // essere avvenuto — poi tutto il ciclo proseguiva su quel dato.
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    IF "Gripper1_Closed" THEN
	                        // preso davvero
	                        #retryPick := FALSE;
	                        #GripperOccuped[1] := TRUE;
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("RAW");
	                        
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 60;
	                        
	                    ELSIF NOT #retryPick THEN
	                        // PRIMO FALLIMENTO: la tasca era vuota. Lo dico al database
	                        // — e' la verita', li' non c'era niente — e rilancio dal 10.
	                        // La query rifara' la ricerca e trovera' la PROSSIMA tasca
	                        // grezza dello stesso cassetto, senza bisogno di una query
	                        // diversa: marcare la tasca corregge il magazzino E fa
	                        // avanzare la scelta, con un gesto solo.
	                        #retryPick := TRUE;
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 55;
	                        
	                    ELSE
	                        // SECONDO FALLIMENTO CONSECUTIVO: non e' una tasca vuota,
	                        // e' un problema. Cella in HOLD e allarme, senza muovere il
	                        // robot: la messa in sicurezza la fa l'operatore, che prima
	                        // guarda cosa e' successo.
	                        "DB_RobotMission".Command := 0;  ///\\\
	                        #retryPick := FALSE;
	                        #HOLD := TRUE;
	                        #Error := 992;                    // prelievo cassetto fallito due volte
	                        "DB_MC1".Dispatcher["_master"] := 9999;
	                        #MissionCode := 0;
	                        #Dispatcher["_Part_TRAY_to_Robot"] := 0;
	                    END_IF;
	                END_IF;
	                
	            55: // marca vuota la tasca fallita, poi rilancia il prelievo
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=2 WHERE PARENT=$'TRAY_',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                         IN3 := '$' AND SUB_POS=',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 56;
	                END_IF;
	                
	            56: // presa in carico VERIFICATA
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 57;
	                END_IF;
	                
	            57: // tasca marcata: riparto dal 10, la query trovera' la prossima
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    "FC_MQTT"(insert := true,
	                              send := false,
	                              topic := 'FROM_PLANT/DECLARE/TRAY',
	                              payload := STRING_TO_WSTRING(CONCAT(IN1 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                                                                               IN2 := ';',
	                                                                                               IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos),
	                                                                                               IN4 := ';2')));
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 10;
	                END_IF;
	                
	            60:  // updateDB
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnTray"] := 10 + DINT_TO_INT("EMPTY");
	                    
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePartOnTray"] = 0 THEN
	                    #retryPick := FALSE;
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 0;
	                END_IF;
	                
	            100: //////////////// SPECIAL CONDITION ////////////////
	                //wait the right tray is ready -> restart this mission
	                IF "DB_BOX_1".ExtractedTray = #Tray_ID THEN
	                    #MissionCode := 0;      //da controllare...
	                    
	                    #Dispatcher["_Part_TRAY_to_Robot"] := 10;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Part_Robot_to_TRAY
	        CASE #Dispatcher["_Part_Robot_to_TRAY"] OF
	            0: //nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT "DB_BOX_1".Robot_enabled_to_work THEN
	                        #Error := 949;
	                        #Dispatcher["_Part_Robot_to_TRAY"] := 0;
	                    ELSIF NOT #GripperOccuped[1] AND NOT #GripperOccuped[2] THEN
	                        //gripper EMPTY
	                        #Error := "_Part_Robot_to_TRAY" * 100 + 21;     //error 621
	                        #Dispatcher["_Part_Robot_to_TRAY"] := "_Part_Robot_to_TRAY" * 100 + 21;
	                    ELSE
	                        // (35) SOLO SU UNA TASCA VUOTA A DATABASE (STATUS=2), nei due rami a
	                        // tasca fissa. Prima il deposito non guardava lo stato: dopo
	                        // un'emergenza, un RESTART o un HOLD a meta' deposito il finito
	                        // poteva andare su una tasca gia' piena (problema 4 della prima
	                        // simulazione; 7/10 bis, B42). Adesso zero righe = 691 e il robot
	                        // non si muove: si controlla la tasca e la si dichiara (39).
	                        IF NOT #RemoteMode AND #PartSubPos > 0 THEN   // HMI: posizione esplicita
	                            #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z from COORDINATES_PIECES_TRAYS_4Robot where TRAY = $'',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                                 IN3 := '$' AND SUB_POS=',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos),
	                                                 IN5 := ' AND STATUS=2');
	                        ELSIF NOT #RemoteMode THEN   // HMI: prima vuota — SUB_POS in coda (col[10]) per l'update stati
	                            #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z,SUB_POS from COORDINATES_PIECES_TRAYS_4Robot where TRAY = $'',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                                 IN3 := '$' AND STATUS=2');  //empty
	                        ELSE
	                            // AUTOMATICO: il lato 2 porta il FINITO uscito dalla macchina,
	                            // che torna nella tasca del suo grezzo (PartSubPosMC).
	                            // Il lato 1 porta un grezzo mai entrato: tasca corrente.
	                            IF #GripperOccuped[2] AND #Gripper_ID[2] > 0 THEN
	                                #temp := #PartSubPosMC;
	                            ELSE
	                                #temp := #PartSubPos;
	                            END_IF;
	                            #queryTemp := CONCAT(IN1 := 'select X_PICK,y_PICK,z_PICK,X_ROT,y_rot,Z_ROt,APPROACH_type,APPROACH_x,APPROACH_y,APPROACH_Z from COORDINATES_PIECES_TRAYS_4Robot where TRAY = $'',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                                 IN3 := '$' AND SUB_POS=',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#temp),
	                                                 IN5 := ' AND STATUS=2');
	                        END_IF;
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["_Part_Robot_to_TRAY"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // tasca di destinazione non trovata: con FB6 corretto "zero righe"
	                    // non e' piu' dataError, va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Error := "_Part_Robot_to_TRAY" * 100 + 91;         //Error 691
	                    #Dispatcher["_Part_Robot_to_TRAY"] := "_Part_Robot_to_TRAY" * 100 + 91;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Part";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    IF #Gripper_ID[2] > 0 AND #GripperOccuped[2] THEN
	                        "DB_RobotMission".Gripper_Side := 2;
	                    ELSE
	                        "DB_RobotMission".Gripper_Side := 1;
	                    END_IF;
	                    
	                    //"DB_RobotMission".Option
	                    //#BoxRequested := 
	                    IF NOT #RemoteMode AND #PartSubPos <= 0 THEN
	                        // posizione scelta dalla query "prima vuota": congelata per l'update stati
	                        #PartSubPos := DINT_TO_INT("SqlData".data.rows[0].col[10]);
	                    END_IF;
	                    
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 40;
	                ELSIF "DB_executeQuery".dataError THEN
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    #Error := "_Part_Robot_to_TRAY" * 100 + 91;         //Error 691
	                    #Dispatcher["_Part_Robot_to_TRAY"] := "_Part_Robot_to_TRAY" * 100 + 91;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPlaceObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("EMPTY");
	                    #GripperOccuped["DB_RobotMission".Gripper_Side] := FALSE;
	                    
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 60;
	                END_IF;
	            60:  // updateDB
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnTray"] := 10 + DINT_TO_INT("FINISHED");
	                    
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePartOnTray"] = 0 THEN
	                    #Dispatcher["_Part_Robot_to_TRAY"] := 0;
	                END_IF;
	                
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Part_Robot_to_MC
	        CASE #Dispatcher["_Part_Robot_to_MC"] OF
	            0: //nothing to do
	                ;
	                
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #GripperOccuped[1] AND NOT #GripperOccuped[2] THEN
	                        //gripper empty
	                        #Error := 22;
	                        #Dispatcher["_Part_Robot_to_MC"] := 7001;
	                    ELSIF #Dispatcher["_master"] = 1250 THEN
	                        // DEPOSITO LANCIATO DAL PANNELLO (master 1250). Fino al 7/10 il ramo
	                        // si sceglieva con RemoteMode e DB_MC1.order.ID <= 0, con due difetti
	                        // (simulazione 7/10): un HOLD messo o tolto a meta' missione cambiava
	                        // ramo (problema 13), e FB204 NON azzera order.ID a fine produzione
	                        // (solo col reset errore macchina), quindi dopo un ordine finito il
	                        // deposito manuale prendeva quote, spinta e misure dell'ordine CHIUSO,
	                        // anche di un altro pezzo (problema 3). Stessa regola al 32, al 37 e
	                        // al 50.
	                        // Si usa SEMPRE l'ordine del pezzo prelevato (6/10, decisione di
	                        // Dario), dalla vista MAN_ORDER_MC1: dal 7/10 l'ordine AVVIATO del
	                        // pezzo (STATUS 3) se c'e', altrimenti quello in coda o in pausa
	                        // (STATUS 4 o 6); senza ordine la missione non parte. Il pezzo si
	                        // riconosce dalla tasca di provenienza: cassetto Tray_ID, tasca
	                        // PartSubPos, gli stessi che a fine deposito diventano TrayIdMC e
	                        // PartSubPosMC. La regola sta nella vista MAN_ORDER_MC1. Se l'ordine non
	                        // c'e' la missione non parte (970) e l'operatore lo crea in Produzione
	                        // senza avviarlo. Prima qui si usava l'ordine piu' recente di MC1,
	                        // qualunque fosse il pezzo.
	                        // PROVENIENZA NON NOTA (pezzo messo in pinza a mano e dichiarato, o
	                        // dopo uno STOP->RUN: Tray_ID e PartSubPos non sono ritentivi): l'ordine
	                        // AVVIATO di MC1, letto dal database con la stessa regola di FB204
	                        // (STATUS 3 e PRODUCTED < QUANTITY), non da DB_MC1.order.ID. Fino al
	                        // 7/10 questo caso usava order.ID > 0. Se non c'e', 971 al 12.
	                        IF #Tray_ID <= 0 OR #PartSubPos <= 0 THEN
	                            #queryTemp := 'select top 1 ID from WORKORDERS where MACHINE_ID=1 and STATUS=3 and PRODUCTED<QUANTITY order by ID desc';
	                        ELSE
	                            #queryTemp := CONCAT(IN1 := 'select ORDER_ID from MAN_ORDER_MC1 where TRAY=$'',
	                                                 IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                                 IN3 := '$' and SUB_POS=',
	                                                 IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                        END_IF;
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_Robot_to_MC"] := 11;
	                    ELSE
	                        // QUOTE DALLA VISTA COORDINATES_Z_MC (19/9): il calcolo
	                        // Z era scritto a mano qui, nel 10 di Part_MC_to_Robot e
	                        // dentro COORDINATES_PICKPLACE_MC — tre copie della
	                        // stessa formula, tre occasioni di divergenza.
	                        // E la geometria delle ganasce era INGLOBATA in FIXTURE.Z:
	                        // cambiando le chele il pezzo finiva alla quota delle
	                        // vecchie, 2,3 mm troppo in basso sulla morsa.
	                        // Adesso FIXTURE.Z e' pallet piu' corpo morsa senza chele,
	                        // e la vista aggiunge Z_CLAW - Z_SINK_CLAW.
	                        // Z_PLACE_MC = deposito del GREZZO (qui si deposita).
	                        #queryTemp := 'select P.X,P.Y,Z.Z_PLACE_MC,P.X_ROT,P.Y_ROT,P.Z_ROT,P.APPROACH_TYPE,P.APPROACH_X,P.APPROACH_Y,P.APPROACH_Z from POSITION P,COORDINATES_Z_MC Z where P.PARENT=$'MC_1$' and ';
	                        // (7/10) qui si arriva solo dal ciclo automatico (master 330): il
	                        // comando dal pannello passa dall'11.
	                        IF #MCRequested = 1 AND "DB_MC1".order.ID > 0 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := 'Z.ORDER_ID=',
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                        ELSE
	                            #Error := 936;   // deposito auto senza ordine attivo
	                        END_IF;
	                        
	                        IF #Error = 0 THEN
	                            #queryStartExecution := TRUE;
	                            #Dispatcher["_Part_Robot_to_MC"] := 20;
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	            11:  // presa in carico VERIFICATA della ricerca dell'ordine in attesa
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_Robot_to_MC"] := 12;
	                END_IF;
	                
	            12:  // esito della ricerca dell'ordine del pezzo prelevato
	                // Zero righe = nessun ordine di MC1 per quel pezzo (avviato, in coda o in
	                // pausa: vista MAN_ORDER_MC1 dal 7/10). Il ponte SQL puo'
	                // segnalare le zero righe come dataError invece che noData (gia' visto):
	                // tutti e due fermano la missione: 970, oppure 971 se la provenienza del
	                // pezzo non e' nota (al 10 si e' cercato l'ordine avviato di MC1).
	                // Ordine trovato: la query delle quote di deposito e' quella del 10, con
	                // l'ordine scritto per intero (184 caratteri contro i 254 di queryTemp).
	                // Si compone qui, mentre il valore e' in SqlData, e parte al 13.
	                IF "DB_executeQuery".dataReady THEN
	                    IF "DB_executeQuery".noData OR "DB_executeQuery".dataError THEN
	                        IF #Tray_ID <= 0 OR #PartSubPos <= 0 THEN
	                            #Error := 971;   // provenienza non nota e nessun ordine avviato di MC1
	                        ELSE
	                            #Error := 970;   // nessun ordine di MC1 (avviato, in coda o in pausa) per il pezzo prelevato
	                        END_IF;
	                        #queryTemp := '';
	                        #Dispatcher["_Part_Robot_to_MC"] := 7001;
	                    ELSE
	                        // (7/10) L'ORDINE TROVATO DIVENTA L'ORDINE DEL PEZZO IN MACCHINA: lo
	                        // usano la spinta (32), il soffiaggio (37) e, dopo, il prelievo
	                        // manuale da MC1 (10 e 37 di Part_MC_to_Robot). Il 50 non lo
	                        // sovrascrive piu' in manuale. Si scrive qui, prima del deposito,
	                        // perche' fra 12 e 50 non c'e' altro posto dove tenerlo senza
	                        // cambiare l'interfaccia di FB7: il deposito manuale presuppone la
	                        // morsa vuota, quindi in macchina non c'e' un altro pezzo da perdere.
	                        #OrderIdMC := DINT_TO_INT("SqlData".data.rows[0].col[0]);
	                        #queryTemp := CONCAT(IN1 := 'select P.X,P.Y,Z.Z_PLACE_MC,P.X_ROT,P.Y_ROT,P.Z_ROT,P.APPROACH_TYPE,P.APPROACH_X,P.APPROACH_Y,P.APPROACH_Z from POSITION P,COORDINATES_Z_MC Z where P.PARENT=$'MC_1$' and Z.ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#OrderIdMC));
	                        #Dispatcher["_Part_Robot_to_MC"] := 13;
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryStartExecution := FALSE;
	                END_IF;
	                
	            13:  // lancia la query delle quote composta al 12, quando il ponte e' libero
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 20;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le QUOTE DI DEPOSITO in macchina.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_Robot_to_MC"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // quote di deposito non trovate (ordine/pezzo/attrezzatura non
	                    // coerenti a DB): con FB6 corretto va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Error := "_Part_Robot_to_MC" * 100 + 99;           //error 799
	                    #Dispatcher["_Part_Robot_to_MC"] := "_Part_Robot_to_MC" * 100 + 99;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]);
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := FALSE);
	                    "DB_RobotMission".Object_Type := "Part";
	                    "DB_RobotMission".Unit_code := #MCRequested + 10;
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    "DB_RobotMission".Gripper_Side := 1;
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    // SPINTA IN BATTUTA: seconda lettura, sulla vista COORDINATES_PUSH_MC.
	                    // Si legge QUI, PRIMA di lanciare la missione, e si congela: il
	                    // robot non deve mai aspettare il ponte SQL con le chele chiuse
	                    // accanto a un pezzo posato. Da questo punto in poi un cambio a
	                    // database non ha effetto fino al pezzo successivo.
	                    #xPushTemp := 0;
	                    #xStopTemp := 0;
	                    #Dispatcher["_Part_Robot_to_MC"] := 32;
	                ELSIF "DB_executeQuery".dataError THEN
	                    //Errore
	                    #Error := "_Part_Robot_to_MC" * 100 + 99;           //error 799
	                    #Dispatcher["_Part_Robot_to_MC"] := "_Part_Robot_to_MC" * 100 + 99;
	                    "DB_executeQuery".readyForNextQuery := true;
	                END_IF;
	                
	            32:  // SPINTA: compone la query sulle quote di spinta e arrivo.
	                // In AUTOMATICO l'ordine attivo. Col comando dal pannello (master 1250,
	                // vedi il 10) l'ordine trovato all'11-12 per il pezzo prelevato e salvato
	                // in OrderIdMC: lo stesso delle quote di deposito. Prima si guardava
	                // DB_MC1.order.ID > 0, che dopo un ordine finito resta valorizzato
	                // (simulazione 7/10, problema 3).
	                // (6/10 sera) terza colonna Z_PUSH_DROP: di quanto scendere con la
	                // chela rispetto alla Z di deposito durante la spinta (vedi 36).
	                // (35) ISNULL SULLE QUOTE: il ponte SQL legge un NULL come i 4 byte che
	                // lo seguono. Con Z_PUSH_DROP in coda, X_PUSH e X_STOP NULL (spinta
	                // non OK) diventavano 1024 e 4 micron: dentro i 500 mm del controllo,
	                // spinta abilitata verso X = 1 mm (simulazione 7/10 bis, B3). Con
	                // isnull arrivano 0 e 0, che il 36 tratta gia' come "niente spinta".
	                IF #MCRequested <> 1 THEN
	                    // MC2 non esiste in questa cella: nessuna spinta
	                    #Dispatcher["_Part_Robot_to_MC"] := 40;
	                ELSIF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Dispatcher["_master"] <> 1250 THEN
	                        // automatico: l'ordine attivo, controllato > 0 al 10
	                        #queryTemp := CONCAT(IN1 := 'select isnull(X_PUSH,0),isnull(X_STOP,0),Z_PUSH_DROP from COORDINATES_PUSH_MC where MC=1 and ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                    ELSE
	                        // manuale: l'ordine del pezzo prelevato, trovato al 12
	                        #queryTemp := CONCAT(IN1 := 'select isnull(X_PUSH,0),isnull(X_STOP,0),Z_PUSH_DROP from COORDINATES_PUSH_MC where MC=1 and ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#OrderIdMC));
	                    END_IF;
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 34;
	                END_IF;
	                
	            34:  // presa in carico VERIFICATA della query spinta
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_Robot_to_MC"] := 36;
	                END_IF;
	                
	            36:  // esito spinta. Le quote sono NULL quando la vista dice che la
	                // spinta non e' configurata, disabilitata, o il pezzo non ci sta.
	                // ATTENZIONE: il ponte SQL NON converte NULL in zero: restituisce
	                // valori casuali (visto 15/9: xStopTemp a -1.056.960.259 con
	                // PUSH_STATUS DISABLED). Quindi non ci si puo' fidare del valore:
	                // va verificato che sia PLAUSIBILE rispetto alla quota di deposito.
	                // Spinta e arrivo stanno per costruzione entro qualche centinaio di
	                // millimetri da X_PLACE: fuori da mezzo metro il dato e' spazzatura
	                // e la spinta non si fa.
	                // QUOTA Z DELLA SPINTA (6/10): Z_Push = Z di deposito (gia' in
	                // Z_Pick-Place dal 30) meno Z_PUSH_DROP. Va al robot su Z_Push_LOW/
	                // Z_Push_HIGH (%QW646/%QW648), prima del comando del 40. Senza spinta
	                // valida o con una discesa non plausibile: Z_Push = Z di deposito,
	                // cioe' la spinta come prima. La vista limita gia' la discesa a
	                // [0, quota di presa]; i 300 mm qui scartano solo i valori casuali.
	                IF "DB_executeQuery".dataReady THEN
	                    IF "DB_executeQuery".noData OR "DB_executeQuery".dataError THEN
	                        #xPushTemp := 0;
	                        #xStopTemp := 0;
	                        "FC_Split_Dint"(IN := "DB_RobotMission"."Z_Pick-Place",
	                                        HIGH_Word => "Z_Push_HIGH",
	                                        LOW_Word => "Z_Push_LOW");
	                    ELSE
	                        #xPushTemp := "SqlData".data.rows[0].col[0];
	                        #xStopTemp := "SqlData".data.rows[0].col[1];
	                        
	                        // controllo di plausibilita': entrambe le quote devono
	                        // stare entro 500 mm dalla quota di deposito appena letta.
	                        // (35) In piu' la GEOMETRIA della vista (coordinates-push-mc.sql):
	                        // l'arrivo non sta dietro la partenza e la corsa non supera
	                        // 200 mm (al piu' meta' ganascia piu' il tratto dichiarato: e'
	                        // un limite contro i dati casuali, non di processo).
	                        // Differenze in LInt: con dati casuali in DInt potevano traboccare.
	                        IF ABS(DINT_TO_LINT(#xPushTemp) - DINT_TO_LINT("DB_RobotMission"."X_Pick-Place")) > 500000
	                            OR ABS(DINT_TO_LINT(#xStopTemp) - DINT_TO_LINT("DB_RobotMission"."X_Pick-Place")) > 500000
	                            OR #xStopTemp < #xPushTemp
	                            OR DINT_TO_LINT(#xStopTemp) - DINT_TO_LINT(#xPushTemp) > 200000
	                        THEN
	                            #xPushTemp := 0;
	                            #xStopTemp := 0;
	                        END_IF;
	                        
	                        IF #xPushTemp <> 0 AND #xStopTemp <> 0
	                            AND "SqlData".data.rows[0].col[2] >= 0
	                            AND "SqlData".data.rows[0].col[2] <= 300000
	                        THEN
	                            "FC_Split_Dint"(IN := "DB_RobotMission"."Z_Pick-Place" - "SqlData".data.rows[0].col[2],
	                                            HIGH_Word => "Z_Push_HIGH",
	                                            LOW_Word => "Z_Push_LOW");
	                        ELSE
	                            "FC_Split_Dint"(IN := "DB_RobotMission"."Z_Pick-Place",
	                                            HIGH_Word => "Z_Push_HIGH",
	                                            LOW_Word => "Z_Push_LOW");
	                        END_IF;
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 37;
	                END_IF;
	                
	            37:  // SOFFIAGGIO: lunghezza chele morsa, larghezza pezzo e quota di
	                // appoggio verso il robot (19/9). Il robotista le legge prima di
	                // soffiare, in deposito e in prelievo.
	                // Query SEPARATA dalle quote: quelle sono critiche e passano da
	                // viste collaudate, queste servono a un soffiaggio e non devono
	                // appesantirle.
	                // VISTA DEDICATA (COORDINATES_BLOW_MC): la query coi join scritti
	                // a mano faceva 298 caratteri e queryTemp ne regge 254 — sarebbe
	                // arrivata troncata, come il 13599 del 15/9. Con la vista sono 96.
	                // Le tre variabili PROFINET NON si azzerano mai: restano quelle
	                // dell'ultimo pezzo finche' un nuovo giro non le sovrascrive. Se
	                // la query fallisce si prosegue coi valori vecchi — fermare la
	                // cella per una misura di soffiaggio sarebbe sproporzionato.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Dispatcher["_master"] <> 1250 THEN
	                        // automatico: l'ordine attivo, controllato > 0 al 10
	                        #queryTemp := CONCAT(IN1 := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_Robot_to_MC"] := 38;
	                    ELSE
	                        // COMANDO DAL PANNELLO (7/10, master 1250, vedi il 10): dati del
	                        // pezzo dall'ordine trovato al 12 per il pezzo prelevato (OrderIdMC),
	                        // lo stesso delle quote di deposito.
	                        // Prima si guardava DB_MC1.order.ID > 0, valorizzato anche dopo un
	                        // ordine finito (simulazione 7/10, problema 3).
	                        #queryTemp := CONCAT(IN1 := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#OrderIdMC));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_Robot_to_MC"] := 38;
	                    END_IF;
	                END_IF;
	                
	            38:  // presa in carico VERIFICATA
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_Robot_to_MC"] := 39;
	                END_IF;
	                
	            39:  // esito: scrive le cinque variabili PROFINET.
	                // APPOGGIO COME MISURA, NON COME QUOTA (19/9): il robotista non
	                // vuole piu' la posizione X del pezzo, che calcola per conto suo —
	                // gli serve solo di quanto il pezzo appoggia, cioe' meta' ganascia
	                // piu' il tratto oltre la ganascia dichiarato a pannello.
	                // L'espressione e' tutta DInt (le colonne SqlData lo sono), quindi
	                // la somma in micron non trabocca e la conversione a Int avviene
	                // una volta sola sul risultato in mm.
	                // I micron del database diventano mm interi: per un soffiaggio il
	                // decimo non serve, e il robotista ha chiesto Int.
	                IF "DB_executeQuery".dataReady THEN
	                    IF NOT "DB_executeQuery".noData AND NOT "DB_executeQuery".dataError THEN
	                        "Vice_ClawLength_mm" := DINT_TO_INT("SqlData".data.rows[0].col[0] / 1000);
	                        "Part_Width_mm" := DINT_TO_INT("SqlData".data.rows[0].col[3] / 1000);
	                        "X_Support_mm" := DINT_TO_INT(("SqlData".data.rows[0].col[0] / 2
	                                                                                    + "SqlData".data.rows[0].col[2]) / 1000);
	                        // DATI PEZZO PER IL ROBOT (5/10, richiesta del robotista): lunghezza
	                        // e altezza del pezzo dell'ordine, stesso formato e stesso momento
	                        // delle tre qui sopra (mm interi, mai azzerate). Quale colonna di
	                        // PIECE diventa lunghezza e quale altezza lo decide la vista
	                        // COORDINATES_BLOW_MC, non il PLC.
	                        "Part_Length_mm" := DINT_TO_INT("SqlData".data.rows[0].col[1] / 1000);
	                        "Part_Height_mm" := DINT_TO_INT("SqlData".data.rows[0].col[4] / 1000);
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 40;
	                END_IF;
	                
	            40:
	                // Il consenso alla spinta va alzato PRIMA del comando: il robot lo
	                // legge quando acquisisce la missione e sa se dovra' chiedere le
	                // due fasi in piu'. Quote a zero = deposito normale, come oggi.
	                "Q_PushEnable_MC" := (#xPushTemp <> 0) AND (#xStopTemp <> 0);
	                "Ok_PushSpinta_MC" := FALSE;
	                "Ok_PushArrivo_MC" := FALSE;
	                
	                "DB_RobotMission".Command := "CMD_RobotPlaceObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    IF "Q_PushEnable_MC" THEN
	                        #Dispatcher["_Part_Robot_to_MC"] := 42;
	                    ELSE
	                        #Dispatcher["_Part_Robot_to_MC"] := 50;
	                    END_IF;
	                END_IF;
	                
	            42:  // SPINTA fase 1: il robot ha depositato e chiede la quota di spinta.
	                // HANDSHAKE BIDIREZIONALE concordato col robotista: il robot alza
	                // il bit, il PLC risponde col consenso, il robot ABBASSA il bit,
	                // il PLC abbassa il consenso. Solo allora la fase e' chiusa.
	                IF "Robot_PushDepositoFatto_MC" THEN
	                    "DB_RobotMission"."X_Pick-Place" := #xPushTemp;
	                    "Ok_PushSpinta_MC" := TRUE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 43;
	                END_IF;
	                
	            43:  // attesa che il robot abbassi il suo bit: ha letto la quota
	                IF NOT "Robot_PushDepositoFatto_MC" THEN
	                    "Ok_PushSpinta_MC" := FALSE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 44;
	                END_IF;
	                
	            44:  // SPINTA fase 2: il robot e' in posizione e chiede la quota di arrivo
	                IF "Robot_PushInPos_MC" THEN
	                    "DB_RobotMission"."X_Pick-Place" := #xStopTemp;
	                    "Ok_PushArrivo_MC" := TRUE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 45;
	                END_IF;
	                
	            45:  // attesa che il robot abbassi il suo bit: ha letto la quota
	                IF NOT "Robot_PushInPos_MC" THEN
	                    "Ok_PushArrivo_MC" := FALSE;
	                    #Dispatcher["_Part_Robot_to_MC"] := 50;
	                END_IF;
	                
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    #GripperOccuped[1] := FALSE;
	                    
	                    // CORSA DELLA SPINTA applicata a QUESTO pezzo: il prelievo
	                    // dovra' andare a prenderlo dove la spinta lo ha portato, non
	                    // dove il deposito lo aveva messo. Zero se la spinta non c'e'
	                    // stata. Si azzera solo quando il pezzo esce dalla macchina.
	                    IF "Q_PushEnable_MC" THEN
	                        #xPushOffsetMC := #xStopTemp - #xPushTemp;
	                    ELSE
	                        #xPushOffsetMC := 0;
	                    END_IF;
	                    
	                    // consensi spinta abbassati a fine missione
	                    "Q_PushEnable_MC" := FALSE;
	                    "Ok_PushSpinta_MC" := FALSE;
	                    "Ok_PushArrivo_MC" := FALSE;
	                    
	                    // LA TASCA, IL CASSETTO E L'ORDINE del grezzo appena caricato
	                    // seguono il pezzo in macchina: il finito che ne uscira' dovra'
	                    // tornare esattamente li', e appartiene all'ordine che lo ha
	                    // lavorato.
	                    // IL CASSETTO E' NUOVO (16/9): prima TrayIdMC si scriveva solo
	                    // al deposito del finito, quindi per tutto il tempo in cui il
	                    // pezzo era in macchina puntava al cassetto PRECEDENTE. Al
	                    // cambio cassetto la UPDATE del finito finiva sul cassetto
	                    // vecchio e il pezzo non veniva registrato (visto 16/9: 16
	                    // prodotti, 15 tasche marcate finite). In piu' il 50 di FB204
	                    // rifiutava la missione 16, perche' la sua guardia chiede
	                    // TrayIdMC = ExtractedTray: al cambio cassetto ripiegava sulla
	                    // sequenza in due tempi (13 + 12) invece dell'ingresso unico.
	                    //
	                    // L'ORDINE E' NUOVO (18/9): col ciclo a missione 16 il finito
	                    // viene depositato nel giro SUCCESSIVO, e sull'ultimo pezzo di
	                    // un ordine il 102 di FB204 puo' aver gia' riallineato order.ID
	                    // a quello dopo. Senza congelarlo, quel pezzo verrebbe contato
	                    // all'ordine sbagliato: uno in meno al vecchio, uno in piu' al
	                    // nuovo, sempre sull'ultimo pezzo.
	                    #PartSubPosMC := #PartSubPos;
	                    #TrayIdMC := #Tray_ID;
	                    // (7/10) solo nel ciclo automatico: col comando dal pannello (master
	                    // 1250, vedi il 10) OrderIdMC e' gia' l'ordine del pezzo prelevato,
	                    // scritto al 12; DB_MC1.order.ID in manuale puo' essere l'ordine di una
	                    // produzione gia' finita.
	                    IF #Dispatcher["_master"] <> 1250 THEN
	                        IF #MCRequested = 2 THEN
	                            #OrderIdMC := DINT_TO_INT("DB_MC2".order.ID);
	                        ELSE
	                            #OrderIdMC := DINT_TO_INT("DB_MC1".order.ID);
	                        END_IF;
	                    END_IF;
	                    
	                    #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("RAW");
	                    
	                    #Dispatcher["_Part_Robot_to_MC"] := 60;
	                END_IF;
	                
	            60:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnMC"] := 10 + DINT_TO_INT("RAW");
	                    
	                    #Dispatcher["_Part_Robot_to_MC"] := 70;
	                END_IF;
	                
	            70:
	                IF #Dispatcher["updatePartOnMC"] = 0 THEN
	                    
	                    #Dispatcher["_Part_Robot_to_MC"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION Part_MC_to_Robot
	        CASE #Dispatcher["_Part_MC_to_Robot"] OF
	            0: //nothing to do
	                ;
	            10: //prepare mission data
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Gripper_ID[1] = 0 AND #Gripper_ID[2] = 0 THEN
	                        //nessuna pinza a bordo: impossibile prelevare
	                        #Error := 16;
	                        #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 1;
	                    ELSIF #GripperOccuped[1] AND #GripperOccuped[2] THEN
	                        //nessun lato libero: impossibile prelevare
	                        #Error := 18;
	                        #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 1;
	                    ELSIF (#MCRequested = 1 AND "DB_MC1".io_in.viceOpened) THEN
	                        // MORSA APERTA = NESSUN PEZZO DA PRELEVARE (17/9).
	                        // La ganascia aperta non puo' trattenere niente: qualunque
	                        // cosa dicano i registri, in morsa non c'e' un pezzo. Il
	                        // contrario NON vale — chiusa non implica pieno, puo'
	                        // essersi chiusa a vuoto — quindi il segnale si usa solo
	                        // come VETO, mai come conferma.
	                        #Error := 894;
	                        #Dispatcher["_Part_MC_to_Robot"] := 894;
	                    ELSE
	                        // QUOTE DALLA VISTA COORDINATES_Z_MC (19/9): vedi nota al
	                        // 10 di Part_Robot_to_MC.
	                        // Z_PICK_MC = prelievo del FINITO, che puo' avere presa
	                        // diversa dal grezzo (15/9).
	                        #queryTemp := 'select P.X,P.Y,Z.Z_PICK_MC,P.X_ROT,P.Y_ROT,P.Z_ROT,P.APPROACH_TYPE,P.APPROACH_X,P.APPROACH_Y,P.APPROACH_Z from POSITION P,COORDINATES_Z_MC Z where P.PARENT=$'MC_1$' and ';
	                        // (7/10) il prelievo lanciato dal pannello si riconosce dal master
	                        // (1230), non da RemoteMode: un HOLD messo o tolto a meta' missione
	                        // non deve cambiare ramo (simulazione 7/10, problema 13). Stessa
	                        // regola al 37.
	                        IF #Dispatcher["_master"] <> 1230 THEN
	                            IF #MCRequested = 1 AND "DB_MC1".order.ID > 0 THEN
	                                #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                     IN2 := 'Z.ORDER_ID=',
	                                                     IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                            ELSE
	                                #Error := 936;
	                                #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 1;
	                            END_IF;
	                        ELSE
	                            // PANNELLO (7/10): l'ordine del pezzo IN MACCHINA (OrderIdMC, scritto
	                            // dal deposito: al 12 in manuale, al 50 in automatico). Prima si
	                            // usava DB_MC1.order.ID, che dopo un ordine finito resta
	                            // valorizzato (simulazione 7/10, problema 3). Se OrderIdMC non e'
	                            // noto (per esempio dopo uno STOP->RUN: non e' ritentivo) resta la
	                            // regola di prima, l'ordine piu' recente di MC1.
	                            IF #OrderIdMC > 0 THEN
	                                #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                     IN2 := 'Z.ORDER_ID=',
	                                                     IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#OrderIdMC));
	                            ELSE
	                                #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                     IN2 := 'Z.MC=1 order by Z.ORDER_ID desc');
	                            END_IF;
	                        END_IF;
	                        
	                        IF #Error = 0 THEN
	                            #queryStartExecution := TRUE;
	                            #Dispatcher["_Part_MC_to_Robot"] := 20;
	                        END_IF;
	                    END_IF;
	                END_IF;
	                
	            20:  //execute query
	                // PRESA IN CARICO VERIFICATA: SqlData e' un buffer unico condiviso,
	                // senza il confronto su sqlCommands[0] si legge la risposta di un
	                // altro richiedente — qui sarebbero le QUOTE DI PRELIEVO dalla morsa.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_MC_to_Robot"] := 30;
	                END_IF;
	                
	            30:  // wait for result DB -> prepare mission data
	                IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                    // quote di prelievo non trovate: con FB6 corretto "zero righe"
	                    // non e' piu' dataError, va intercettato qui.
	                    "DB_executeQuery".readyForNextQuery := true;
	                    #Error := "_Part_MC_to_Robot" * 100 + 99;       //Error 899
	                    #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 99;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    
	                    // X DI PRELIEVO + CORSA DELLA SPINTA: se il pezzo e' stato
	                    // spinto in battuta non sta piu' dove il deposito lo ha messo.
	                    // xPushOffsetMC vale zero quando la spinta non c'e' stata,
	                    // quindi il caso normale resta invariato.
	                    "DB_RobotMission"."X_Pick-Place" := ("SqlData".data.rows[0].col[0]) + #xPushOffsetMC;
	                    "DB_RobotMission"."Y_Pick-Place" := ("SqlData".data.rows[0].col[1]);
	                    "DB_RobotMission"."Z_Pick-Place" := ("SqlData".data.rows[0].col[2]);
	                    "DB_RobotMission"."XRot_Pick-Place" := ("SqlData".data.rows[0].col[3]);
	                    "DB_RobotMission"."YRot_Pick-Place" := ("SqlData".data.rows[0].col[4]);
	                    "DB_RobotMission"."ZRot_Pick-Place" := ("SqlData".data.rows[0].col[5]);
	                    "DB_RobotMission".X_approach := ("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".Y_approach := ("SqlData".data.rows[0].col[8]);
	                    "DB_RobotMission".Z_approach := ("SqlData".data.rows[0].col[9]);
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "Part";
	                    "DB_RobotMission".Unit_code := #MCRequested + 10;
	                    "DB_RobotMission".Gripper_code := #GripperRequested;
	                    // LATO SEMPRE DECISO (5/10): mancava l'ELSE. Con la doppia e il lato 2
	                    // pieno, o con la singola piena, Gripper_Side restava quello della
	                    // missione precedente e il robot prelevava con un lato occupato. Il lato
	                    // 1 della doppia e' del grezzo: il finito non ci va.
	                    "DB_executeQuery".readyForNextQuery := true;
	                    IF (#Gripper_ID[2] <> 0 AND NOT #GripperOccuped[2]) THEN
	                        "DB_RobotMission".Gripper_Side := 2;
	                        #Dispatcher["_Part_MC_to_Robot"] := 37;
	                    ELSIF (#Gripper_ID[2] = 0 AND #Gripper_ID[1] <> 0 AND NOT #GripperOccuped[1]) THEN
	                        "DB_RobotMission".Gripper_Side := 1;
	                        #Dispatcher["_Part_MC_to_Robot"] := 37;
	                    ELSE
	                        #Error := 18;   // nessun lato libero adatto al finito
	                        #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 1;
	                    END_IF;
	                    //"DB_RobotMission".Option
	                ELSIF "DB_executeQuery".dataError THEN
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    //Errore
	                    #Error := "_Part_MC_to_Robot" * 100 + 99;       //Error 899
	                    #Dispatcher["_Part_MC_to_Robot"] := "_Part_MC_to_Robot" * 100 + 99;
	                END_IF;
	                
	            37:  // SOFFIAGGIO: vedi nota estesa al 37 di Part_Robot_to_MC.
	                // NB: qui X_Pick-Place e' la quota di PRELIEVO, che include
	                // xPushOffsetMC se il pezzo e' stato spinto. L'appoggio va
	                // calcolato sulla quota di DEPOSITO, quindi si sottrae l'offset
	                // per tornare alla nominale.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Dispatcher["_master"] <> 1230 AND "DB_MC1".order.ID > 0 THEN
	                        #queryTemp := CONCAT(IN1 := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_MC_to_Robot"] := 38;
	                    ELSIF #OrderIdMC > 0 THEN
	                        // COMANDO DAL PANNELLO (7/10, master 1230, vedi il 10): lo stesso
	                        // ordine del 10, quello del pezzo in macchina (OrderIdMC).
	                        #queryTemp := CONCAT(IN1 := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#OrderIdMC));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_MC_to_Robot"] := 38;
	                    ELSE
	                        // PANNELLO con OrderIdMC non noto (6/10, richiesta di Dario): i dati del
	                        // pezzo arrivano dallo STESSO ordine da cui il 10 ha preso le quote di
	                        // prelievo (COORDINATES_Z_MC, MC=1, ORDER_ID decrescente),
	                        // cioe' l'ordine piu' recente: la produzione possibile, anche se non
	                        // e' avviata. Prima qui non si leggeva niente e il robot riceveva i
	                        // valori dell'ultimo giro, anche di un altro pezzo.
	                        // La sottoquery ripete la regola del 10, cosi' quote e dati del pezzo
	                        // vengono sempre dallo stesso ordine. 190 caratteri, queryTemp ne regge 254.
	                        #queryTemp := 'select CLAW_LENGTH,PART_WIDTH,STOP_BEYOND_CLAW,PART_LENGTH,PART_HEIGHT from COORDINATES_BLOW_MC where ORDER_ID=(select top 1 ORDER_ID from COORDINATES_Z_MC where MC=1 order by ORDER_ID desc)';
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["_Part_MC_to_Robot"] := 38;
	                    END_IF;
	                END_IF;
	                
	            38:  // presa in carico VERIFICATA
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Part_MC_to_Robot"] := 39;
	                END_IF;
	                
	            39:  // esito: scrive le cinque variabili PROFINET.
	                // APPOGGIO COME MISURA, NON COME QUOTA (19/9): il robotista non
	                // vuole piu' la posizione X del pezzo, che calcola per conto suo —
	                // gli serve solo di quanto il pezzo appoggia, cioe' meta' ganascia
	                // piu' il tratto oltre la ganascia dichiarato a pannello.
	                // Niente X_Pick-Place e niente xPushOffsetMC: l'offset serviva a
	                // riportare la quota di prelievo a quella di deposito, e senza la
	                // quota non ha piu' nulla da correggere. Sottraendolo dopo la
	                // divisione, per giunta, si toglievano MICRON da un numero in
	                // MILLIMETRI: col push attivo dava -49650.
	                IF "DB_executeQuery".dataReady THEN
	                    IF NOT "DB_executeQuery".noData AND NOT "DB_executeQuery".dataError THEN
	                        "Vice_ClawLength_mm" := DINT_TO_INT("SqlData".data.rows[0].col[0] / 1000);
	                        "Part_Width_mm" := DINT_TO_INT("SqlData".data.rows[0].col[3] / 1000);
	                        "X_Support_mm" := DINT_TO_INT(("SqlData".data.rows[0].col[0] / 2
	                                                                                    + "SqlData".data.rows[0].col[2]) / 1000);
	                        // DATI PEZZO PER IL ROBOT (5/10, richiesta del robotista): lunghezza
	                        // e altezza del pezzo dell'ordine, stesso formato e stesso momento
	                        // delle tre qui sopra (mm interi, mai azzerate). Quale colonna di
	                        // PIECE diventa lunghezza e quale altezza lo decide la vista
	                        // COORDINATES_BLOW_MC, non il PLC.
	                        "Part_Length_mm" := DINT_TO_INT("SqlData".data.rows[0].col[1] / 1000);
	                        "Part_Height_mm" := DINT_TO_INT("SqlData".data.rows[0].col[4] / 1000);
	                    END_IF;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Dispatcher["_Part_MC_to_Robot"] := 40;
	                END_IF;
	                
	            40:
	                "DB_RobotMission".Command := "CMD_RobotPickObject";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["_Part_MC_to_Robot"] := 50;
	                END_IF;
	            50:
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    // lati dedicati: marca il lato realmente scelto (Gripper_Side: 1=grezzo, 2=finito)
	                    IF "DB_RobotMission".Gripper_Side = 2 THEN
	                        #GripperOccuped[2] := TRUE;
	                        #Dispatcher["updatePartOnRobot"] := 20 + DINT_TO_INT("FINISHED");
	                    ELSE
	                        #GripperOccuped[1] := TRUE;
	                        #Dispatcher["updatePartOnRobot"] := 10 + DINT_TO_INT("FINISHED");
	                    END_IF;
	                    "DB_RobotMission".Command := 0; ///\\\
	                    
	                    // Il pezzo spinto e' USCITO dalla macchina: la corsa memorizzata
	                    // non descrive piu' niente. Senza questo azzeramento resta
	                    // latchata e si somma al prelievo del pezzo SUCCESSIVO, che
	                    // magari non e' mai stato spinto.
	                    #xPushOffsetMC := 0;
	                    
	                    #Dispatcher["_Part_MC_to_Robot"] := 60;
	                END_IF;
	            60:
	                IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                    #Dispatcher["updatePartOnMC"] := 10 + DINT_TO_INT("EMPTY");
	                    IF #MCRequested = 1 THEN
	                        "DB_MC1".piecepresent[1] := 0;
	                    ELSIF #MCRequested = 2 THEN
	                        "DB_MC2".piecepresent[1] := 0;
	                    END_IF;
	                    
	                    #Dispatcher["_Part_MC_to_Robot"] := 70;
	                END_IF;
	            70:
	                IF #Dispatcher["updatePartOnMC"] = 0 THEN
	                    
	                    #Dispatcher["_Part_MC_to_Robot"] := 0;
	                END_IF;
	                
	            894:
	                ; // morsa aperta: nessun pezzo da prelevare
	                
	        END_CASE;
	    END_REGION
	    
	END_REGION
	
	
	REGION TRAY_MANAGER
	    REGION TRAY_extact
	        CASE #Dispatcher["Extract_TRAY"] OF
	            0: //nothing to do
	                ;
	                
	            10:
	                // GUARDIA PORTA OPERATORE (19/9): i cassetti non si muovono a
	                // porta aperta. Era l'unica catena del magazzino senza questo
	                // controllo — il comando estraeva il cassetto e il 949 arrivava
	                // dopo, a cassetto gia' fuori.
	                // Si legge l'ingresso direttamente: DB_BOX_1.Robot_enabled_to_work
	                // adesso dice solo "magazzino senza errori" e vale per pezzi e
	                // pinze, che a porta aperta possono proseguire.
	                IF NOT "Door_OP_locked" THEN
	                    #Error := 949;
	                    #Dispatcher["Extract_TRAY"] := 0;
	                ELSIF "DB_BOX_1".ExtractedTray = 0 THEN
	                    IF #Tray_ID > 0 AND #Tray_ID <= 12 THEN
	                        IF #Gripper_ID[1] = 0 AND #Gripper_ID[2] = 0 THEN
	                            #Error := 22;
	                            #Dispatcher["Extract_TRAY"] := 0;
	                        END_IF;
	                    ELSE
	                        #Error := 19001;
	                        // la catena chiude anche in errore (5/10): il parcheggio a 19001/19002
	                        // teneva il 750 fermo e MissionCode a 202 fino al reset
	                        #Dispatcher["Extract_TRAY"] := 0;
	                    END_IF;
	                ELSE
	                    IF "DB_BOX_1".ExtractedTray <> #Tray_ID THEN
	                        #Error := 19002;
	                        #Dispatcher["Extract_TRAY"] := 0;   // vedi nota al 19001
	                    END_IF;
	                END_IF;
	                IF #Dispatcher["Extract_TRAY"] = 10 THEN
	                    #Dispatcher["Extract_TRAY"] := 12;   // gancio già a bordo: nessun cambio-TCP
	                END_IF;
	                
	            11: //wait for change TCP data
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    #Dispatcher["Extract_TRAY"] := 12;
	                END_IF;
	                
	            12:
	                IF "SqlCommands".sqlCommands[0] = '' AND "DB_executeQuery".readyForNextQuery THEN
	                    IF #Tray_ID > 0 AND #Tray_ID <> "DB_BOX_1".ExtractedTray THEN
	                        // (7/10) col[11] = HAS_HOOK della pinza a bordo, 0 se non e' in
	                        // anagrafica (isnull: il ponte SQL non converte NULL in zero).
	                        // 194 caratteri con ID a 5 cifre, queryTemp ne regge 254.
	                        #queryTemp := CONCAT(IN1 := 'SELECT TRAY,X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z,isnull((select cast(HAS_HOOK as int) from GRIPPER where ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                             IN3 := '),0) from COORDINATES_FOR_EXTRACT where tray=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID));
	                        #queryStartExecution := TRUE;
	                        #Dispatcher["Extract_TRAY"] := 15;
	                    ELSIF #Tray_ID > 0 AND #Tray_ID = "DB_BOX_1".ExtractedTray THEN
	                        // IL CASSETTO CHIESTO E' GIA' FUORI (18/9): niente da fare,
	                        // la missione e' conclusa. Senza questo ramo la condizione
	                        // sopra e' falsa, il 12 non compone nessuna query e non
	                        // avanza: la catena resta appesa qui per sempre, il 750
	                        // aspetta Extract_TRAY=0 che non arriva mai e MissionCode
	                        // resta a 202 — con FB204 fermo al 58 in attesa di una
	                        // missione che nessuno chiudera'. Visto in campo.
	                        #Dispatcher["Extract_TRAY"] := 0;
	                    END_IF;
	                END_IF;
	                
	            15:  // execute query — PRESA IN CARICO VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza il confronto su
	                // sqlCommands[0] il 30 puo' leggere la risposta di un altro
	                // richiedente e mandare il robot a estrarre il cassetto con
	                // coordinate altrui.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #queryStartExecution := false;
	                    #Dispatcher["Extract_TRAY"] := 20;
	                END_IF;
	                
	            20:  // wait result
	                // ZERO RIGHE = CASSETTO SENZA QUOTE (5/10). Con FB6 corretto "zero
	                // righe" non e' dataError: il 30 leggeva rows[0] rimasto dalla query
	                // PRECEDENTE e il robot andava a estrarre con quote altrui. Dopo le
	                // cancellazioni del 29/9 e' un caso reale.
	                IF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError
	                    AND NOT "DB_executeQuery".noData THEN
	                    #Dispatcher["Extract_TRAY"] := 30;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    #Error := 19004;   // nessuna riga in COORDINATES_FOR_EXTRACT per il cassetto
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Extract_TRAY"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND "DB_executeQuery".dataError THEN
	                    #Error := 99; //DB ERROR
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Extract_TRAY"] := 0;
	                END_IF;
	                
	            30: // prepare mission data for robot
	                // SOLO CON L'UNCINO (7/10, decisione di Dario): col[11] e' HAS_HOOK della
	                // pinza a bordo. Vale per ogni percorso, pannello e ciclo automatico.
	                IF "SqlData".data.rows[0].col[11] <> 1 THEN
	                    #Error := 19005;   // pinza a bordo senza uncino: il cassetto non si estrae
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Extract_TRAY"] := 0;
	                ELSIF NOT #GripperOccuped[1] AND NOT #GripperOccuped[2] THEN
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[6];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[10];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[7]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[7], pick := TRUE);
	                    "DB_RobotMission".Gripper_Side := 1;        //ALWAYS =1
	                    "DB_RobotMission".Object_Type := "TRAY";
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];   // la pinza a bordo, non GripperRequested
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Extract_TRAY"] := 40;
	                ELSE
	                    //gripper occupata
	                    #Error := 21;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Extract_TRAY"] := 0;
	                END_IF;
	            40: //start mission robot
	                "DB_RobotMission".Command := "CMD_RobotExtractTray";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Extract_TRAY"] := 100;
	                END_IF;
	                
	            100: // Update DB — LATCH A DOPPIA CONFERMA
	                // Non basta cmd_executed del robot: senza il riscontro del sensore
	                // il registro dice "estratto" con il cassetto dentro, e la
	                // sincronizzazione di DB_BOX_1 tenta la richiusura (RequestedTray:=0)
	                // generando errore 9 e 949 a catena.
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed"
	                    AND "px_tray_in_position"
	                THEN
	                    "FC_MQTT"(insert := true,
	                              send := false,
	                              topic := 'FROM_PLANT/TRAY/BOX/EXTRACT',
	                              payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID)));
	                    
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    
	                    "DB_BOX_1".ExtractedTray := #Tray_ID;
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    #Dispatcher["Extract_TRAY"] := 130;
	                END_IF;
	            130:
	                IF #Dispatcher["Reset_or_log_MissionData"] = 0 AND "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];   // re-assert dopo il reset (come swap 985)
	                    #Dispatcher["Extract_TRAY"] := 0;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION TRAY_release
	        CASE #Dispatcher["Release_TRAY"] OF
	            0: //nothing to do
	                ;
	            10:
	                // GUARDIA PORTA OPERATORE (19/9): vedi nota al 10 di Extract_TRAY.
	                IF NOT "Door_OP_locked" THEN
	                    #Error := 949;
	                    #Dispatcher["Release_TRAY"] := 0;
	                ELSIF "DB_BOX_1".ExtractedTray > 0 THEN
	                    IF #Gripper_ID[1] = 0 AND #Gripper_ID[2] = 0 THEN
	                        #Error := 2022;                     // pinza assente
	                        #Dispatcher["Release_TRAY"] := 0;
	                    ELSE
	                        #Dispatcher["Release_TRAY"] := 12;  // gancio a bordo: nessun cambio-TCP -> query
	                    END_IF;
	                ELSE
	                    #Error := 20001;                        // nessun cassetto da rilasciare
	                    #Dispatcher["Release_TRAY"] := 0;
	                END_IF;
	                
	            11: //wait for change TCP data
	                IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                    #Dispatcher["Release_TRAY"] := 12;
	                END_IF;
	                
	            12:
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    // (7/10) col[10] = HAS_HOOK della pinza a bordo, come al 12 di
	                    // Extract_TRAY. 189 caratteri con ID a 5 cifre.
	                    #queryTemp := CONCAT(IN1 := 'SELECT X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z,isnull((select cast(HAS_HOOK as int) from GRIPPER where ID=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                         IN3 := '),0) from COORDINATES_FOR_EXTRACT where tray=',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray));
	                    IF #MCRequested = 1 THEN
	                        #paramsTemp[0] := DINT_TO_INT("DB_MC1".order.GRIPPER);
	                        #paramsTemp[1] := DINT_TO_INT(IN := "RAW");
	                        IF ("DB_MC1".Status = "FINISHED") THEN
	                            #paramsTemp[1] := DINT_TO_INT(IN := "FINISHED");
	                        END_IF;
	                    ELSIF #MCRequested = 2 THEN
	                        #paramsTemp[0] := DINT_TO_INT("DB_MC2".order.GRIPPER);
	                        #paramsTemp[1] := DINT_TO_INT(IN := "RAW");
	                        IF ("DB_MC2".Status = "FINISHED") THEN
	                            #paramsTemp[1] := DINT_TO_INT(IN := "FINISHED");
	                        END_IF;
	                    END_IF;
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["Release_TRAY"] := 15;
	                END_IF;
	                
	            15: // execute query — PRESA IN CARICO VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza il confronto su
	                // sqlCommands[0] il 30 puo' leggere la risposta di un altro
	                // richiedente e mandare il robot a rimettere dentro il cassetto
	                // con coordinate altrui.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["Release_TRAY"] := 20;
	                END_IF;
	                
	            20: // wait result
	                // ZERO RIGHE (5/10): vedi nota al 20 di Extract_TRAY. Qui il cassetto
	                // rientrerebbe con le quote di un altro.
	                // L'errore DB adesso chiude la catena (era parcheggiata a 99): l'810
	                // aspetta Release_TRAY = 0 e senza chiusura MissionCode restava a 203.
	                IF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError
	                    AND NOT "DB_executeQuery".noData THEN
	                    #Dispatcher["Release_TRAY"] := 30;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    #Error := 20009;   // nessuna riga in COORDINATES_FOR_EXTRACT per il cassetto estratto
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Release_TRAY"] := 0;
	                ELSIF "DB_executeQuery".dataError THEN
	                    #Error := 99;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Release_TRAY"] := 0;
	                END_IF;
	                
	            30:  // prepare mission data
	                // SOLO CON L'UNCINO (7/10, decisione di Dario): col[10] e' HAS_HOOK della
	                // pinza a bordo. Col cassetto fuori la pinza non si cambia (1419/1519):
	                // senza uncino il cassetto si rientra a mano.
	                IF "SqlData".data.rows[0].col[10] <> 1 THEN
	                    #Error := 20011;   // pinza a bordo senza uncino: il cassetto non si rientra col robot
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Release_TRAY"] := 0;
	                ELSIF NOT #GripperOccuped[1] AND NOT #GripperOccuped[2] THEN
	                    "DB_RobotMission"."X_Pick-Place" := "SqlData".data.rows[0].col[0];
	                    "DB_RobotMission"."Y_Pick-Place" := "SqlData".data.rows[0].col[1];
	                    "DB_RobotMission"."Z_Pick-Place" := "SqlData".data.rows[0].col[2];
	                    "DB_RobotMission"."XRot_Pick-Place" := "SqlData".data.rows[0].col[3];
	                    "DB_RobotMission"."YRot_Pick-Place" := "SqlData".data.rows[0].col[4];
	                    "DB_RobotMission"."ZRot_Pick-Place" := "SqlData".data.rows[0].col[5];
	                    "DB_RobotMission".X_approach := "SqlData".data.rows[0].col[7];
	                    "DB_RobotMission".Y_approach := "SqlData".data.rows[0].col[8];
	                    "DB_RobotMission".Z_approach := "SqlData".data.rows[0].col[9];
	                    "DB_RobotMission".XRot_approach := 0;
	                    "DB_RobotMission".YRot_approach := 0;
	                    "DB_RobotMission".ZRot_approach := 0;
	                    //"DB_RobotMission".ApproachType := DINT_TO_INT("SqlData".data.rows[0].col[6]);
	                    "DB_RobotMission".ApproachType := "FC_ExtractApproach"(approachVal := "SqlData".data.rows[0].col[6], pick := TRUE);
	                    "DB_RobotMission".Object_Type := "TRAY";
	                    "DB_RobotMission".Gripper_Side := 1; //ALWAYS 1
	                    "DB_RobotMission".Unit_code := "Warehouse1";
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];   // la pinza a bordo, non GripperRequested
	                    //"DB_RobotMission".Option
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Release_TRAY"] := 40;
	                ELSE
	                    //gripper occupata
	                    #Error := 21;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["Release_TRAY"] := 0;
	                END_IF;
	            40:
	                "DB_RobotMission".Command := "CMD_RobotReleaseTray";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #Dispatcher["Release_TRAY"] := 100;
	                END_IF;
	                
	            100: // Update DB -----------------------------------------
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "FC_MQTT"(insert := true,
	                              send := false,
	                              topic := 'FROM_PLANT/TRAY/BOX/RELEASE',
	                              payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray)));
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    "DB_BOX_1".ExtractedTray := 0;
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    #Dispatcher["Release_TRAY"] := 130;
	                END_IF;
	                (* 
	                   IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN#paramsTemp[0] := 0;
	                    #paramsTemp[1] := "DB_BOX_1".ExtractedTray;
	                    
	                    #Dispatcher["Release_TRAY"] := 105;
	                END_IF;
	            105: //wait for DB ready
	                IF "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["Release_TRAY"] := 110;
	                END_IF;
	            110:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["Release_TRAY"] := 120;
	                END_IF;
	                
	            120:  // wait result
	                IF "DB_executeQuery".dataReady  THEN //AND NOT "DB_executeQuery".dataError
	                    "DB_BOX_1".ExtractedTray := 0;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    
	                    #Dispatcher["Release_TRAY"] := 130;
	                END_IF;
	            *)
	            130:
	                IF #Dispatcher["Reset_or_log_MissionData"] = 0 AND "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[1];
	                    #Dispatcher["Release_TRAY"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	END_REGION
	
	REGION MICROMISSIONS_AND_UPDATE_DB 
	    REGION get_TCP_Data 
	        CASE #Dispatcher["get_TCP_Data"] OF
	            0: //nothing to do
	                ;
	            10: //prepare mission data ***START HERE FOR GRIPPER***
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Gripper_ID[1] = 0 AND #Gripper_ID[2] = 0 THEN
	                        //gripper absent
	                        #Error := "get_TCP_Data" * 100 + 22;        //error 2222
	                        #Dispatcher["get_TCP_Data"] := 0;
	                    ELSE
	                        #queryTemp := 'tcpData';
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["get_TCP_Data"] := 15;
	                    END_IF;
	                END_IF;
	            12: //prepare mission data ***START HERE FOR HOOK***
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Gripper_ID[1] = 0 AND #Gripper_ID[2] = 0 THEN
	                        //gripper absent
	                        #Error := 22;
	                        #Dispatcher["get_TCP_Data"] := 0;
	                    ELSE
	                        #queryTemp := 'select X,Y,Z,0,X_ROT,Y_ROT,Z_ROT from GRIPPER_HOOK';  //la colonna 4 (0) serve solo per tenere il posto vuoto della valvola ottenuta con l'altra query
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["get_TCP_Data"] := 15;
	                    END_IF;
	                END_IF;
	                
	            15: //wait DB ready — PRESA IN CARICO VERIFICATA
	                // SqlData e' un buffer unico condiviso: senza verifica il 30 puo'
	                // leggere la risposta di un altro richiedente e mandare al robot
	                // dimensioni TCP sbagliate.
	                // 'tcpData' e' una query SPECIALE che FB6 espande: sqlCommands[0] non
	                // coincide mai con #queryTemp, quindi la presa in carico si riconosce
	                // dall'inizio della query espansa. Sul ramo del gancio (stato 12) la
	                // query e' letterale e il confronto diretto vale.
	                // 5/10: a presa in carico avvenuta il flag si abbassa QUI, perche' per
	                // 'tcpData' OB1 rete 7 non lo abbassa mai: col ponte condiviso il
	                // robot terrebbe la precedenza per sempre e FB204 non potrebbe piu'
	                // interrogare il DB.
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    IF (#queryTemp = 'tcpData'
	                        AND LEFT(IN := "SqlCommands".sqlCommands[0], L := 20) = 'select X_BODY+X_CLAW')
	                        OR (#queryTemp <> 'tcpData'
	                        AND "SqlCommands".sqlCommands[0] = #queryTemp)
	                    THEN
	                        #queryStartExecution := FALSE;
	                        #Dispatcher["get_TCP_Data"] := 20;
	                    END_IF;
	                END_IF;
	                
	            20: //wait answer
	                // ZERO RIGHE PRIMA DEL SUCCESSO (5/10). Il ramo noData stava dopo quello
	                // di successo, che e' vero anche con zero righe: era irraggiungibile, e
	                // il 30 mandava al robot le dimensioni TCP della query precedente.
	                // La ricerca gancio (22-26, TODO mai finito) non parte piu' da qui:
	                // pinza a bordo assente dal database = errore dichiarato.
	                IF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError
	                    AND "DB_executeQuery".noData THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #Error := 2205;   // pinza a bordo assente da GRIPPERS / GRIPPER_HOOK
	                    #Dispatcher["get_TCP_Data"] := 0;
	                ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                    #Dispatcher["get_TCP_Data"] := 30;
	                ELSIF "DB_executeQuery".dataError THEN
	                    // chiusura anche in errore DB (5/10): il parcheggio a 99 lasciava
	                    // appesi i chiamanti (120, 960, 980, Declare 50) fino al reset
	                    "DB_executeQuery".readyForNextQuery := true; //****
	                    #Error := 99;
	                    #Dispatcher["get_TCP_Data"] := 0;
	                END_IF;
	                
	            22:
	                IF #Dispatcher["_Gripper_Hook_Search"] = 0 THEN
	                    #Dispatcher["_Gripper_Robot_to_TRAY"] := 10;
	                    #Dispatcher["get_TCP_Data"] := 24;
	                END_IF;
	            24:
	                IF #Dispatcher["_Gripper_Robot_to_TRAY"] = 0 THEN
	                    #MCRequested := 0;
	                    #Dispatcher["_Gripper_TRAY_to_Robot"] := 10;
	                    #Dispatcher["get_TCP_Data"] := 26;
	                END_IF;
	            26:
	                IF #Dispatcher["_Gripper_TRAY_to_Robot"] = 0 THEN
	                    #GripperRequested := 0;
	                    #Dispatcher["get_TCP_Data"] := 12;
	                END_IF;
	                
	                
	            30:  // wait for result DB -> prepare mission data
	                "DB_RobotMission".Gripper1_XDim := "SqlData".data.rows[0].col[0];
	                "DB_RobotMission".Gripper1_YDim := "SqlData".data.rows[0].col[1];
	                "DB_RobotMission".Gripper1_ZDim := "SqlData".data.rows[0].col[2];
	                "DB_RobotMission".Gripper1_XRotDim := "SqlData".data.rows[0].col[4];
	                "DB_RobotMission".Gripper1_YRotDim := "SqlData".data.rows[0].col[5];
	                "DB_RobotMission".Gripper1_ZRotDim := "SqlData".data.rows[0].col[6];
	                "DB_RobotMission".Gripper_code := #Gripper_ID[1]; //???
	                
	                IF "SqlData".data.rowCount > 1 THEN
	                    // lato 2: dimensioni dalla riga gemella.
	                    // Le ROTAZIONI del lato 2 le gestisce il robot con il proprio TCP:
	                    // il PLC non le manda e le tiene a zero per non lasciare valori
	                    // stantii (il calcolo +180 del 2/9 produceva 270000 e falsava tutto).
	                    "DB_RobotMission".Gripper2_XDim := "SqlData".data.rows[1].col[0];
	                    "DB_RobotMission".Gripper2_YDim := "SqlData".data.rows[1].col[1];
	                    "DB_RobotMission".Gripper2_ZDim := "SqlData".data.rows[1].col[2];
	                    "DB_RobotMission".Gripper2_XRotDim := 0;
	                    "DB_RobotMission".Gripper2_YRotDim := 0;
	                    "DB_RobotMission".Gripper2_ZRotDim := 0;
	                    "DB_RobotMission".Gripper_code := #Gripper_ID[2]; //???
	                END_IF;
	                
	                #i := DINT_TO_INT("SqlData".data.rows[0].col[3]);
	                IF #i > 10 THEN
	                    "DB_RobotMission".Gripper1_Valve := #i - DINT_TO_INT(TRUNC(#i / 10) * 10);
	                    "DB_RobotMission".Gripper2_Valve := TRUNC(#i / 10);
	                ELSE
	                    "DB_RobotMission".Gripper1_Valve := #i;
	                    "DB_RobotMission".Gripper2_Valve := 0;
	                END_IF;
	                
	                "DB_executeQuery".readyForNextQuery := true;
	                #Dispatcher["get_TCP_Data"] := 40;
	                
	            40: //sync with robot
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" THEN  ////\\\\
	                    #Dispatcher["get_TCP_Data"] := 45;
	                END_IF;
	            45: // Robot execute mission
	                "DB_RobotMission".Command := "CMD_RobotChangeDataForGripper";
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_acquired" OR
	                    "DB_RobotMissionStatus".StatusCode = "cmd_executing" THEN
	                    #Dispatcher["get_TCP_Data"] := 50;
	                END_IF;
	                
	            50:  // robot end mission
	                IF "DB_RobotMissionStatus".StatusCode = "cmd_executed" THEN
	                    "DB_RobotMission".Command := 0;  ///\\\
	                    "DB_executeQuery".readyForNextQuery := true;
	                    
	                    #Dispatcher["get_TCP_Data"] := 55;
	                END_IF;
	            55:
	                #Dispatcher["updateGripperOnRobot"] := 10; //serve fare questo?? TODO
	                
	                #Dispatcher["get_TCP_Data"] := 100;
	            100:
	                IF #Dispatcher["updateGripperOnRobot"] = 0 THEN
	                    //"DB_executeQuery".readyForNextQuery := true;  //paolo 18/8
	                    
	                    #Dispatcher["Reset_or_log_MissionData"] := 10;
	                    #Dispatcher["get_TCP_Data"] := 110;
	                END_IF;
	            110:
	                IF #Dispatcher["Reset_or_log_MissionData"] = 0 AND "DB_RobotMissionStatus".StatusCode = 0 THEN
	                    #Dispatcher["get_TCP_Data"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION updateGripperOnRobot
	        CASE #Dispatcher["updateGripperOnRobot"] OF
	            0:  // nothing to do
	                ;
	            10: // Update DB ***START HERE***
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #Gripper_ID[1] > 0 AND #Gripper_ID[2] > 0 THEN
	                        // pinza a doppia presa: entrambe le righe gemelle a bordo.
	                        // NB: niente IN(...) — il ponte SQL non lo digerisce e resta appeso.
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET POS_PLANT = 0 WHERE POS_plant = 1000; ',
	                                             IN2 := 'UPDATE Gripper SET POS_PLANT=1000 WHERE ID = ',
	                                             IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                             IN4 := '; UPDATE Gripper SET POS_PLANT=1000 WHERE ID = ',
	                                             IN5 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[2]));
	                    ELSIF #Gripper_ID[1] > 0 THEN
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET POS_PLANT = 0 WHERE POS_plant = 1000; ',
	                                             IN2 := 'UPDATE Gripper SET POS_PLANT=1000 WHERE ID = ',
	                                             IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]));
	                    ELSE
	                        #queryTemp := 'UPDATE GRIPPER SET POS_PLANT=0 WHERE POS_PLANT=1000';
	                    END_IF;
	                    #queryStartExecution := TRUE;
	                    
	                    #Dispatcher["updateGripperOnRobot"] := 20;
	                END_IF;
	                
	            20:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updateGripperOnRobot"] := 30;
	                END_IF;
	                
	            30:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["updateGripperOnRobot"] := 0;
	                    
	                    "FC_MQTT"(insert := true,
	                              send := false,
	                              topic := 'FROM_PLANT/GRIPPER/ROBOT',
	                              payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1])));
	                    
	                ELSIF "DB_executeQuery".dataError THEN
	                    // Alarm 
	                    #Error := 99;
	                    #Dispatcher["updateGripperOnRobot"] := 99;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION updatePartOnRobot
	        CASE #Dispatcher["updatePartOnRobot"] OF
	            0:  // nothing to do
	                ;
	                
	            10..15: // Update DB ------------ *** START HERE *** (change status Gripper 1)
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    //la attivo con dispatcher=10+statoPezzo (RAW,FINISHED)
	                    (* Modificato il 16/09/2025
	                    IF #GripperOccuped[1] THEN
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET STATUS=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnRobot"] - 10),
	                                             IN3 := ' WHERE ID=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]));
	                    ELSE
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET STATUS=2 WHERE ID=',    //EMPTY
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]));
	                    END_IF;
	                    *)
	                    #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET STATUS=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnRobot"] - 10),
	                                         IN3 := ' WHERE ID=',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID["DB_RobotMission".Gripper_Side]));
	                    
	                    #queryStartExecution := true;
	                    #Dispatcher["updatePartOnRobot"] := 40;
	                END_IF;
	                
	            20..25: // Update DB ------------ *** START HERE *** (change status gripper 2)
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    //la attivo con dispatcher=20+statoPezzo (RAW,FINISHED)
	                    IF #GripperOccuped[2] THEN
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET STATUS=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnRobot"] - 20),
	                                             IN3 := ' WHERE ID=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[2]));
	                    ELSE
	                        #queryTemp := CONCAT(IN1 := 'UPDATE GRIPPER SET STATUS=2 WHERE ID=',    //EMPTY
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[2]));
	                    END_IF;
	                    
	                    #queryStartExecution := true;
	                    #Dispatcher["updatePartOnRobot"] := 40;
	                END_IF;
	                
	            40:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePartOnRobot"] := 50;
	                END_IF;
	                
	            50:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["updatePartOnRobot"] := 55;
	                END_IF;
	                
	            55:// wait for reset query
	                IF "DB_executeQuery".Dispatch["_master"] = 0 AND "SqlCommands".sqlCommands[0] = '' THEN
	                    "FC_MQTT"(insert := true,
	                              send := false,
	                              topic := 'FROM_PLANT/GRIPPER/ROBOT',
	                              payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1])));
	                    
	                    #Dispatcher["updatePartOnRobot"] := 0;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION updatePalletOnTRAY
	        CASE #Dispatcher["updatePalletOnTRAY"] OF
	            0:  // nothing to do
	                ;
	                
	            10..15: // *** START HERE *** (change status)
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    //la attivo con dispatcher=10+statoPezzo (RAW,FINISHED)
	                    IF #GripperOccuped[1] THEN
	                        //robot finish a pick
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePalletOnTRAY"] - 10));
	                        IF #MCRequested = 0 THEN  //HMI command
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE parent like $'WPALLET%$' AND SUB_POS = ',
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletPosition),
	                                                 IN4 := '; UPDATE Pallet SET POS_PLANT=1000 WHERE mag_pos=',
	                                                 IN5 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletPosition));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                            
	                        ELSIF #MCRequested = 1 AND "DB_MC1".order.ID > 0 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE parent like $'WPALLET%$' AND SUB_POS in(select top 1 pos from COORDINATES_FOR_PALLET_WAREHOUSE where status=4 AND PalletID =  ',  //raw
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)),  // .order.ID   Order_ID ....
	                                                 IN4 := ')',
	                                                 IN5 := '; UPDATE Pallet SET POS_PLANT=1000 WHERE id=',
	                                                 IN6 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                            
	                        ELSIF #MCRequested = 2 AND "DB_MC2".order.ID > 0 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE parent like $'WPALLET%$' AND SUB_POS in (select top 1 pos from COORDINATES_FOR_PALLET_WAREHOUSE where status=4 AND PalletID =  ',  //raw
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PALLET)),
	                                                 IN4 := ')',
	                                                 IN5 := '; UPDATE Pallet SET POS_PLANT=1000 WHERE id=',
	                                                 IN6 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PALLET)));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                        END_IF;
	                        
	                    ELSE
	                        //robot finish a release on warehouse
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePalletOnTRAY"] - 10)); //empty
	                        IF #MCRequested = 0 THEN  //HMI command
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE parent like $'WPALLET%$' AND SUB_POS = ',
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletPosition),
	                                                 IN4 := '; UPDATE Pallet SET POS_PLANT=0 WHERE mag_pos=',
	                                                 IN5 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletPosition));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                            
	                        ELSIF #MCRequested = 1 AND "DB_MC1".order.ID > 0 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE id in(select top 1 id from COORDINATES_FOR_PALLET_WAREHOUSE where status=2 AND PalletID= ', //empty
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.PALLET)),
	                                                 IN4 := ')',
	                                                 IN5 := '; UPDATE Pallet SET POS_PLANT=0 WHERE id=',
	                                                 IN6 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletRequested));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                            
	                        ELSIF #MCRequested = 2 AND "DB_MC2".order.ID > 0 THEN
	                            #queryTemp := CONCAT(IN1 := #queryTemp,
	                                                 IN2 := ' WHERE id in(select top 1 id from COORDINATES_FOR_PALLET_WAREHOUSE where status=2 AND PalletID= ', //empty
	                                                 IN3 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC2".order.PALLET)),
	                                                 IN4 := ')',
	                                                 IN5 := '; UPDATE Pallet SET POS_PLANT=0 WHERE id=',
	                                                 IN6 := "INT_TO_STRING_WITHOUT_SIGN"(#PalletRequested));
	                            #queryStartExecution := true;
	                            #Dispatcher["updatePalletOnTRAY"] := 20;
	                        END_IF;
	                        
	                    END_IF;
	                    
	                END_IF;
	                
	            20:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePalletOnTRAY"] := 30;
	                END_IF;
	                
	            30:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["updatePalletOnTRAY"] := 35;
	                END_IF;
	                
	            35:// wait for reset query
	                IF "DB_executeQuery".Dispatch["_master"] = 0 AND "SqlCommands".sqlCommands[0] = '' THEN
	                    #Dispatcher["updatePalletOnTRAY"] := 0;
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION updatePartOnMC
	        //la attivo con dispatcher=10+statoPezzo (RAW,FINISHED)
	        CASE #Dispatcher["updatePartOnMC"] OF
	            0:  // nothing to do
	                ;
	                
	            10..15: // Update DB -----------------------------------------
	                // NOT queryStartExecution (5/10): questa catena la lancia anche FB204
	                // (36, 37, 41, riconciliazione al 50), in modo asincrono. Se nello
	                // stesso scan un'altra catena di FB7 ha appena composto la sua query,
	                // il ponte e' ancora vuoto ma queryTemp e' occupato: non va sovrascritto.
	                IF "SqlCommands".sqlCommands[0] = '' AND NOT #queryStartExecution THEN
	                    #pieceReq := DINT_TO_INT("DB_MC1".order.PIECE);
	                    IF (#MCRequested = 2) THEN
	                        #pieceReq := DINT_TO_INT("DB_MC2".order.PIECE);
	                    END_IF;
	                    // MACCHINA DI DEFAULT MC1 (5/10): a riposo MCRequested vale 0 e la
	                    // UPDATE andava su PARENT 'MC_0%', nessuna riga: il DB non seguiva i
	                    // comandi 36, 37 e 41 del pannello. La cella ha una sola macchina.
	                    #temp := #MCRequested;
	                    IF #temp <= 0 THEN
	                        #temp := 1;
	                    END_IF;
	                    #queryTemp := CONCAT(IN1 := 'UPDATE POSITION SET STATUS=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnMC"] - 10),
	                                         IN3 := ' WHERE PARENT like $'MC_',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#temp),
	                                         IN5 := '%$' AND PARENT NOT LIKE $'%pallet%$' ');  //AND Part_Type='
	                    //IN6 := "INT_TO_STRING_WITHOUT_SIGN"(#pieceReq));
	                    #queryStartExecution := TRUE;
	                    
	                    // REGISTRO PEZZO IN MACCHINA (5/10). EMPTY vuol dire vuota: registro
	                    // a zero. Prima si scriveva order.PIECE anche per EMPTY, e dopo un
	                    // prelievo il 60 di Part_MC_to_Robot azzerava il registro e qui
	                    // tornava subito "pieno".
	                    // Per RAW e FINISHED l'ordine si scrive SOLO a registro vuoto: un
	                    // valore gia' presente l'ha messo chi sa cosa c'e' in morsa (FB204
	                    // prima del deposito, la dichiarazione 36 dal pannello) e l'ordine,
	                    // a riposo, puo' valere zero o essere un altro.
	                    IF #temp = 1 THEN
	                        IF #Dispatcher["updatePartOnMC"] - 10 = DINT_TO_INT("EMPTY") THEN
	                            "DB_MC1".piecepresent[1] := 0;
	                        ELSIF "DB_MC1".piecepresent[1] = 0 THEN
	                            "DB_MC1".piecepresent[1] := DINT_TO_INT("DB_MC1".order.PIECE);
	                        END_IF;
	                    ELSIF #temp = 2 THEN
	                        IF #Dispatcher["updatePartOnMC"] - 10 = DINT_TO_INT("EMPTY") THEN
	                            "DB_MC2".piecepresent[1] := 0;
	                        ELSIF "DB_MC2".piecepresent[1] = 0 THEN
	                            "DB_MC2".piecepresent[1] := DINT_TO_INT("DB_MC2".order.PIECE);
	                        END_IF;
	                    END_IF;
	                    
	                    #Dispatcher["updatePartOnMC"] := 20;
	                END_IF;
	            20:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePartOnMC"] := 30;
	                END_IF;
	                
	            21..25: // deposito PALLET in macchina -> POS_PLANT=100+MC
	                // STATO DI LAVORO FUORI RANGE (17/9): questo ramo deve uscire dal
	                // proprio range prima di attendere il ponte. Prima, se
	                // sqlCommands[0] era occupata dalla query di un'altra catena, la
	                // guardia era falsa, il registro restava a 2x e NESSUNO lo faceva
	                // avanzare: il ramo e' il suo stesso stato di attesa, quindi non
	                // veniva mai piu' rivalutato con esito utile. Visto in campo col
	                // pallet appena montato: registro fermo a 24, query gia' nel ponte,
	                // catena morta e ciclo bloccato prima dello start lavorazione.
	                // Con il salto al 26 la composizione avviene una volta sola, quando
	                // il ponte e' libero, e l'attesa ha uno stato suo.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #RemoteMode THEN
	                        #pieceReq := #PalletRequested;
	                    ELSE
	                        #pieceReq := DINT_TO_INT("DB_MC1".order.PALLET);
	                    END_IF;
	                    #queryTemp := CONCAT(IN1 := 'UPDATE POSITION SET STATUS=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnMC"] - 20),
	                                         IN3 := ' WHERE PARENT like $'MC_',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#MCRequested),
	                                         IN5 := '%$' AND PARENT NOT LIKE $'%pallet%$'; UPDATE Pallet SET POS_PLANT=',
	                                         IN6 := "INT_TO_STRING_WITHOUT_SIGN"(100 + #MCRequested),
	                                         IN7 := ' WHERE ID=',
	                                         IN8 := "INT_TO_STRING_WITHOUT_SIGN"(#pieceReq));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["updatePartOnMC"] := 26;
	                END_IF;
	                
	            26:  // attesa presa in carico della query pallet (stato fuori dai range)
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePartOnMC"] := 30;
	                END_IF;
	                
	            30:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["updatePartOnMC"] := 0;
	                END_IF;
	                
	            31..35: // prelievo PALLET da macchina -> POS_PLANT=1000
	                // stesso difetto e stessa correzione del 21..25: si esce dal
	                // proprio range prima di mettersi in attesa del ponte.
	                //
	                // IL PALLET E' QUELLO IN MACCHINA, NON QUELLO DELL'ORDINE (18/9).
	                // In automatico si leggeva order.PALLET, che a FINE PRODUZIONE
	                // vale zero: l'ordine e' chiuso o riallineato, e la UPDATE usciva
	                // con WHERE ID=0 senza toccare niente. Il pallet restava a
	                // POS_PLANT=101 (in macchina) mentre era in pinza, e il sistema
	                // non sapeva piu' dov'era. Visto in campo smontando il pallet 9 a
	                // produzione conclusa.
	                // Il registro DB_MC1.pallet dice cosa c'era fisicamente dentro, ed
	                // e' l'unica fonte valida qui: e' lo stesso registro che il 60
	                // azzera subito dopo, proprio perche' il pallet e' uscito.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #RemoteMode THEN
	                        #pieceReq := #PalletRequested;
	                    ELSIF #MCRequested = 2 THEN
	                        #pieceReq := "DB_MC2".pallet;
	                    ELSE
	                        #pieceReq := "DB_MC1".pallet;
	                    END_IF;
	                    #queryTemp := CONCAT(IN1 := 'UPDATE POSITION SET STATUS=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["updatePartOnMC"] - 30),
	                                         IN3 := ' WHERE PARENT like $'MC_',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#MCRequested),
	                                         IN5 := '%$' AND PARENT NOT LIKE $'%pallet%$'; UPDATE Pallet SET POS_PLANT=1000 WHERE ID=',
	                                         IN6 := "INT_TO_STRING_WITHOUT_SIGN"(#pieceReq));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["updatePartOnMC"] := 36;
	                END_IF;
	                
	            36:  // attesa presa in carico della query pallet (stato fuori dai range)
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePartOnMC"] := 30;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION updatePartOnTray
	        //Activated with dispatcher=10+statusPart (RAW,FINISHED)
	        CASE #Dispatcher["updatePartOnTray"] OF
	            0:  // nothing to do
	                ;
	                
	            12: // Update DB with EMPTY part
	                // MC1 E' IL DEFAULT (18/9): vedi la nota estesa al 15. La forma
	                // "IF MCRequested = 1 THEN MC1 ELSE MC2" prende DB_MC2.order.ID —
	                // sempre zero in questa cella — ogni volta che MCRequested non e'
	                // esattamente 1, e il 95 substate 0 di FB204 lo azzera prima di
	                // lanciare il deposito. Qui #temp non finisce in nessuna query,
	                // quindi non fa danni: si allinea per non lasciare tre forme
	                // diverse nello stesso blocco.
	                IF #MCRequested = 2 THEN
	                    #temp := DINT_TO_INT("DB_MC2".order.ID);
	                ELSE
	                    #temp := DINT_TO_INT("DB_MC1".order.ID);
	                END_IF;
	                
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    // UGUAGLIANZA, NON LIKE (16/9): 'TRAY_1%' prendeva anche TRAY_10,
	                    // TRAY_11 e TRAY_12 -> quattro cassetti aggiornati insieme. Con i
	                    // cassetti 1-9 il difetto era invisibile; con l'1 in gioco insieme
	                    // ai due cifre ha riscritto TRAY_1 e TRAY_12 in parallelo.
	                    IF NOT #RemoteMode AND #PartSubPos > 0 THEN   // HMI: posizione esatta, nessun ordine
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=2 WHERE PARENT=$'TRAY_',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                             IN3 := '$' AND SUB_POS=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["updatePartOnTray"] := 20;
	                    ELSE
	                        // AUTOMATICO: svuota la tasca da cui il robot ha appena prelevato
	                        // (SUB_POS congelato), non la prima con un grezzo.
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=2 WHERE PARENT=$'TRAY_',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                             IN3 := '$' AND SUB_POS=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["updatePartOnTray"] := 20;
	                    END_IF;
	                END_IF;
	                
	            15: // Update DB with FINISHED part
	                // MC1 E' IL DEFAULT (18/9). La forma "IF MCRequested = 1 THEN MC1
	                // ELSE MC2" leggeva DB_MC2.order.ID — che in questa cella vale
	                // SEMPRE zero — ogni volta che MCRequested non era esattamente 1.
	                // E il 95 substate 0 di FB204 lo AZZERA prima di lanciare il
	                // deposito del finito:
	                //     "DB_Robot".MissionCode := "MISSION_UnloadPartFromRobot";
	                //     "DB_Robot".MCRequested := 0;
	                // Quindi #temp usciva a zero proprio sul percorso del ciclo a
	                // missione 16, e con lui sia Order_ID sulla tasca sia il
	                // congelamento di OrderIdMC.
	                // Visto in campo sul 1102: pezzi alternati, uno con Order_ID
	                // corretto (deposito dal 52/58, dove MCRequested resta a 1) e uno
	                // con zero (deposito dal 95 substate 0).
	                IF #MCRequested = 2 THEN
	                    #temp := DINT_TO_INT("DB_MC2".order.ID);
	                ELSE
	                    #temp := DINT_TO_INT("DB_MC1".order.ID);
	                END_IF;
	                
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF NOT #RemoteMode AND #PartSubPos > 0 THEN   // HMI: posizione esatta; il pezzo torna com'era (RAW)
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=4 WHERE PARENT=$'TRAY_',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                             IN3 := '$' AND SUB_POS=',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPos));
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["updatePartOnTray"] := 20;
	                    ELSE
	                        // AUTOMATICO: marca finita la tasca del grezzo entrato in macchina
	                        // (PartSubPosMC), non quella del grezzo prelevato per il ciclo dopo.
	                        //
	                        // ORDER_ID SCRITTO QUI (18/9): fino a oggi lo scriveva SOLO il
	                        // comando 39 dal pannello, alla dichiarazione manuale della
	                        // tasca. Il ciclo automatico cambiava STATUS e lasciava
	                        // Order_ID com'era — zero se nessuno aveva dichiarato, oppure
	                        // dell'ordine PRECEDENTE se la tasca veniva riusata.
	                        // PRODUCTED della vista WORKORDERS conta le tasche a 5
	                        // raggruppate per Order_ID, quindi contava i pezzi dichiarati
	                        // a mano, non quelli prodotti.
	                        //
	                        // SI USA L'ORDINE CONGELATO (OrderIdMC), non quello attivo:
	                        // il pezzo appartiene all'ordine che lo ha LAVORATO, che col
	                        // ciclo a missione 16 puo' non essere piu' quello corrente
	                        // quando il finito torna nel cassetto.
	                        // Ripiego su #temp quando OrderIdMC e' zero: capita al primo
	                        // giro dopo un reinit o un reset, e li' l'ordine corrente e'
	                        // l'unica ipotesi sensata — meglio di perdere il pezzo con
	                        // Order_ID=0, che nessun conteggio vedrebbe.
	                        IF #OrderIdMC > 0 THEN
	                            #declMap := #OrderIdMC;
	                        ELSE
	                            #declMap := #temp;
	                        END_IF;
	                        #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=5, Order_ID=',
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#declMap),
	                                             IN3 := ' WHERE PARENT=$'TRAY_',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#TrayIdMC),
	                                             IN5 := '$' AND SUB_POS=',
	                                             IN6 := "INT_TO_STRING_WITHOUT_SIGN"(#PartSubPosMC));
	                        
	                        // ULTIMO USO di PartSubPosMC, TrayIdMC e OrderIdMC per questo
	                        // pezzo: da qui in poi descrivono il grezzo appena entrato.
	                        // Il congelamento va fatto QUI perche' la missione 16 non
	                        // passa da Part_Robot_to_MC (dove avviene l'altro).
	                        #PartSubPosMC := #PartSubPos;
	                        #TrayIdMC := #Tray_ID;
	                        
	                        // L'ORDINE SI CONGELA SOLO SE E' VALIDO: uno zero non
	                        // descrive niente e cancellerebbe il valore buono del giro
	                        // precedente. Cintura in piu' oltre al default MC1 qui sopra.
	                        IF #temp > 0 THEN
	                            #OrderIdMC := #temp;
	                        END_IF;
	                        
	                        #queryStartExecution := TRUE;
	                        
	                        #Dispatcher["updatePartOnTray"] := 20;
	                    END_IF;
	                END_IF;
	                
	            17: // Update DB with ABORTED part
	                // MC1 E' IL DEFAULT (18/9): vedi la nota al 15.
	                // NB: questo ramo e' CODICE MORTO — updatePartOnTray viene lanciato
	                // solo con 12 (10+EMPTY) e 15 (10+FINISHED), nessuno scrive mai 17.
	                // Resta per quando servira' tracciare gli scarti, ma oggi non gira.
	                IF #MCRequested = 2 THEN
	                    #temp := DINT_TO_INT("DB_MC2".order.ID);
	                ELSE
	                    #temp := DINT_TO_INT("DB_MC1".order.ID);
	                END_IF;
	                
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=7 WHERE PARENT=$'TRAY_',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                         IN3 := '$' AND id in (select top 1 id from position where parent=$'TRAY_',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#Tray_ID),
	                                         IN5 := '$' AND Status=2 ',     //first empty position
	                                         IN6 := 'AND Order_ID=',
	                                         IN7 := "INT_TO_STRING_WITHOUT_SIGN"(#temp),
	                                         IN8 := ')');
	                    #queryStartExecution := TRUE;
	                    
	                    #Dispatcher["updatePartOnTray"] := 20;
	                END_IF;
	                
	            20:  // execute query
	                IF NOT "DB_executeQuery".readyForNextQuery THEN
	                    #Dispatcher["updatePartOnTray"] := 30;
	                END_IF;
	            30:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    
	                    #Dispatcher["updatePartOnTray"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	    REGION Reset or log mission
	        CASE #Dispatcher["Reset_or_log_MissionData"] OF
	            0: //nothing to do
	                ;
	            10: //reset mission data ***START HERE***
	                "DB_RobotMission"."Command" := 0;
	                "DB_RobotMission"."X_Pick-Place" := 0;
	                "DB_RobotMission"."Y_Pick-Place" := 0;
	                "DB_RobotMission"."Z_Pick-Place" := 0;
	                "DB_RobotMission"."XRot_Pick-Place" := 0;
	                "DB_RobotMission"."YRot_Pick-Place" := 0;
	                "DB_RobotMission"."ZRot_Pick-Place" := 0;
	                "DB_RobotMission"."Gripper_code" := 0;
	                "DB_RobotMission"."Gripper1_XDim" := 0;
	                "DB_RobotMission"."Gripper1_YDim" := 0;
	                "DB_RobotMission"."Gripper1_ZDim" := 0;
	                "DB_RobotMission"."Gripper1_XRotDim" := 0;
	                "DB_RobotMission"."Gripper1_YRotDim" := 0;
	                "DB_RobotMission"."Gripper1_ZRotDim" := 0;
	                "DB_RobotMission".Gripper1_Valve := 0;
	                "DB_RobotMission"."Gripper2_XDim" := 0;
	                "DB_RobotMission"."Gripper2_YDim" := 0;
	                "DB_RobotMission"."Gripper2_ZDim" := 0;
	                "DB_RobotMission"."Gripper2_XRotDim" := 0;
	                "DB_RobotMission"."Gripper2_YRotDim" := 0;
	                "DB_RobotMission"."Gripper2_ZRotDim" := 0;
	                "DB_RobotMission".Gripper2_Valve := 0;
	                "DB_RobotMission"."X_approach" := 0;
	                "DB_RobotMission"."Y_approach" := 0;
	                "DB_RobotMission"."Z_approach" := 0;
	                "DB_RobotMission"."XRot_approach" := 0;
	                "DB_RobotMission"."YRot_approach" := 0;
	                "DB_RobotMission"."ZRot_approach" := 0;
	                "DB_RobotMission"."ApproachType" := 0;
	                "DB_RobotMission"."Unit_code" := 0;
	                "DB_RobotMission"."Object_Type" := 0;
	                "DB_RobotMission"."Gripper_Side" := 0;
	                
	                #Dispatcher["Reset_or_log_MissionData"] := 0;
	                
	            100://save data mission on log DB
	                //prepare mission data ***START HERE***
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF "DB_RobotMission"."XRot_Pick-Place" = "CMD_RobotChangeDataForGripper" THEN
	                        #queryTemp := CONCAT(IN1 := 'INSERT INTO LOG ([DATA], DESCR, UNIT_A, UNIT_B) VALUES(getDate()',
	                                             IN2 := '$'Robot_MISSION$',',
	                                             IN3 := '$'',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(IN := "DB_RobotMission".Command),
	                                             IN5 := '$',',
	                                             IN6 := '$'',
	                                             IN7 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_XDim)),
	                                             IN8 := ', ',
	                                             IN9 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_YDim)),
	                                             IN10 := ', ',
	                                             IN11 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_ZDim)),
	                                             IN12 := ', ',
	                                             IN13 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_XRotDim)),
	                                             IN14 := ', ',
	                                             IN15 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_YRotDim)),
	                                             IN16 := ', ',
	                                             IN17 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper1_ZRotDim)),
	                                             IN18 := ', ',
	                                             IN19 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_XDim)),
	                                             IN20 := ', ',
	                                             IN21 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_YDim)),
	                                             IN22 := ', ',
	                                             IN23 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_ZDim)),
	                                             IN24 := ', ',
	                                             IN25 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_XRotDim)),
	                                             IN26 := ', ',
	                                             IN27 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_YRotDim)),
	                                             IN28 := ', ',
	                                             IN29 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper2_ZRotDim)),
	                                             IN30 := '$'');
	                    ELSE
	                        #queryTemp := CONCAT(IN1 := 'INSERT INTO LOG ([DATA], DESCR, UNIT_A, UNIT_B) VALUES(getDate()',
	                                             IN2 := '$'Robot_MISSION$',',
	                                             IN3 := '$'',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(IN := "DB_RobotMission".Command),
	                                             IN5 := '$',',
	                                             IN6 := '$'',
	                                             IN7 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."X_Pick-Place")),
	                                             IN8 := ', ',
	                                             IN9 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."Y_Pick-Place")),
	                                             IN10 := ', ',
	                                             IN11 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."Z_Pick-Place")),
	                                             IN12 := ', ',
	                                             IN13 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."XRot_Pick-Place")),
	                                             IN14 := ', ',
	                                             IN15 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."YRot_Pick-Place")),
	                                             IN16 := ', ',
	                                             IN17 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission"."ZRot_Pick-Place")),
	                                             IN18 := ', ',
	                                             IN19 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".ApproachType)),
	                                             IN20 := ', ',
	                                             IN21 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Unit_code)),
	                                             IN22 := ', ',
	                                             IN23 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".X_approach)),
	                                             IN24 := ', ',
	                                             IN25 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Y_approach)),
	                                             IN26 := ', ',
	                                             IN27 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Z_approach)),
	                                             IN28 := ', ',
	                                             IN29 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Object_Type)),
	                                             IN30 := ', ');
	                        
	                        #queryTemp := CONCAT(IN1 := #queryTemp,
	                                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Gripper_Side)),
	                                             IN3 := ', ',
	                                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_RobotMission".Object_Type)),
	                                             IN5 := '$'');
	                    END_IF;
	                    #queryStartExecution := TRUE;
	                    
	                    #Dispatcher["Reset_or_log_MissionData"] := 115;
	                END_IF;
	            115:  //execute query
	                IF NOT "DB_executeQuery".dataReady THEN
	                    #Dispatcher["Reset_or_log_MissionData"] := 120;
	                END_IF;
	                
	            120: //wait anwser
	                IF "DB_executeQuery".dataReady THEN //AND NOT "DB_executeQuery".dataError
	                    #Dispatcher["Reset_or_log_MissionData"] := 0;
	                    (*ELSIF "DB_executeQuery".dataError THEN
	                        //Error
	                        #Error := 999;
	                        #Dispatcher["Reset_or_log_MissionData"] := 99;
	                        *)
	                END_IF;
	                
	        END_CASE;
	    END_REGION
	    
	    REGION Declare_Position
	        CASE #Dispatcher["_Declare_Position"] OF
	            0:  // nothing to do
	                ;
	            10: // UPDATE della singola tasca del cassetto estratto.
	                // Order_ID all'ordine attivo per lo stato 4 (grezzo): senza, la
	                // tasca non verrebbe mai vista dalle query del ciclo automatico.
	                // UGUAGLIANZA, NON LIKE (16/9): con il LIKE il cassetto 1 avrebbe
	                // aggiornato anche 10, 11 e 12.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET STATUS=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#declStato),
	                                         IN3 := ', Order_ID=',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(DINT_TO_INT("DB_MC1".order.ID)),
	                                         IN5 := ' WHERE PARENT=$'TRAY_',
	                                         IN6 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                         IN7 := '$' AND SUB_POS=',
	                                         IN8 := "INT_TO_STRING_WITHOUT_SIGN"(#declSubPos));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Declare_Position"] := 20;
	                END_IF;
	                
	            15: // TIPO PEZZO dell'intero cassetto estratto (comando 44).
	                // Un cassetto contiene un solo tipo, quindi si dichiara in blocco:
	                // dichiararlo tasca per tasca sarebbe dodici click e l'operatore
	                // smetterebbe di farlo. Part_Type e' il campo che decide cosa il
	                // robot va a prendere (16/9), quindi vale per tutte le tasche.
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    #queryTemp := CONCAT(IN1 := 'UPDATE [POSITION] SET Part_Type=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#declTipo),
	                                         IN3 := ' WHERE PARENT=$'TRAY_',
	                                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                         IN5 := '$'');
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Declare_Position"] := 20;
	                END_IF;
	                
	            20:  // presa in carico VERIFICATA: SqlData e il ponte sono condivisi,
	                // non basta che il ponte sia occupato — deve esserci LA NOSTRA
	                // query, altrimenti il 30 chiude sulla risposta di un altro
	                // richiedente e l'UPDATE della tasca non e' mai partito.
	                IF NOT "DB_executeQuery".readyForNextQuery
	                    AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                    #Dispatcher["_Declare_Position"] := 30;
	                END_IF;
	                
	            30:  // wait result
	                IF "DB_executeQuery".dataReady THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    IF #declTipo > 0 THEN
	                        "FC_MQTT"(insert := true,
	                                  send := false,
	                                  topic := 'FROM_PLANT/DECLARE/TRAYTYPE',
	                                  payload := STRING_TO_WSTRING(CONCAT(IN1 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                                                                                   IN2 := ';',
	                                                                                                   IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#declTipo))));
	                        #declTipo := 0;
	                    ELSE
	                        "FC_MQTT"(insert := true,
	                                  send := false,
	                                  topic := 'FROM_PLANT/DECLARE/TRAY',
	                                  payload := STRING_TO_WSTRING(CONCAT(IN1 := "INT_TO_STRING_WITHOUT_SIGN"("DB_BOX_1".ExtractedTray),
	                                                                                                   IN2 := ';',
	                                                                                                   IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#declSubPos),
	                                                                                                   IN4 := ';',
	                                                                                                   IN5 := "INT_TO_STRING_WITHOUT_SIGN"(#declStato))));
	                    END_IF;
	                    #Dispatcher["_Declare_Position"] := 0;
	                ELSIF "DB_executeQuery".dataError THEN
	                    #Error := 20007;
	                    #declTipo := 0;
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Dispatcher["_Declare_Position"] := 0;
	                END_IF;
	        END_CASE;
	    END_REGION
	    
	END_REGION
	
	REGION Declare_State
	    CASE #Dispatcher["_Declare_State"] OF
	        0: //nothing to do
	            ;
	        10: // tabula rasa (indice 31 escluso dal reset per costruzione)
	            #RESET_ALL_DISPATCH := TRUE;
	            #Dispatcher["_Declare_State"] := 15;
	        15: // validazione presenza pinza vs sensore
	            IF (#declGripper > 0) XOR "Gripper_mounted" THEN
	                #Error := 945;   // dichiarazione incoerente col sensore pinza
	                #Dispatcher["_Declare_State"] := 945;
	            ELSIF #declCont1 = 3 AND #declCont2 = 3 THEN
	                #Error := 944;   // pallet dichiarato su entrambi i lati: impossibile
	                #Dispatcher["_Declare_State"] := 944;
	            ELSIF #declGripper = 0 THEN
	                // flangia nuda dichiarata e confermata: azzera e chiudi
	                #Gripper_ID[1] := 0;
	                #Gripper_ID[2] := 0;
	                #GripperOccuped[1] := FALSE;
	                #GripperOccuped[2] := FALSE;
	                #Dispatcher["updateGripperOnRobot"] := 10;
	                #Dispatcher["_Declare_State"] := 70;
	            ELSE
	                #Dispatcher["_Declare_State"] := 20;
	            END_IF;
	        20: // query lato 2 (gemella sullo stesso SUB_POS; include se stessa per garantire >=1 riga)
	            // Serve QUI solo per VALIDARE declCont2: la scrittura dei registri la
	            // fa la catena unica al 40.
	            IF "SqlCommands".sqlCommands[0] = '' THEN
	                #queryTemp := CONCAT(IN1 := 'select ID from GRIPPER where ID=',
	                                     IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#declGripper),
	                                     IN3 := ' or (SUB_POS>0 and SUB_POS in (select SUB_POS from GRIPPER where ID=',
	                                     IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#declGripper),
	                                     IN5 := '))');
	                #queryStartExecution := TRUE;
	                #Dispatcher["_Declare_State"] := 25;
	            END_IF;
	        25: // presa in carico query (pattern FB204: conferma che in [0] c'e' LA NOSTRA query)
	            IF NOT "DB_executeQuery".readyForNextQuery
	                AND "SqlCommands".sqlCommands[0] = #queryTemp THEN
	                #Dispatcher["_Declare_State"] := 30;
	            END_IF;
	        30: // validazione: il lato 2 dichiarato esiste davvero?
	            IF "DB_executeQuery".dataReady AND "DB_executeQuery".noData THEN
	                // pinza dichiarata inesistente a DB: con FB6 corretto "zero righe"
	                // non e' piu' dataError, va intercettato qui.
	                "DB_executeQuery".readyForNextQuery := TRUE;
	                #Error := 946;   // errore DB in dichiarazione
	                #Dispatcher["_Declare_State"] := 946;
	            ELSIF "DB_executeQuery".dataReady AND NOT "DB_executeQuery".dataError THEN
	                IF "SqlData".data.rowCount <= 1 AND #declCont2 > 0 THEN
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #Error := 944;   // contenuto dichiarato su lato inesistente
	                    #Dispatcher["_Declare_State"] := 944;
	                ELSE
	                    "DB_executeQuery".readyForNextQuery := TRUE;
	                    #queryTemp := '';
	                    #queryStartExecution := FALSE;
	                    #GripperOccuped[1] := #declCont1 > 0;
	                    #GripperOccuped[2] := #declCont2 > 0;
	                    #Dispatcher["_Declare_State"] := 40;
	                END_IF;
	            ELSIF "DB_executeQuery".dataError THEN
	                "DB_executeQuery".readyForNextQuery := TRUE;
	                #Error := 946;   // errore DB in dichiarazione
	                #Dispatcher["_Declare_State"] := 946;
	            END_IF;
	        40: // registri + database alla catena unica (17/9)
	            #GripperRequested := #declGripper;
	            #Dispatcher["_Set_Gripper_OnBoard"] := 10;
	            #Dispatcher["_Declare_State"] := 45;
	        45:
	            IF #Dispatcher["_Set_Gripper_OnBoard"] = 0 THEN
	                IF #robotInPendant THEN
	                    // SOTTO PENDANT (5/10): il manager ha gia' verificato che la pinza e'
	                    // quella registrata, quindi il robot ne ha gia' le misure. Il comando 10
	                    // al robot (get_TCP_Data) non si da': col robot in manuale non lo prende.
	                    #Dispatcher["_Declare_State"] := 55;
	                ELSE
	                    #Dispatcher["get_TCP_Data"] := 10;
	                    #Dispatcher["_Declare_State"] := 50;
	                END_IF;
	            END_IF;
	        50: // TCP aggiornato al robot
	            IF #Dispatcher["get_TCP_Data"] = 0 THEN
	                #Dispatcher["_Declare_State"] := 55;
	            END_IF;
	        55: // stato lato 1
	            CASE #declCont1 OF
	                1:
	                    #declMap := DINT_TO_INT("RAW");
	                2:
	                    #declMap := DINT_TO_INT("FINISHED");
	                3:
	                    // PALLET: RAW come il resto del sistema (18/9). LOADED=1 non e'
	                    // interrogato da nessuna vista ne' da nessun filtro del ciclo,
	                    // che cercano tutti STATUS=4: un pallet dichiarato LOADED era
	                    // invisibile. Il 50 di Pallet_TRAY_to_Robot lo scrive RAW da
	                    // sempre — "il pallet lo considero grezzo cosi' va in macchina".
	                    #declMap := DINT_TO_INT("RAW");
	                ELSE
	                    #declMap := DINT_TO_INT("EMPTY");
	            END_CASE;
	            "DB_RobotMission".Gripper_Side := 1;
	            #Dispatcher["updatePartOnRobot"] := 10 + #declMap;
	            #Dispatcher["_Declare_State"] := 60;
	        60:
	            IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                IF #Gripper_ID[2] > 0 THEN
	                    CASE #declCont2 OF
	                        1:
	                            #declMap := DINT_TO_INT("RAW");
	                        2:
	                            #declMap := DINT_TO_INT("FINISHED");
	                        3:
	                            // pallet: RAW, vedi nota al 55
	                            #declMap := DINT_TO_INT("RAW");
	                        ELSE
	                            #declMap := DINT_TO_INT("EMPTY");
	                    END_CASE;
	                    #Dispatcher["updatePartOnRobot"] := 20 + #declMap;
	                    #Dispatcher["_Declare_State"] := 65;
	                ELSE
	                    #Dispatcher["_Declare_State"] := 68;
	                END_IF;
	            END_IF;
	        65:
	            IF #Dispatcher["updatePartOnRobot"] = 0 THEN
	                #Dispatcher["_Declare_State"] := 68;
	            END_IF;
	        68: // pallet a bordo -> POS_PLANT=1000
	            IF #declCont1 = 3 OR #declCont2 = 3 THEN
	                IF "SqlCommands".sqlCommands[0] = '' THEN
	                    IF #declCont1 = 3 THEN
	                        #declMap := #declId1;
	                    ELSE
	                        #declMap := #declId2;
	                    END_IF;
	                    #queryTemp := CONCAT(IN1 := 'UPDATE Pallet SET POS_PLANT=1000 WHERE ID=',
	                                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#declMap));
	                    #queryStartExecution := TRUE;
	                    #Dispatcher["_Declare_State"] := 69;
	                END_IF;
	            ELSE
	                #Dispatcher["_Declare_State"] := 70;
	            END_IF;
	        69:
	            IF NOT "DB_executeQuery".readyForNextQuery THEN
	                #Dispatcher["_Declare_State"] := 695;
	            END_IF;
	        695:
	            IF "DB_executeQuery".dataReady THEN
	                "DB_executeQuery".readyForNextQuery := TRUE;
	                #Dispatcher["_Declare_State"] := 70;
	            END_IF;
	        70: // chiusura + riepilogo
	            IF #Dispatcher["updateGripperOnRobot"] = 0 THEN
	                "FC_MQTT"(insert := true,
	                          send := false,
	                          topic := 'FROM_PLANT/DECLARE/ROBOT',
	                          payload := STRING_TO_WSTRING(CONCAT(IN1 := "INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1]),
	                                                                                           IN2 := ';',
	                                                                                           IN3 := "INT_TO_STRING_WITHOUT_SIGN"(#declCont1),
	                                                                                           IN4 := ';',
	                                                                                           IN5 := "INT_TO_STRING_WITHOUT_SIGN"(#declCont2))));
	                #MissionCode := 0;
	                #Dispatcher["_Declare_State"] := 0;
	            END_IF;
	        944, 945, 946:
	            // RIFIUTO DELLA DICHIARAZIONE (7/10): 944 contenuto su un lato inesistente
	            // o pallet su due lati, 945 incoerenza col sensore pinza, 946 errore DB.
	            // Fino al 7/10 la catena restava parcheggiata qui: l'indice 31 e'
	            // ritentivo e nessun reset lo azzerava, quindi la supervisione 938
	            // (inibita con Declare_State <> 0) restava spenta anche dopo il RESET
	            // (simulazione 7/10, problema 14). Adesso un ciclo solo: il codice va su
	            // ALARM/ROBOT, dove il pannello lo aspetta per chiudere l'attesa dell'eco
	            // (prima vedeva solo il timeout), e si torna a 0. Error resta alzato
	            // fino al RESET.
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/ALARM/ROBOT',
	                      payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher["_Declare_State"])));
	            #Dispatcher["_Declare_State"] := 0;
	    END_CASE;
	END_REGION
	
	REGION execute query
	    // IF "DB_executeQuery".dataReady AND "DB_executeQuery".readyForNextQuery THEN
	    (*
	    "DB_executeQuery"(query := #queryTemp,
	                      params := #paramsTemp,
	                      exec := #queryStartExecution);
	    #queryStartExecution := false;
	    //#queryTemp := '';
	 *)
	 // END_IF;
	END_REGION
	
	REGION updateHMI
	    //inconsistency datas and sensors
	    IF "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd" AND
	        (
	        (#GripperOccuped[1] XOR "DB_RobotMissionStatus".StatusRegister.Gripper1_occuped) OR
	        (#GripperOccuped[2] XOR "DB_RobotMissionStatus".StatusRegister.Gripper2_occuped)
	        ) THEN
	        IF NOT #checkInconsistenceFailed THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/ALARM/ROBOT',
	                      payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(23)));
	            #checkInconsistenceFailed := true;
	        END_IF;
	    ELSE
	        #checkInconsistenceFailed := false;
	    END_IF;
	    
	    //Mission
	    IF (#MissionCode <> #lastMission) THEN
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/LOG/MISSION/ROBOT',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#MissionCode)));
	        
	        #lastMission := #MissionCode;
	        
	        //change description of robot mission
	        IF #Dispatcher["_Gripper_TRAY_to_Robot"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Drop Gripper'));
	        ELSIF #Dispatcher["_Gripper_Robot_to_TRAY"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Pick Gripper'));
	        ELSIF #Dispatcher["_Pallet_TRAY_to_Robot"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Pick Pallet'));
	        ELSIF #Dispatcher["_Pallet_Robot_to_TRAY"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Drop Pallet'));
	        ELSIF #Dispatcher["_Pallet_MC_to_Robot"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Pick Pallet from MC'));
	        ELSIF #Dispatcher["_Pallet_Robot_to_MC"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Drop Pallet on MC'));
	        ELSIF #Dispatcher["_Part_TRAY_to_Robot"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Pick Part'));
	        ELSIF #Dispatcher["_Part_Robot_to_TRAY"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Drop Part'));
	        ELSIF #Dispatcher["_Part_Robot_to_MC"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Drop Part on Machine'));
	        ELSIF #Dispatcher["_Part_MC_to_Robot"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Pick Part from Machine'));
	        ELSIF #Dispatcher["_Declare_Position"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Declare Tray Position'));
	        ELSIF #Dispatcher["Extract_TRAY"] > 0 OR #Dispatcher["Extract_TRAY_HMI"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Extract Tray'));
	        ELSIF #Dispatcher["Release_TRAY"] > 0 OR #Dispatcher["Release_TRAY_HMI"] > 0 THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Release Tray'));
	        ELSIF #MissionCode = "MISSION_SwapGripper" THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING('Swap Gripper'));
	        ELSE
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/DESCR/ROBOT',
	                      payload := STRING_TO_WSTRING(''));
	        END_IF;
	        
	    END_IF;
	    
	    //Dispatchers value
	    // GRIPPER/ROBOT NEL REFRESH (5/10, concordato 24/7): era l'unico one-shot
	    // che il 90 non ripubblicava. Va accodato DOPO i 32 DISPATCH: il refresh
	    // ne inserisce piu' di quanti il buffer d'invio (11 posti, circolare) ne
	    // tenga, e sopravvivono solo gli ultimi. Il 90 mette Dispatcher_old a -1:
	    // lo si annota in #temp prima che il FOR lo riallinei.
	    #temp := 0;
	    IF #Dispatcher_old[31] = -1 THEN
	        #temp := 1;
	    END_IF;
	    FOR #i := 0 TO 31 DO
	        IF #Dispatcher_old[#i] <> #Dispatcher[#i] THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := CONCAT(IN1 := 'FROM_PLANT/DISPATCH/ROBOT/', IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#i)),
	                      payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Dispatcher[#i])));
	            
	            #Dispatcher_old[#i] := #Dispatcher[#i];
	        END_IF;
	    END_FOR;
	    IF #temp = 1 THEN
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/GRIPPER/ROBOT',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(#Gripper_ID[1])));
	    END_IF;
	    
	END_REGION
	
	REGION resetDispatcher
	    (*IF NOT #RemoteMode OR ("DB_MQTT".lastTopicReceived = 'ROBOT' AND "DB_MQTT".lastCmdReceived > "CMD_RobotReset") THEN*)
	    IF #RESET_ALL_DISPATCH OR "Start_AUX" OR "ResetAreaRobot" THEN
	        #Dispatcher["_master"] := 0;
	        #Dispatcher["_Pallet_TRAY_to_Robot"] := 0;
	        #Dispatcher["_Pallet_Robot_to_TRAY"] := 0;
	        #Dispatcher["_Pallet_Robot_to_MC"] := 0;
	        #Dispatcher["_Pallet_MC_to_Robot"] := 0;
	        #Dispatcher["_Part_TRAY_to_Robot"] := 0;
	        #Dispatcher["_Part_Robot_to_TRAY"] := 0;
	        #Dispatcher["_Part_Robot_to_MC"] := 0;
	        #Dispatcher["_Part_MC_to_Robot"] := 0;
	        #Dispatcher["_Set_Gripper_OnBoard"] := 0;   // ex _Vice_TRAY_to_Robot (17/9)
	        #Dispatcher["_Vice_Robot_to_TRAY"] := 0;
	        #Dispatcher["_Vice_Robot_to_MC"] := 0;
	        #Dispatcher["_Vice_MC_to_Robot"] := 0;
	        #Dispatcher["_Gripper_TRAY_to_Robot"] := 0;
	        #Dispatcher["_Gripper_Robot_to_TRAY"] := 0;
	        #Dispatcher["_Gripper_Hook_Search"] := 0;
	        #Dispatcher["_Gripper4Pallet_Search"] := 0;
	        #Dispatcher["updatePartOnTray"] := 0;
	        #Dispatcher["Extract_TRAY"] := 0;
	        #Dispatcher["Release_TRAY"] := 0;
	        #Dispatcher["change_TCP_Data"] := 0;
	        #Dispatcher["get_TCP_Data"] := 0;
	        #Dispatcher["updateGripperOnRobot"] := 0;
	        #Dispatcher["updatePartOnRobot"] := 0;
	        #Dispatcher["updatePartOnMC"] := 0;
	        #Dispatcher["updatePalletOnTRAY"] := 0;
	        #Dispatcher["Extract_TRAY_HMI"] := 0;
	        #Dispatcher["Release_TRAY_HMI"] := 0;
	        #Dispatcher["executeOneQuery"] := 0;
	        #Dispatcher["Reset_or_log_MissionData"] := 0;
	        #Dispatcher["_Declare_Position"] := 0;
	        // DICHIARAZIONE DELLO STATO CELLA (7/10): si azzera anche lei, ma solo da 20
	        // in su. Il 10 del Declare_State alza RESET_ALL_DISPATCH e passa al 15 nello
	        // stesso ciclo, prima di questa REGION: la dichiarazione appena partita deve
	        // proseguire. Da 20 in su e' una dichiarazione rimasta a meta' (ponte SQL,
	        // catena dei registri), che RESET, comandi di movimento e AUX chiudono come
	        // le altre catene (simulazione 7/10, problema 14). L'indice 31 e' ritentivo.
	        IF #Dispatcher["_Declare_State"] >= 20 THEN
	            #Dispatcher["_Declare_State"] := 0;
	        END_IF;
	        #retryPick := FALSE;
	        "DB_executeQuery".readyForNextQuery := TRUE;
	        #queryStartExecution := false;
	        
	        // Il ponte SQL va liberato COMPLETAMENTE: azzerando le catene senza
	        // questo, FB6 resta fermo allo stato 35 in attesa di un chiamante che
	        // non esiste piu' e sqlCommands[0] non si svuota mai -> tutta la cella
	        // si blocca in silenzio.
	        "DB_executeQuery".Dispatch["_master"] := 0;
	        "SqlCommands".sqlCommands[0] := '';
	        #queryTemp := '';
	        
	        
	        // consensi spinta in battuta: se restano alti dopo un reset, il robot
	        // li legge come validi alla missione successiva
	        "Q_PushEnable_MC" := FALSE;
	        "Ok_PushSpinta_MC" := FALSE;
	        "Ok_PushArrivo_MC" := FALSE;
	        // e il consenso di fase 2 della missione 16 (5/10): stesso motivo
	        "Ok_Phase2_MC" := FALSE;
	        
	        // COMANDO MANUALE CON FB204 IN CICLO (5/10). I comandi manuali in HOLD
	        // (home, posizionamenti, restart programma) e la dichiarazione 35 azzerano
	        // le catene e MissionCode senza errore: FB204, fermo ad aspettare una
	        // missione, leggeva "MissionCode = 0" come missione riuscita e andava
	        // avanti (es. 57 -> 58 -> ricetta e start con la morsa vuota).
	        // Il reset robot (99) e AUX riportano gia' FB204 a 0 (qui il master e'
	        // gia' 0 per il 99, e AUX lo azzera piu' sotto). Per gli altri comandi:
	        //   - stati di attesa missione fuori lavorazione (lista della guardia D2
	        //     di FB204 senza il 95): 9999 con allarme 959, si riparte dal pannello
	        //     dopo aver dichiarato lo stato della cella;
	        //   - 95 (HAAS in lavorazione): non si abbandona il ciclo macchina, si
	        //     salta al substate 6 e si aspetta la fine ciclo;
	        //   - tutti gli altri stati restano dove sono.
	        // Si ritira la query prenotata di FB204 (il ponte e' appena stato
	        // svuotato) ma NON queryTemp: il rilevamento "query persa" di FB204 la
	        // rifa' da solo.
	        IF #RESET_ALL_DISPATCH AND "DB_MC1".Dispatcher["_master"] <> 0 THEN
	            IF "DB_MC1".Dispatcher["_master"] = 95 THEN
	                "DB_MC1".subState := 6;
	            ELSIF ("DB_MC1".Dispatcher["_master"] = 30 AND ("DB_MC1".subState = 1 OR "DB_MC1".subState = 2))
	                OR "DB_MC1".Dispatcher["_master"] = 35
	                OR "DB_MC1".Dispatcher["_master"] = 43
	                OR "DB_MC1".Dispatcher["_master"] = 44
	                OR "DB_MC1".Dispatcher["_master"] = 46
	                OR ("DB_MC1".Dispatcher["_master"] >= 50 AND "DB_MC1".Dispatcher["_master"] <= 59)
	                OR "DB_MC1".Dispatcher["_master"] = 96
	                OR "DB_MC1".Dispatcher["_master"] = 965
	                OR "DB_MC1".Dispatcher["_master"] = 966
	                OR ("DB_MC1".Dispatcher["_master"] >= 103 AND "DB_MC1".Dispatcher["_master"] <= 105)
	            THEN
	                "FC_MQTT"(insert := true,
	               send := false,
	               topic := 'FROM_PLANT/ALARM/MC1',
	               payload := STRING_TO_WSTRING('959'));   // ciclo interrotto da comando manuale
	                "DB_MC1".io_out.startWork := FALSE;
	                "DB_MC1".Dispatcher["_master"] := 9999;
	            END_IF;
	            "DB_MC1".queryStartExecution := FALSE;
	        END_IF;
	        
	        #RESET_ALL_DISPATCH := FALSE;
	        
	        #swapDataReady := FALSE;
	    END_IF;
	    
	    IF "Start_AUX" OR "ResetAreaRobot" THEN
	        "DB_RobotMission".Command := 0;
	        "DB_MC1".Dispatcher["_master"] := 0;
	        "DB_MC2".Dispatcher["_master"] := 0;
	        #MissionCode := 0;
	        #swapDataReady := FALSE;
	    END_IF;
	    
	END_REGION
	
	REGION PLANT STATUS FOR ROBOT
	    IF #MCRequested = 1 THEN
	        "DB_RobotMission".cmd_Status.DoorClosed := NOT "DB_MC1".io_in.doorOpened;
	    END_IF;
	END_REGION
	
	REGION Supervisione coerenza pinza
	    // INIBITA DURANTE LA DICHIARAZIONE (18/9): dopo un reinit i registri sono
	    // a zero con la pinza fisicamente a bordo — la condizione e' vera per
	    // costruzione e il timer scade prima che l'operatore riesca a dichiarare.
	    // Il comando 35 azzera #Error, ma tonCoerenza.Q e' gia' alto e lo rialza
	    // nello stesso scan: il pannello vede l'errore e rifiuta la sequenza.
	    // Finche' il Declare_State sta lavorando, l'incoerenza e' ATTESA: e' proprio
	    // quello che si sta correggendo.
	    #tonCoerenza(IN := "DB_RobotMissionStatus".StatusCode = "cmd_waitingNewCmd"
	                 AND #Dispatcher["_Declare_State"] = 0
	                 AND ("Gripper_mounted" XOR (#Gripper_ID[1] > 0)),
	                 PT := T#2s);
	    IF #tonCoerenza.Q AND #Error = 0 THEN
	        #Error := 938;
	    END_IF;
	END_REGION
	
	REGION Publish sensori pinza
	    IF BOOL_TO_INT("Gripper_mounted") <> #mounted_old THEN
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/GRIPPER/MOUNTED',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(BOOL_TO_INT("Gripper_mounted"))));
	        #mounted_old := BOOL_TO_INT("Gripper_mounted");
	    END_IF;
	    IF BOOL_TO_INT("Gripper1_Closed") <> #closed1_old THEN
	        "FC_MQTT"(insert := true,
	                  send := false,
	                  topic := 'FROM_PLANT/GRIPPER/CLOSED1',
	                  payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(BOOL_TO_INT("Gripper1_Closed"))));
	        #closed1_old := BOOL_TO_INT("Gripper1_Closed");
	    END_IF;
	END_REGION
	
	
	// Sicurezza: pubblicazione CICLICA, non solo on-change.
	// Un pannello che si connette dopo, o che perde il messaggio, resterebbe con uno
	// stato di sicurezza stantio e bloccherebbe i comandi all'operatore: e' successo
	// il 3/9 e ha fermato la linea.
	// 
	#tonSafetyPub(IN := NOT #tonSafetyPub.Q,
	              PT := T#3s);
	IF #tonSafetyPub.Q OR "Main_Safety_RTG1_DB".Aux_OK <> #auxOK_old THEN
	    "FC_MQTT"(insert := true,
	              send := false,
	              topic := 'FROM_PLANT/SAFETY/AUX',
	              payload := STRING_TO_WSTRING("INT_TO_STRING_WITHOUT_SIGN"(BOOL_TO_INT("Main_Safety_RTG1_DB".Aux_OK))));
	    #auxOK_old := "Main_Safety_RTG1_DB".Aux_OK;
	END_IF;
	
	"Q_MC1_GateClosed" := "Q_STO_Units_CH1";
END_FUNCTION_BLOCK

