FUNCTION_BLOCK "FB_plant"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      Num_MC : Int := 2;
      unitsDataReady : Bool;
      ReqOpenDoors {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : Array[1..4] of R_TRIG;
      HL_ReqOpenDoor { S7_SetPoint := 'True'} : Array[1..4] of Bool;
      TON_ReqOpenDoor {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : Array[1..4] of TON_TIME;
      Hold : Bool;
      FP_hold {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
      testLamps { S7_SetPoint := 'True'} : Bool;
      alertOn : Array[1..10] of Bool;
      FP_doorHold {InstructionName := 'R_TRIG'; LibVersion := '1.0'; S7_SetPoint := 'False'} : R_TRIG;
      FN_doorHold {InstructionName := 'F_TRIG'; LibVersion := '1.0'} : F_TRIG;
   END_VAR

   VAR_TEMP 
      unitIndex : SInt;
   END_VAR


BEGIN
	//Appena metto in automatico l'impianto vado a vedere lo stato delle units
	//IF () THEN
	//ottengo lo stato della units
	//////"DB_executeQuery"(query:= 'select STATUS, PALLET, FIXTURE from MACHINE_STATUS ms');
	//END_IF;    
	
	//TODO: DA FARE SOLO AL PRIMO GIRO DEL PLC (e controllare che non ci siano differenze tra i valori in memoria ed il DB, alrimenti chiedere all'operatore la situazione reale)
	// IF "DB_executeQuery".dataReady THEN
	//     FOR #unitIndex := 1 TO UDINT_TO_SINT("SqlData".data.rowCount) DO
	
	//         CASE #unitIndex OF
	//             1:
	//                 "DB_MC1".Status := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[0]);
	//                 "DB_MC1".pallet := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[1]);
	//                 "DB_MC1".fixture := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[2]);
	//             2:
	//                 "DB_MC2".Status := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[0]);
	//                 "DB_MC2".pallet := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[1]);
	//                 "DB_MC2".fixture := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[2]);
	//                 //3:
	//                 // "DB_MC3".Status := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[0]);
	//                 // "DB_MC3".pallet := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[1]);
	//                 // "DB_MC3".fixture := DINT_TO_INT("SqlData".data.rows[#unitIndex].col[2]);
	//         END_CASE;
	
	//     END_FOR;
	// END_IF;
	// 
	// [Commentato perché viene dato dall'operatore in fase di start della produzione]
	
	
	REGION Management_RobotArea_Door 1
	    // #ReqOpenDoors[1](CLK:="ReqAccessAreaRobot");
	    
	    // IF (#ReqOpenDoors[1].Q) THEN
	    //     #HL_ReqOpenDoor[1] := TRUE;
	    // END_IF;
	    
	    IF ("ReqAccessAreaRobot") THEN
	        #HL_ReqOpenDoor[1] := TRUE;
	    END_IF;
	    
	    #TON_ReqOpenDoor[1](IN := "ReqAccessAreaRobot",
	                        PT := T#2s);
	    
	    IF (#HL_ReqOpenDoor[1]
	        AND #TON_ReqOpenDoor[1].Q
	        AND #ReqOpenDoors[1].Q
	        ) THEN
	        #HL_ReqOpenDoor[1] := FALSE;
	    END_IF;
	    
	    //request to unlock door area robot 
	    "DoorOpenRequest" := #HL_ReqOpenDoor[1] AND ("ReqAccessAreaRobot" OR NOT "Main_Safety_RTG1_DB".Aux_OK);
	    
	    #HL_ReqOpenDoor[1] := NOT ("Door_Robot_locked") OR (#HL_ReqOpenDoor[1] AND "Clock_5Hz");
	    
	END_REGION //Management_RobotArea_Door 1
	
	
	REGION HOLD_MANAGER
	    // HOLD UNICO (13/10), richiesta del cliente: il pulsante in cella e il pannello
	    // fanno la stessa cosa. Decisioni di Dario del 13/10 (A1 e B).
	    // - Lo stato e' uno solo, "DB_Robot".HOLD. Il pulsante lo inverte; il
	    //   pannello lo mette e lo toglie da FB7 (17 interruttore, 82 metti, 81 togli).
	    //   Un tocco fa sempre il contrario di quello che si vede: niente piu' doppia
	    //   pressione dopo un HOLD dal pannello o dopo l'avvio (OB_startUp).
	    // - A1: la porta dell'area robot, sbloccata con il robot in automatico, METTE
	    //   l'HOLD e non lo toglie mai. Richiusa la porta si resta in HOLD finche'
	    //   qualcuno non da' Riprendi, dal pulsante o dal pannello.
	    // - B: con il robot in automatico e la porta non bloccata il Riprendi e'
	    //   rifiutato, dal pulsante e dal pannello: l'HOLD si mette ma non si toglie.
	    //   Con il robot non in automatico (sys_Robot_Auto_Mode falso, per esempio in
	    //   T1) la regola non vale. Stessa condizione in FB7 (CMD_HOLD), che al
	    //   pannello risponde 981.
	    // TOLTA LA GERARCHIA DEL 19/9: l'HOLD del pulsante lo toglieva solo il pulsante,
	    // la porta richiusa toglieva solo quello del pannello. Con la gerarchia il
	    // pulsante a porta aperta TOGLIEVA l'HOLD messo dalla porta (il toggle era gia'
	    // a 1), e il passaggio in T1 a porta aperta lo toglieva sul fronte di discesa
	    // della condizione. Adesso nessuno dei due succede piu'.
	    // #Hold e "DB_Robot".holdButton sono DISMESSI: restano dichiarati per non
	    // reinizializzare DB_plant e DB_Robot e valgono FALSE fisso. Nessun blocco li
	    // legge piu'. #FN_doorHold non si chiama piu'.
	    #FP_doorHold(CLK := NOT "Door_Robot_locked" AND "sys_Robot_Auto_Mode");
	    #FP_hold(CLK := "SB_Hold");
	    
	    IF #FP_doorHold.Q THEN
	        "DB_Robot".HOLD := TRUE;
	    ELSIF #FP_hold.Q THEN
	        IF NOT "DB_Robot".HOLD THEN
	            "DB_Robot".HOLD := TRUE;
	        ELSIF "Door_Robot_locked" OR NOT "sys_Robot_Auto_Mode" THEN
	            "DB_Robot".HOLD := FALSE;
	        END_IF;
	        // altrimenti Riprendi rifiutato (B): porta non bloccata, robot in automatico
	    END_IF;
	    
	    #Hold := FALSE;
	    "DB_Robot".holdButton := FALSE;
	END_REGION
	
	
	REGION EMERGENCY BUTTON
	    IF NOT "EMG_MC1" THEN
	        IF NOT #alertOn[2] THEN
	            "FC_MQTT"(insert := true,
	                      "send" := false,
	                      topic := 'FROM_PLANT/ALARM',
	                      payload := STRING_TO_WSTRING(DINT_TO_STRING(900001)));
	            #alertOn[2] := true;
	        END_IF;
	    ELSE
	        #alertOn[2] := FALSE;
	    END_IF;
	    
	    IF NOT "EMG_MC2" THEN
	        IF NOT #alertOn[3] THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/ALARM',
	                      payload := STRING_TO_WSTRING(DINT_TO_STRING(900002)));
	            #alertOn[3] := true;
	        END_IF;
	    ELSE
	        #alertOn[3] := FALSE;
	    END_IF;
	    
	    IF NOT "EMG_Robot" THEN
	        IF NOT #alertOn[1] THEN
	            "FC_MQTT"(insert := true,
	                      "send" := false,
	                      topic := 'FROM_PLANT/ALARM',
	                      payload := STRING_TO_WSTRING(DINT_TO_STRING(900010)));
	            #alertOn[1] := true;
	        END_IF;
	    ELSE
	        #alertOn[1] := FALSE;
	    END_IF;
	    
	    IF NOT "EMG_OP" THEN
	        IF NOT #alertOn[4] THEN
	            "FC_MQTT"(insert := true,
	                      send := false,
	                      topic := 'FROM_PLANT/ALARM',
	                      payload := STRING_TO_WSTRING(DINT_TO_STRING(900011)));
	            #alertOn[4] := true;
	        END_IF;
	    ELSE
	        #alertOn[4] := FALSE;
	    END_IF;
	    
	END_REGION
END_FUNCTION_BLOCK

