FUNCTION_BLOCK "FB_ExecuteQuery"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      query : String;
      params : Array[0..5] of Int;
      exec : Bool;
   END_VAR

   VAR 
      Dispatch : Array[0..3] of Int;
      dataReady : Bool;
      dataError : Bool;
      noData : Bool;
      readyForNextQuery : Bool;
      queryCounter : Int;
      timeoutConnection {InstructionName := 'TON_TIME'; LibVersion := '1.0'; S7_SetPoint := 'False'} : TON_TIME;
      timeoutRetrayConnection {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      timeoutAbbandono {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR

   VAR_TEMP 
      queryTemp : String;
      i : Int;
   END_VAR


BEGIN
	//EXECUTE A QUERY AND WAIT THE RESULT!
	
	//check connection status 
	//#timeoutConnection(IN := "InstLSql_Microsoft".status < 0 OR "InstLSql_Microsoft".status = 28672, //8602 / 7000
	//                   PT := t#1s);
	//"SqlConfig".enableLSql := #timeoutConnection.Q ;
	
	
	//Check if is a SPECIAL QUERY
	IF #query = 'coordinate4ExtractTray' THEN
	    #queryTemp := CONCAT(IN1 := 'SELECT TRAY,X,Y,Z,X_ROT,Y_ROT,Z_ROT,APPROACH_TYPE,APPROACH_X,APPROACH_Y,APPROACH_Z from COORDINATES_FOR_EXTRACT where tray in (SELECT top(1) tray from COORDINATES_PIECES_TRAYS_4Robot where Order_ID=',
	                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#params[0]),
	                         IN3 := ' AND status=',
	                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#params[1]),
	                         IN5 := ' group BY tray)');
	    //--order BY tray desc
	ELSIF #query = 'coordinate4ExtractTrayWithID' THEN
	    #queryTemp := CONCAT(IN1 := 'SELECT TRAY,X,Y,Z,X_ROT,Y_ROT,Z_ROT from COORDINATES_FOR_EXTRACT where tray=',
	                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#params[0]));
	ELSIF #query = 'tcpData' THEN
	    // ORDINE DELLE RIGHE GARANTITO (5/10): get_TCP_Data legge rows[0] come
	    // lato 1 e rows[1] come lato 2, ma "id in (a,b)" senza ORDER BY non
	    // garantisce l'ordine. Torna giusto solo se l'ID del lato 1 e' il
	    // minore. L'inizio della stringa resta 'select X_BODY+X_CLAW': FB7
	    // (get_TCP_Data 15) riconosce la presa in carico da quello.
	    IF ("DB_Robot".Gripper_ID[1] <> 0 AND "DB_Robot".Gripper_ID[2] <> 0) THEN
	        #queryTemp := CONCAT(IN1 := 'select X_BODY+X_CLAW as X,Y_BODY+Y_CLAW as Y,Z_BODY+Z_CLAW as Z, VALVES, X_ROT, Y_ROT, Z_ROT from grippers where id in (',
	                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"("DB_Robot".Gripper_ID[1]),
	                             IN3 := ',',
	                             IN4 := "INT_TO_STRING_WITHOUT_SIGN"("DB_Robot".Gripper_ID[2]),
	                             IN5 := ') order by case when id=',
	                             IN6 := "INT_TO_STRING_WITHOUT_SIGN"("DB_Robot".Gripper_ID[1]),
	                             IN7 := ' then 0 else 1 end');
	    ELSE
	        #queryTemp := CONCAT(IN1 := 'select X_BODY+X_CLAW as X,Y_BODY+Y_CLAW as Y,Z_BODY+Z_CLAW as Z, VALVES, X_ROT, Y_ROT, Z_ROT from grippers where id=',
	                             IN2 := "INT_TO_STRING_WITHOUT_SIGN"("DB_Robot".Gripper_ID[1]));
	    END_IF;
	ELSIF #query = 'coordinateMC' THEN
	    ;
	    (*SELECT SUB_POS ,X_PICK ,Y_PICK ,Z_PICK ,X_PLACE, Y_PLACE ,Z_PLACE ,X_ROT,Y_ROT,Z_ROT,APPROACh_type,APPROACH_X,APPROACH_Y,APPROACH_Z
	    from SmallBOX.dbo.COORDINATES_PIECES_MC
	    where MC =2
	    *)
	ELSIF #query = 'updateTrayExtract' THEN
	    #queryTemp := CONCAT(IN1 := 'UPDATE TRAY SET [EXTRACT]=',
	                         IN2 := "INT_TO_STRING_WITHOUT_SIGN"(#params[0]),
	                         IN3 := ' WHERE FLOOR_MAG=',
	                         IN4 := "INT_TO_STRING_WITHOUT_SIGN"(#params[1]));
	ELSE
	    #queryTemp := #query;
	END_IF;
	
	
	CASE #Dispatch["_master"] OF
	    0:  //nothing to do
	        // GUARDIA DI RIPRISTINO (5/9): a riposo il buffer DEVE essere vuoto.
	        // Se qualcuno azzera Dispatch dall'esterno (resetDispatcher di FB7,
	        // forzature da watch) senza svuotare sqlCommands[0], il ponte resta
	        // occupato per sempre: nessun richiedente riesce piu' a scrivere la
	        // propria query perche' tutti controllano sqlCommands[0] = ''.
	        // Sintomo visto il 5/9: Dispatch a 0, readyForNextQuery TRUE,
	        // dataReady FALSE e buffer pieno — cella ferma senza errori.
	        IF "SqlCommands".sqlCommands[0] <> '' THEN
	            "SqlCommands".sqlCommands[0] := '';
	        END_IF;
	        
	        // A RIPOSO TIMER E ESITO PULITI (5/10). Se FB7 azzera il ponte mentre
	        // e' al 30 o al 35, timeoutAbbandono resta con IN alto: alla query dopo
	        // non c'e' fronte e scadrebbe subito, abortendo una query appena
	        // partita. Dispatch[1] (mai usato prima) dice "timeout di esecuzione":
	        // si spegne qui.
	        #timeoutAbbandono(IN := FALSE,
	                          PT := T#20s);
	        #Dispatch[1] := 0;
	        
	        IF #exec THEN
	            #Dispatch["_master"] := 10;
	            #readyForNextQuery := FALSE;
	            #dataError := false;
	            #noData := false;
	            #dataReady := false;
	            "SqlData".data.rowCount := 0;
	        END_IF;
	        
	    10: // write query
	        IF (LEN(#queryTemp) > 1 AND "SqlConfig".diagnostics.status >= 0 AND "SqlConfig".enableLSql) THEN
	            "SqlCommands".sqlCommands[0] := #queryTemp;
	            "SqlCommands".currentSqlCommand := 0;
	            
	            #Dispatch["_master"] := 20;
	        ELSIF NOT #exec THEN
	            // RICHIESTA RITIRATA (5/10): il richiedente ha rinunciato fra la
	            // presa in carico (0) e la scrittura (qui), per esempio il timeout
	            // del 10 di FB204. La query in ingresso e' vuota, la condizione
	            // sopra non diventa mai vera e il ponte restava qui con
	            // readyForNextQuery basso: chi aspetta il ponte libero (Extract 12)
	            // non partiva piu'. Si torna a riposo.
	            #readyForNextQuery := TRUE;
	            #Dispatch["_master"] := 0;
	        END_IF;
	        
	    20: // execute query
	        "SqlConfig".executeSqlCommand := TRUE;
	        #Dispatch["_master"] := 30;
	        
	    30: // wait result
	        // TIMEOUT DI ESECUZIONE (5/10): se la connessione cade con una query in
	        // volo, executeSqlCommand resta alto e il 30 non esce piu', tutta la
	        // cella ferma. In campo si rimediava forzando executeSqlCommand a FALSE:
	        // dopo 20 s lo fa il codice e si va al 35 con zero righe e dataError
	        // alto (Dispatch[1]): il richiedente chiude la sua catena col proprio
	        // ramo d'errore.
	        // timeoutAbbandono qui e al 35 non si sovrappone: stati esclusivi, e lo
	        // si azzera a ogni uscita.
	        #timeoutAbbandono(IN := TRUE,
	                          PT := T#20s);
	        IF "SqlTdsReceive".tdsTelegramArrayLength > 0
	            AND NOT "SqlConfig".executeSqlCommand THEN
	            #timeoutAbbandono(IN := FALSE,
	                              PT := T#20s);
	            #queryCounter := #queryCounter + 1;
	            
	            #Dispatch["_master"] := 35;
	        ELSIF #timeoutAbbandono.Q THEN
	            #timeoutAbbandono(IN := FALSE,
	                              PT := T#20s);
	            "SqlConfig".executeSqlCommand := FALSE;
	            "SqlData".data.rowCount := 0;
	            #Dispatch[1] := 1;   // il 35 lo presenta come dataError
	            #Dispatch["_master"] := 35;
	        END_IF;
	        
	    35: //wait syncro from cycle plc
	        // TIMEOUT DI ABBANDONO (5/9): se il richiedente muore prima di leggere
	        // il risultato (errore, reset, catena che cambia stato) nessuno alza
	        // readyForNextQuery e il ponte resta appeso qui bloccando tutta la
	        // cella. Dopo 60s si libera da solo: il risultato va perso, ma il
	        // ponte torna disponibile invece di piantare l'impianto.
	        #timeoutAbbandono(IN := TRUE,
	                          PT := T#60s);
	        
	        IF #readyForNextQuery OR #timeoutAbbandono.Q THEN
	            #timeoutAbbandono(IN := FALSE,
	                              PT := T#60s);
	            
	            //save last query into log
	            FOR #i := 5 TO 1 BY -1 DO
	                "SqlCommands".sqlCommands[#i] := "SqlCommands".sqlCommands[#i - 1];
	            END_FOR;
	            "SqlCommands".sqlCommands[0] := '';
	            
	            #readyForNextQuery := TRUE;
	            #Dispatch["_master"] := 0;
	        END_IF;
	    ELSE
	        // stato non previsto (forzatura, corruzione): torno a riposo pulito
	        "SqlCommands".sqlCommands[0] := '';
	        #readyForNextQuery := TRUE;
	        #Dispatch["_master"] := 0;
	END_CASE;
	
	
	// dataReady: SOLO allo stato 35 il risultato e' effettivamente disponibile.
	#dataReady := #Dispatch["_master"] = 35;
	
	#noData := "SqlData".data.rowCount = 0;
	
	// dataError: SOLO errore vero del ponte.
	// RIMOSSO il termine LEN(#queryTemp) = 0: #queryTemp e' la temporanea
	// ricalcolata a OGNI chiamata dal parametro query, e OB1 Network 7 passa
	// stringa vuota quando nessuno ha richieste pendenti. Cosi' dataError
	// diventava vero su un risultato perfettamente valido, appena il flag del
	// richiedente cadeva (visto 4/9: errore al parsing con SqlData corretto).
	// (5/10) anche il timeout di esecuzione del 30 e' un errore: con il solo
	// "zero righe" ogni richiedente lo avrebbe letto come risposta vuota
	// (FB204 al 42: materiale finito; al 102: produzione finita).
	#dataError := "SqlConfig".diagnostics.status > 8000 OR #Dispatch[1] = 1;
END_FUNCTION_BLOCK

